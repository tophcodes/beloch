---
// Override: drop Starlight's right "On this page" sidebar entirely and give the
// full width to the main content. The default reserves a right column whenever a
// page has a table of contents; we never want it, so we render only the main pane.
---

<div class="main-pane"><slot /></div>

<style>
	.main-pane {
		isolation: isolate;
		width: 100%;
	}
</style>
