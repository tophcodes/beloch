---
// Override: wrap Starlight's default Sidebar, append "Sprache in Entwicklung" card
import Default from '@astrojs/starlight/components/Sidebar.astro';
---

<Default {...Astro.props}><slot /></Default>

<div class="beloch-sidebar-note">
  <div class="beloch-sidebar-note-title">Sprache in Entwicklung</div>
  <p class="beloch-sidebar-note-body">Syntax und Befehlssatz können sich noch ändern. Diese Doku ist als Tutorial gedacht.</p>
</div>

<style>
  .beloch-sidebar-note {
    margin: 1.5rem 0.5rem 1rem;
    padding: 14px;
    background: var(--beloch-chip);
    border: 1px solid var(--beloch-chip-border);
    border-radius: 12px;
  }

  .beloch-sidebar-note-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--beloch-ink);
    margin-bottom: 4px;
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }

  .beloch-sidebar-note-body {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--beloch-muted);
    margin: 0;
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }
</style>
