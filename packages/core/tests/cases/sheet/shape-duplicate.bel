@author "Claude (Anthropic)"

shape band(w h) {
  paper square w
  .p = free on --da from .a by h
  fold (perp --da through .p) (moving .d) as --top
  trim to .a
}

shape band(w h) {
  paper square w
  .p = free on --da from .a by h
  fold (perp --da through .p) (moving .d) as --top
  trim to .a
}

paper band 2 1
; expect error "shape band is already defined"
