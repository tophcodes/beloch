@author "Claude (Anthropic)"

; The squash of one flap of the folded preliminary base, written as its
; bare alignment (ADR 0038): the spine --h & --da opens and lands on the
; center line --ac. The state is the one the explicit fan of
; collapse/flatten-squash-on-folded-base.bel folds.

paper square
mark (through .a .c) as --ac
mark (through .b .d) as --bd
mark (map --ab onto --cd) as --h
mark (map --da onto --bc) as --v
.q = free on --ab from .a at 1/4
.r = free on --ab from .b at 1/4
.z = free on --cd from .c at 1/4
.e = free on --da from .d at 1/4
.f = free on --da from .a at 1/4
flatten (--h & --bc) (--v & --cd) (--h & --da) (--v & --ab) (--bd & .b) (--bd & .d) (.q over .r) (toward .q)
squash (--h & --da onto --ac) as --s
; the axis is one crease on both layers: a flap filter keeps one piece,
; and each piece meets the edge da in one point
--se = --s & #[.e]
--sf = --s & #[.f]
.ax = --se * --da
.bx = --sf * --da

; assert faces = 10
; assert .a = (1, 1)
; assert .e = (3/4, 1)
; assert .f = (1, 3/4)
; assert .q = (1, 3/4)
; assert .z = (3/4, 1)
