@author "Claude (Anthropic)"

; A crease marked through two layers lies on two paper lines, and both
; cross the vertical midline.
paper square
mark (map .a onto .b) as --m
fold (map --ab onto --cd) (moving .a) as --f
mark (map --cd onto --f) as --q
.p = --q * --m

; expect error "(1/2, 3/4) and (1/2, 1/4)"
