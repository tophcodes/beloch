paper square
mark (through .a .d) as --l
mark (through .a .b) as --bot
fold (map .b onto .a) as --v
fold (map .d onto .a) as --h
.p = --l * --h
.q = --v * --bot
fold (through .p .q) (moving .d) (up to .c)

; assert faces = 6
; assert steps = 3
; assert --l is boundary
; assert --bot is boundary
; assert --v is valley
