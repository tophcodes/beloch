paper square
mark --l = through .a .d
mark --bot = through .a .b
fold --v = map .b onto .a
fold --h = map .d onto .a
.p = --l * --h
.q = --v * --bot
fold through .p .q moving .d up to .c

; assert faces = 6
; assert steps = 3
; assert --l is boundary
; assert --bot is boundary
; assert --v is valley
