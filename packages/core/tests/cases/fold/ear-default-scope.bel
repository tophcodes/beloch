@author "Claude (Anthropic)"

paper square

mark (through .a .c) as --diag
mark (map --ab onto --diag) as --ea
mark (map --ab onto --bc) as --eb
mark (map --bc onto --diag) as --ec

.o = --ea * --eb
flatten (--ea & .a valley) (--ec & .c) (--eb & .b valley) (staying .d) (toward .a)
mark (map .d onto .b) as --l

; without `up to` the fold takes every layer on the side of .b (BEP-0036)
fold (map .b onto .o)

; assert faces = 13
