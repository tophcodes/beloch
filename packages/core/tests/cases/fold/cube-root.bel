paper square

mark --vm = map .a onto .b                ; vertical midline x=1/2 (axiom 2)

._mb = --vm * --ab                   ; (1/2, 0)
._mt = --vm * --cd                   ; (1/2, 1)
mark --ac   = through .a .c               ; landmark diagonal
mark --db   = through .d .b               ; landmark diagonal
mark --d_mb = through .d ._mb             ; landmark
mark --a_mt = through .a ._mt             ; landmark
mark --c_mb = through .c ._mb             ; landmark
mark --b_mt = through .b ._mt             ; landmark
._pq1 = --d_mb * --ac                ; (1/3, 1/3)
._pq2 = --a_mt * --db                ; (1/3, 2/3)
--pq  = through ._pq1 ._pq2           ; left third line PQ : x = 1/3
._rs1 = --c_mb * --db                ; (2/3, 1/3)
._rs2 = --b_mt * --ac                ; (2/3, 2/3)
mark --rs = through ._rs1 ._rs2           ; right third line RS : x = 2/3
.s    = --rs * --cd                  ; S = (2/3, 1), top of RS

fold map .c onto --ab and .s onto --pq   ; fold C onto AB, S onto PQ → AC/CB = ∛2

; neither landing is assertable in v1: `incident` always resolves against
; PAPER space (fixed, pre-fold — see test_bel_assert.ml's check_incident),
; not the folded TABLE position, so it can't confirm .s landed on --pq; and
; the TABLE landings are irrational in y (.c's x is a cubic root; .s's y a
; related irrational), so no exact rational literal matches either. The
; axiom7 tag and the no-temp-points invariant are covered externally by
; test_e2e_cube_root / test_e2e_cube_root_temps_hidden (kept, repointed here)
; assert faces = 2
; assert steps = 1
