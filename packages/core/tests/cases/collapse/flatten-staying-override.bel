@author "Claude (Anthropic)"

; The order of the items carries no meaning. Same incenter rabbit ear as
; flatten-rabbit-ear-toward-a.bel with the first two items swapped:
; (staying .d) names the part that stays, and (emergent beside .a) picks the
; a-side mirror as there. `.t = --ear * --ab` errors unless the a-side ear
; was picked (the c-side ear line is parallel to --ab).

paper square

mark (through .a .c) as --diag
mark (map --ab onto --diag) as --ea
mark (map --ab onto --bc) as --eb
mark (map --bc onto --diag) as --ec

flatten (--eb & .b valley) (--ea & .a valley) (--ec & .c) (staying .d) (emergent beside .a) as --ear
.t = --ear * --ab

; assert --ear is mountain
