@author "Claude (Anthropic)"

; The petal fold of flatten-petal-two-fans.bel, with the two kite creases
; marked on the front flap first and named as rays. The statement cuts each
; marked crease into the paper as it reads the ray, so the flap that `on`
; names and the staying point are found on the faces that state holds. The
; result is the state of the petal fold written with constructions.

paper square

fold (map .a onto .c) as --bd
reverse (map .b onto .c) as --h
reverse (map .d onto .c) as --v

.o = --h * --v
--mid = (through .c .o)
.sr = --ab * --h
.sl = --da * --v

mark (map .sr onto --mid through .a) (on #[.a]) as --kr
mark (map .sl onto --mid through .a) (on #[.a]) as --kl

flatten (fan (--h & .sr) (--kr & .a valley) as .r)
        (fan (--v & .sl) (--kl & .a valley) as .l)
        (on #[.a]) (staying .o) as --pf

; assert steps = 4
; assert faces = 11
; assert .sr = .sl
; assert .b = (1, 1)
; assert .d = .b
; assert .o = (1/2, 1/2)
