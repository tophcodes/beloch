@author "Claude (Anthropic)"

; Mirror file of flatten-rabbit-ear-toward-c.bel: same vertex, ear folded to
; the a side (emergent hinge = perpendicular from the incenter to --ab). This
; is the realization the pre-fix evaluator produced as its only one; it must
; keep working, now selected by (emergent beside .a), since with both sides
; real the statement is ambiguous without it. `.t = --ear * --ab` errors if
; the c-side ear (parallel to --ab) were picked.

paper square

mark (through .a .c) as --diag
mark (map --ab onto --diag) as --ea
mark (map --ab onto --bc) as --eb
mark (map --bc onto --diag) as --ec

; (staying .d) names the big sector the ear folds onto. The emergent ray
; lies in the wedge between --ea and --eb or in the one between --eb and
; --ec, the two mirror worlds; (emergent beside …) names the wedge.
flatten (--ea & .a valley) (--ec & .c) (--eb & .b valley) (staying .d) (emergent beside .a) as --ear
.t = --ear * --ab

; assert --ear is mountain
