; Mirror file of flatten-rabbit-ear-toward-c.bel: same vertex, ear folded to
; the a side (emergent hinge = perpendicular from the incenter to --ab). This
; is the realization the pre-fix evaluator produced as its only one; it must
; keep working — now selected explicitly, since with both sides real the
; statement is ambiguous without (toward). `.t = --ear * --ab` errors if the
; c-side ear (parallel to --ab) were picked.

paper square

mark (through .a .c) as --diag
mark (map --ab onto --diag) as --ea
mark (map --ab onto --bc) as --eb
mark (map --bc onto --diag) as --ec

; Leading pair is (--ea .a)(--ec .c): their <180 arc is the big stayer
; sector the ear folds onto; the emergent splits it into the two mirror
; worlds (toward) then picks (design 2026-07-17 stayer convention).
flatten (--ea) (--ec) (--eb) (toward .a) as --ear
.t = --ear * --ab

; assert --ear is mountain
