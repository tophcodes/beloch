@author "Claude (Anthropic)"

; The fan of flatten-ray-on-folded-edge.bel, anchored on the lower layer with
; `on #[.d]`. Its ray (--x & --m) reaches the spine, where the two layers
; hang together, so the tip of either corner holds both layers (ADR 0037)
; and the flatten gives the same state as with the upper corner as anchor:
; folding along --x through both layers and then along --y.

paper square
fold (map --ab onto --cd) (moving .a) as --m
.f = --m * --bc
mark (map --da onto --cd) (toward .f) (on #[.a]) as --x
.p = free on --x from .a at 1/4
mark (perp --x through .p) (on #[.a]) as --y
mark (--x) (on #[.d]) into --x
mark (--y) (on #[.d]) into --y
flatten (--x & --m valley) (--y & --ab) (--x & .a valley) (--y & --da mountain) (on #[.d])

; assert faces = 8
; assert .a = (1/4, 3/4)
; assert .d = (1/4, 3/4)
; assert .b = (1, 1)
; assert .p = (1/8, 7/8)
