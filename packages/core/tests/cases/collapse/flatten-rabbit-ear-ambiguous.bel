@author "Claude (Anthropic)"

; The incenter rabbit ear has TWO mirror realizations (see
; flatten-rabbit-ear-toward-c.bel); with no item that names a side, the
; statement must report the ambiguity instead of silently picking one.

paper square

mark (through .a .c) as --diag
mark (map --ab onto --diag) as --ea
mark (map --ab onto --bc) as --eb
mark (map --bc onto --diag) as --ec

; Leading pair is (--ea .a)(--ec .c): their <180 arc is the big stayer
; sector the ear folds onto, and the emergent ray can lie on either side of
; --eb.
flatten (--ea) (--ec) (--eb)

; expect error "ambiguous"
