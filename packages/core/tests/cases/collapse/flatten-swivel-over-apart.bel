@author "Claude (Anthropic)"

; An over item compares the faces that hold its two points where they
; overlap (BEP-0082). The face that holds .z lies apart from the face that
; holds .p in every state of the swivel fold, so the item holds in none.

paper square
mark (through .a .c) as --ac
mark (through .b .d) as --bd
mark (map --ab onto --cd) as --h
mark (map --da onto --bc) as --v
mark (align (--h onto --ac) (heading --h)) as --s
mark (align (--h onto --bd) (heading --h)) as --t
.q = free on --ab from .a at 1/4
.r = free on --ab from .b at 1/4
.z = free on --cd from .c at 1/4
.e = free on --da from .d at 1/4
.f = free on --da from .a at 1/4
.g = free on --bc from .b at 1/4
mark (through .f .b) as --fb
mark (through .a .g) as --ag
.p = free on --fb from .f at 1/10
.w = free on --ag from .a at 9/10
flatten (--h & --bc) (--v & --cd valley) (--h & --da valley) (--v & --ab) (--bd & .b mountain) (--bd & .d)
flatten (--h & --da) (--s & --da mountain) (--t & --da valley) (--ac & .a valley) (staying .q) (.p over .z)

; expect error "contradictory `over`"
