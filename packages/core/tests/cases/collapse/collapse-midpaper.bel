paper square

mark (map .a onto .d) as --h    ; horizontal midline, y = 1/2
mark (map .a onto .b) as --v    ; vertical midline, x = 1/2
mark (map --v onto --bc) as --q ; vertical crease at x = 3/4

.q  = --h * --q            ; interior crossing (3/4, 1/2)
.tm = --v * --cd           ; top edge midpoint (1/2, 1)

; a bare element is solver-assigned M/V, so the all-valley assignment this
; case's error depends on
; must be stated with explicit `valley` markers (--q is a mark only, never
; materialized, so #[.q .tm]'s face spans to the right edge and the selected
; --h segment reaches the boundary — the flatten sees the full "+" vertex
; and the stated all-valley assignment violates Maekawa, as before).
flatten (--h & #[.q .tm] valley) (--h & --da valley)
  (--v & --cd valley) (--v & --ab valley)

; expect error "Maekawa"
