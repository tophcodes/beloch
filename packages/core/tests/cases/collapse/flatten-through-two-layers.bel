; A four-ray vertex near the corner of a book fold, scored on the upper layer
; alone. The rays end on the raw edges and none reaches the spine, so the
; tip of the upper corner is that corner alone (ADR 0037): it folds onto
; the top of the stack, and the lower corner stays flat at the bottom of
; the stack, where it needs no rays.

paper square
fold (map --ab onto --cd) (moving .a) as --m
.e = --m * --da
.f = --m * --bc
mark (map --da onto --cd) (toward .f) (on #[.a]) as --dg
.o = free on --dg from .a at 1/4
mark (perp --dg through .o) (on #[.a]) as --pp
mark (perp --da through .o) (on #[.a]) as --hz
mark (map --hz onto --dg) (toward .a) (on #[.a]) as --r2
mark (map --hz onto --pp) (toward .e) (on #[.a]) as --r4
.z = free on --ab from .b at 1/4
flatten (--pp & --ab mountain) (--r4 & --ab) (--dg & .a valley) (--r2 & --da) (staying .z)

