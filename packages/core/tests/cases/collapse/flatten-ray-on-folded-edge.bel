@author "Claude (Anthropic)"

; A four-ray vertex on a book fold, folded through both layers. The ray
; (--x & --m) ends at the center of the paper, on the spine: a folded edge of
; its flap, inside the square on the table. The four rays are two straight
; lines, so the flatten equals folding along --x through both layers and then
; along --y through the stack. The fan stands at .p, and `up to #[.d]` folds
; both layers under it as one stack (spec multifold, "A fan with up to folds
; every layer down to a flap"); each ray names its halves in both layers: --m
; and --da touch both, and `\ --m`, `\ --da` keep the other halves.

paper square
fold (map --ab onto --cd) (moving .a) as --m
.f = --m * --bc
mark (map --da onto --cd) (toward .f) (on #[.a]) as --x
.p = free on --x from .a at 1/4
mark (perp --x through .p) (on #[.a]) as --y
mark (--x) (on #[.d]) into --x
mark (--y) (on #[.d]) into --y
flatten (fan at .p (--x & --m valley) (--y \ --da) (--x \ --m valley) (--y & --da mountain)
             (up to #[.d])) (staying .b)

; assert faces = 8
; assert .a = (1/4, 3/4)
; assert .d = (1/4, 3/4)
; assert .b = (1, 1)
; assert .p = (1/8, 7/8)
