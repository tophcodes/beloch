@author "Claude (Anthropic)"

; The swivel fold of flatten-swivel-on-folded-base.bel, decided by an over
; item (spec multifold, "An over item orders the faces of its two points"). Its
; two states differ in whether the moving flap lies above or below two faces
; of the staying part, while a third face of the staying part lies above the
; flap in both. .p lies in the flap, .w in one of the two faces below or above
; it; (.p over .w) keeps the state in which the face that holds .p lies above
; the face that holds .w. The other layers of the staying part need not lie
; below .p's face.

paper square
mark (through .a .c) as --ac
mark (through .b .d) as --bd
mark (map --ab onto --cd) as --h
mark (map --da onto --bc) as --v
mark (align (--h onto --ac) (heading --h)) as --s
mark (align (--h onto --bd) (heading --h)) as --t
.q = free on --ab from .a at 1/4
.r = free on --ab from .b at 1/4
.z = free on --cd from .c at 1/4
.e = free on --da from .d at 1/4
.f = free on --da from .a at 1/4
.g = free on --bc from .b at 1/4
mark (through .f .b) as --fb
mark (through .a .g) as --ag
.p = free on --fb from .f at 1/10
.w = free on --ag from .a at 9/10
flatten (--h & --bc) (--v & --cd valley) (--h & --da valley) (--v & --ab) (--bd & .b mountain) (--bd & .d) (staying .c)
flatten (--h & --da) (--s & --da mountain) (--t & --da valley) (--ac & .a valley) (staying .q) (.p over .w)

; assert faces = 12
; assert .a = (1, 1)
; assert .q = (1, 3/4)
