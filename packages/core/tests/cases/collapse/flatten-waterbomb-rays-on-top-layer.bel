@author "Claude (Anthropic)"

; flatten-waterbomb-both-layers.bel with its creases marked on the top layer
; alone. The fan keeps the sector along the raw edges, so the spine's pieces
; move and the tip is both layers (decisions/a-fan-moves-its-tip); the flatten scores its rays on
; the bottom layer itself, as def-flatten scores every layer under the fan,
; and folds the same state as the program that marks them on both layers.
; The selectors of the diagonal through the corners name the top layer's
; corner .b in place of .a, which lies on the bottom layer.

paper rectangle 2 1
fold (map .a onto .b) (moving .b) as --spine
.s0 = --spine * --ab
.s1 = free on --spine from .s0 at 1
mark (through .a .s1) (on #[.b]) as --d1
mark (through .s0 .d) (on #[.b]) as --d2
mark (map .a onto .s0) (on #[.b]) as --v
.m = (--d1 & .b) * --d2
.e = free on --ab from .a at 1/4
.f = free on --ab from .a at 3/4
flatten (--d1 & .b valley) (--d1 & .s1 valley) (--d2 & .s0 valley) (--d2 \ .s0 valley)
  (--v & --ab mountain) (--v \ --ab mountain) (staying .b .c)

; assert steps = 2
; assert faces = 12
; assert .a = (0, 0)
; assert .d = (0, 1)
; assert .b = (0, 0)
; assert .c = (0, 1)
; assert .m = (1/2, 1/2)
; assert .s0 = (0, 0)
; assert .s1 = (0, 1)
; assert .e = (0, 1/2)
; assert .f = (0, 1/2)
