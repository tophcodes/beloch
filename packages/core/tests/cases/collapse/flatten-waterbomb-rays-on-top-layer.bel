@author "Claude (Anthropic)"

; flatten-waterbomb-both-layers.bel with its creases marked on the top layer
; alone. The vertex is the point of the top layer where the rays meet, and
; the fan folds the top layer alone (spec multifold, "A fan folds at a point of
; the paper"). The spine joins the bottom layer to a moving sector of the top
; layer, so the bottom layer moves, and no ray of the fan folds it: the write
; is undefined, and the error names the layer by its corner .a.

paper rectangle 2 1
fold (map .a onto .b) (moving .b) as --spine
.s0 = --spine * --ab
.s1 = free on --spine from .s0 at 1
mark (through .a .s1) (on #[.b]) as --d1
mark (through .s0 .d) (on #[.b]) as --d2
mark (map .a onto .s0) (on #[.b]) as --v
.m = (--d1 & .b) * --d2
.e = free on --ab from .a at 1/4
.f = free on --ab from .a at 3/4
flatten (--d1 & .b valley) (--d1 & .s1 valley) (--d2 & .s0 valley) (--d2 \ .s0 valley)
  (--v & --ab mountain) (--v \ --ab mountain) (staying .b .c)

; expect error "the layer of .a lies under the vertex and moves"
