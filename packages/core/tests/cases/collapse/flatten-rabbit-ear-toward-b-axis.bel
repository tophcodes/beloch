@author "Claude (Anthropic)"

; (toward .b) cannot pick a rabbit-ear side: .b lies on the b–d line, the
; reflective symmetry axis of the vertex's given rays — the two realizations'
; position classes score an exact centroid-dot tie. Must error, not
; arbitrarily pick.

paper square

mark (through .a .c) as --diag
mark (map --ab onto --diag) as --ea
mark (map --ab onto --bc) as --eb
mark (map --bc onto --diag) as --ec

; (staying .d) names the big sector the ear folds onto; the emergent ray
; lies on one side or the other of .b, the two mirror worlds toward picks
; between.
flatten (--ea & .a) (--ec & .c) (--eb & .b) (staying .d) (toward .b)

; expect error "does not pick a side"
