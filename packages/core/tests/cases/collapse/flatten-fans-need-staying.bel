@author "Claude (Anthropic)"

; A flatten of several fans names the region that stays with a staying
; item; the order of the rays does not pick it (ADR 0055).

paper square

fold (map .a onto .c) as --bd
reverse (map .b onto .c) as --h
reverse (map .d onto .c) as --v

.o = --h * --v
--mid = (through .c .o)
.sr = --ab * --h
.sl = --da * --v

flatten (fan (--h & .sr) (map .sr onto --mid through .a))
        (fan (--v & .sl) (map .sl onto --mid through .a))
        (on #[.a])

; expect error "a flatten with several fans needs a staying item"
