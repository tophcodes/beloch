@author "Claude (Anthropic)"

; A flatten names the part that stays (spec multifold, "A flatten names the
; part that stays"). A legal 4-ray vertex, the two square diagonals crossing
; at the center, whose first two rays lie on one line: without (staying .p)
; the statement fails before any state is solved, and the hint names the
; item that resolves it.

paper square

mark (through .a .c) as --d1
mark (through .b .d) as --d2

flatten (--d1 & .a) (--d1 & .c) (--d2 & .b mountain) (--d2 & .d)

; expect error "flatten needs (staying .p)"
