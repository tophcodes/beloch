@author "Claude (Anthropic)"

; The petal fold of flatten-petal-two-fans.bel without a staying item. The
; hinges of the two fans part the paper into the kite of the front flap,
; which turns up, and the rest of the square; without staying, the part of
; largest area on the paper holds still (BEP-0079). That is the rest of the
; square, which (staying .o) names in flatten-petal-two-fans.bel, and the
; state is the same.

paper square

fold (map .a onto .c) as --bd
reverse (map .b onto .c) as --h
reverse (map .d onto .c) as --v

.o = --h * --v
mark (through .c .o) as --mid
.sr = --ab * --h
.sl = --da * --v

flatten (fan (--h & .sr) (map .sr onto --mid through .a valley))
        (fan (--v & .sl) (map .sl onto --mid through .a valley))

; assert steps = 4
; assert faces = 11
; assert .sr = .sl
; assert .b = (1, 1)
; assert .d = .b
; assert .o = (1/2, 1/2)
