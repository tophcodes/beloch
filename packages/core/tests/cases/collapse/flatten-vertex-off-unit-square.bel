@author "Claude (Anthropic)"

; Check 4 reads the vertex on the paper: the vertex of a fan lies off the
; sheet's raw edge in every layer under it. On a 2:1 rectangle the fan sits
; at (3/2, 1/2), outside the unit square, and folds the right part of the
; sheet in quarters: the median folds as a valley, the vertical line as a
; valley above it and a mountain below.

paper rectangle 2 1
mark (map .a onto .d) as --h
.q = free on --ab from .a at 3/4
mark (perp --ab through .q) as --v
.o = --h * --v
flatten (--h & --da valley) (--h & --bc valley) (--v & --ab mountain)
  (--v & --cd valley) (staying .a)

; assert faces = 4
; assert .o = (3/2, 1/2)
; assert .a = (0, 0)
; assert .b = (1, 0)
; assert .c = (1, 0)
