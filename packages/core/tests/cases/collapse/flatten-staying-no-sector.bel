@author "Claude (Anthropic)"

; The fan of flatten-waterbomb-top-layer.bel. .b lies on the ray toward the
; corner at the origin, .s0 on the ray toward the foot of the spine, and the
; sectors beside the one share none with the sectors beside the other, so no
; sector holds both (decisions/staying-names-a-sector-of-the-anchor).

paper rectangle 2 1
fold (map .a onto .b) (moving .b) as --spine
.s0 = --spine * --ab
.s1 = free on --spine from .s0 at 1
mark (through .a .s1) (on #[.b]) as --d1
mark (through .s0 .d) (on #[.b]) as --d2
mark (map .a onto .s0) (on #[.b]) as --v
.m = --d1 * --d2
flatten (--d1 & .b) (--d1 & .s1) (--d2 & .s0) (--d2 \ .s0)
  (--v & --ab mountain) (--v \ --ab mountain) (staying .b .s0)

; expect error "no sector of the fan holds every staying point"
