paper square
mark --d1 = through .a .c
mark --d2 = through .b .d
.center = --d1 * --d2
fold map .a onto .center

; `faces` is the evaluator's crease-pattern state: the one fold subdivides
; to 2; --d1/--d2 stay unfolded marks there (they graduate to F creases,
; adding more faces, only in the emitted FOLD)
; assert faces = 2
; assert steps = 1
; assert .center = (1/2, 1/2)
; assert .a = .center
