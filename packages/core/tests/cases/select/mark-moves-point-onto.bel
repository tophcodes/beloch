@author "Claude (Anthropic)"

; The pinch of mark-moves-short.bel with the corner moving instead: a point
; folded onto the line of a mark needs paper on that line, not the mark
; (decisions/a-line-reads-as-the-bundle-it-names), so .d folds over and lands on the line of the pinch above
; its end, at height sqrt(3)/2; the side of .b and .c stays.

paper square
mark (through .a .c) as --ac
.o = free on --ac from .a at 1/2
.m = free on --ab from .a at 1/2
mark (through .m .o) (between .m .o) as --pinch
fold (map .d onto --pinch through .a) (moving .d) as --f

; assert steps = 1
; assert .a = (0, 0)
; assert .b = (1, 0)
; assert .c = (1, 1)
