@author "Claude (Anthropic)"

; A toward line names the side it lies on. The vertical candidate crosses
; the bottom edge, so the edge names no side of it and it drops out; the
; other candidate keeps the edge on the side that stays and folds .d over,
; onto the center (ADR 0031).

paper square
mark (map .a onto .b) as --ef
mark (through .b .d) as --bd
.p = free on --bd from .d at 1/4
fold (map .d onto --ef through .p) (toward --ab)

; assert steps = 1
; assert .d = (1/2, 1/2)
