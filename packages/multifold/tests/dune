(executable
 (name test_pipeline)
 (modules test_pipeline test_fixture)
 (libraries multifold alcotest))

;; The k=2 group shells out to msolve 264 times (~17s measured), so
;; `dune runtest`/`dune test` (the fast alias) forces Alcotest's Quick-only
;; mode via ALCOTEST_QUICK_TESTS (see alcotest's Cli.Quick_only, `-q`'s env
;; alias). Run the full suite (incl. Slow) with
;; `dune exec packages/multifold/tests/test_pipeline.exe` from this
;; directory instead.

(rule
 (alias runtest)
 (deps
  test_pipeline.exe
  (glob_files fixtures/*.txt))
 (action
  (setenv
   ALCOTEST_QUICK_TESTS
   true
   (run %{exe:test_pipeline.exe}))))
