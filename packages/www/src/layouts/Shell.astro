---
// The shell the two standalone pages share: the landing at `/` and the
// playground at `/playground/`. Both sit outside Starlight, so they own their
// own <html>/<head>: the theme tokens, the mode read from Starlight's own
// `starlight-theme` localStorage key (so the choice carries into the docs),
// and the paper-scheme sync script.
import { headSyncScript } from "../lib/paper-schemes";
import { NAV_LINKS, REPO_LINK } from "../lib/nav-links";
import SiteHeader from "../components/SiteHeader.astro";
import CiteLine from "../components/CiteLine.astro";
import "../styles/theme.css";

interface Props {
  title: string;
  description: string;
  // Canonical URL of this page, for the Open Graph tags a shared link uses.
  url: string;
}
const { title, description, url } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    {/* The image is scripts/generate-og-image.ts's output, the project's own
        bird-base fold on the dark theme panel. */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content="https://belochlang.org/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://belochlang.org/og-image.png" />
    {/* Inlined to avoid a flash of the wrong theme. Shares Starlight's
        `starlight-theme` localStorage key so an explicit toggle choice carries
        between these pages and the docs. Nothing is set without a stored
        choice: the attribute is what pins `color-scheme`, and leaving it off is
        what lets the visitor's system decide. */}
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("starlight-theme");
        } catch (e) {}
        if (stored === "light" || stored === "dark") {
          document.documentElement.dataset.theme = stored;
        }
      })();
    </script>
    <script set:html={headSyncScript()} />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <SiteHeader />
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <nav class="site-footer-nav" aria-label="Secondary">
        {[...NAV_LINKS, REPO_LINK].map((l) => (
          <a href={l.href}>{l.label}</a>
        ))}
      </nav>
      <CiteLine />
    </footer>

    <style is:global>
      /* Minimal reset. Starlight normally supplies this; these pages bypass
         Starlight entirely, so the shell owns its own baseline. */
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        min-height: 100vh;
        background: var(--bel-ui-ground);
        color: var(--bel-ui-text);
        font-family: var(--bel-font-prose);
        overflow-x: hidden;
      }
      a { color: var(--bel-ui-accent); text-decoration: none; }
      a:hover { text-decoration: underline; }

      /* The wrapper the standalone pages bring. Its counterpart in the docs
         is Starlight's PageFrame header, which the bridge gives the same
         height, side margin and divider. */
      .site-header {
        padding: 20px var(--bel-shell-pad-x);
        min-height: var(--bel-shell-nav-height);
        border-bottom: 1px solid var(--bel-ui-divider);
      }

      main {
        width: min(1120px, 94vw);
        margin: 0 auto;
        padding: clamp(32px, 6vw, 72px) 0 48px;
      }

      .site-footer {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        padding: 24px var(--bel-shell-pad-x) 40px;
        border-top: 1px solid var(--bel-ui-divider);
        font-size: var(--bel-text-sm);
      }
      .site-footer-nav { display: flex; gap: 20px; justify-content: center; }
      .site-footer-nav a { color: var(--bel-ui-text-muted); }
      .site-footer-nav a:hover { color: var(--bel-ui-text); }
    </style>

  </body>
</html>
