---
// Starlight's MobileMenuFooter. Below 50rem the header keeps the wordmark,
// the search and the mode toggle, and drops the text links for want of room.
// The drawer is where those land.
import { NAV_LINKS } from "../lib/nav-links";
---

<nav class="mobile-nav" aria-label="Primary">
  {NAV_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
</nav>

<style>
  .mobile-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--bel-space-3);
    border-top: 1px solid var(--bel-ui-divider);
    padding: var(--bel-space-2) 0;
    font-size: var(--bel-text-base);
  }
  .mobile-nav a { color: var(--bel-ui-text-muted); }
  .mobile-nav a:hover { color: var(--bel-ui-text); }
</style>
