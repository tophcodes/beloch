---
// Starlight's sidebar plus a collapse toggle for desktop widths. The
// collapsed state lives on <html data-sidebar-collapsed> and in localStorage;
// the head script in ../lib/sidebar-collapse.ts applies it before first paint.
import Default from "@astrojs/starlight/components/Sidebar.astro";
import { STORAGE_KEY } from "../lib/sidebar-collapse";
---

<Default />

<button
  type="button"
  class="sidebar-collapse sl-hidden md:sl-flex"
  data-storage-key={STORAGE_KEY}
  aria-controls="starlight__sidebar"
  title="Toggle sidebar"
>
  <span class="when-open" aria-hidden="true">‹</span>
  <span class="when-collapsed" aria-hidden="true">›</span>
  <span class="sr-only">Toggle sidebar</span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>("button.sidebar-collapse");
  if (button) {
    const key = button.dataset.storageKey ?? "";
    const root = document.documentElement;
    const sync = () => {
      button.setAttribute("aria-expanded", String(!root.hasAttribute("data-sidebar-collapsed")));
    };
    sync();
    button.addEventListener("click", () => {
      root.toggleAttribute("data-sidebar-collapsed");
      try {
        localStorage.setItem(key, root.hasAttribute("data-sidebar-collapsed") ? "1" : "0");
      } catch {}
      sync();
    });
  }
</script>

<style>
  .sidebar-collapse {
    position: fixed;
    visibility: visible;
    top: calc(var(--sl-nav-height) + 0.75rem);
    inset-inline-start: calc(var(--sl-sidebar-width) - 0.875rem);
  }
  :global(html[data-sidebar-collapsed]) .sidebar-collapse {
    inset-inline-start: 0.5rem;
    z-index: calc(var(--sl-z-index-menu) + 1);
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--bel-ui-divider);
    border-radius: 50%;
    background: var(--bel-ui-surface);
    color: var(--bel-ui-text);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: var(--bel-shadow-overlay);
  }
  .sidebar-collapse:hover {
    color: var(--bel-ui-text);
  }
  .when-collapsed,
  :global(html[data-sidebar-collapsed]) .when-open {
    display: none;
  }
  :global(html[data-sidebar-collapsed]) .when-collapsed {
    display: inline;
  }
</style>
