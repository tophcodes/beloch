---
// The one header. The landing and the playground wrap it in their own
// <header>; in the docs it is Starlight's Header override and PageFrame
// supplies the element around it. Both grounds resolve to the same height,
// side margin and divider through the bridge in theme.css, and both take the
// dark chrome, which .bel-chrome points the --bel-ui-* roles at.
import { Icon } from "@astrojs/starlight/components";
import Wordmark from "./Wordmark.astro";
import { NAV_LINKS, REPO_LINK } from "../lib/nav-links";

interface Props {
  // Below 50rem the docs need the room for the search button and the drawer
  // toggle, so the text links step aside there and the mobile drawer carries
  // them instead. The standalone pages have no drawer and keep them.
  compact?: boolean;
}
const { compact = false } = Astro.props;
const hasSearch = Astro.slots.has("search");
---

<div class="site-header-inner bel-chrome">
  <Wordmark />
  <nav class:list={["site-nav", { "site-nav-compact": compact }]} aria-label="Primary">
    {NAV_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
  {hasSearch && (
    <div class="header-search">
      <slot name="search" />
    </div>
  )}
  <div class:list={["site-end", { "site-nav-compact": compact }]}>
    <a href={REPO_LINK.href}>{REPO_LINK.label}</a>
    <button type="button" class="theme-toggle" aria-label="Toggle color theme">
      <Icon name="moon" class="toggle-moon" />
      <Icon name="sun" class="toggle-sun" />
    </button>
    {!compact && (
      <details class="site-menu">
        <summary aria-label="Menu">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7H20M4 12H20M4 17H20" />
          </svg>
        </summary>
        <nav aria-label="Primary">
          {[...NAV_LINKS, REPO_LINK].map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </details>
    )}
  </div>
</div>

<style>
  /* The standalone pages have no drawer, so below 720px the links and the
     repository move into a menu that opens under the header. The docs keep
     theirs in Starlight's drawer (compact). */
  .site-menu { display: none; }
  @media (max-width: 720px) {
    .site-nav:not(.site-nav-compact),
    .site-end:not(.site-nav-compact) > a { display: none; }
    .site-end:not(.site-nav-compact) { margin-inline-start: auto; }
    .site-menu { display: block; }
  }
  .site-menu summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--bel-ui-control-border);
    border-radius: var(--bel-radius-control);
    color: var(--bel-ui-text);
    list-style: none;
    cursor: pointer;
  }
  .site-menu summary::-webkit-details-marker { display: none; }
  .site-menu[open] summary { background: var(--bel-ui-quiet); }
  .site-menu summary:focus-visible {
    outline: 2px solid var(--bel-ui-accent);
    outline-offset: 2px;
  }
  .site-menu nav {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    z-index: 10;
    display: flex;
    flex-direction: column;
    padding: 4px var(--bel-shell-pad-x) 12px;
    background: var(--bel-ui-chrome);
    border-bottom: 1px solid var(--bel-ui-chrome-line);
  }
  .site-menu nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--bel-ui-text);
  }

  /* Wordmark and links at the start, the search after them, and the
     repository and the mode toggle at the end. */
  .site-header-inner {
    display: flex;
    align-items: center;
    gap: clamp(12px, 3vw, 28px);
    height: 100%;
    font-family: var(--bel-font-mono);
    font-size: var(--bel-text-base);
  }

  .header-search {
    display: flex;
    justify-content: flex-end;
    flex: 0 1 18rem;
    min-width: 0;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(12px, 3vw, 22px);
    flex: 1 1 auto;
    flex-wrap: wrap;
  }
  .site-end {
    display: flex;
    align-items: center;
    gap: clamp(12px, 3vw, 22px);
  }
  .site-nav a,
  .site-end a { color: var(--bel-ui-text); text-decoration: none; }
  .site-nav a:hover,
  .site-end a:hover { text-decoration: underline; }

  .site-nav-compact a { display: none; }
  @media (min-width: 50rem) {
    .site-nav-compact a { display: inline; }
  }

  /* A control that is a mark alone is a circle, a control that carries a word
     is a rectangle. The mode toggle, the search and the drawer button follow
     the same rule, so the bar reads as one set. */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--bel-ui-control-border);
    background: transparent;
    color: var(--bel-ui-text-muted);
    cursor: pointer;
  }
  .theme-toggle:hover { color: var(--bel-ui-text); border-color: var(--bel-ui-accent); }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--bel-ui-accent);
    outline-offset: 2px;
  }

  /* Both icons are drawn and one is shown, because the icon names the mode
     the button switches TO: a moon while the page is light, a sun while it is
     dark. With no stored choice there is no attribute to key off, so the
     system preference carries it. These are SVG rather than the ☽ and ☀
     characters, whose shape would otherwise come from whichever installed
     font the page's fallback chain reaches first, and the two surfaces bring
     different chains. */
  .theme-toggle :global(svg) { width: 15px; height: 15px; }
  .theme-toggle :global(.toggle-sun) { display: none; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-toggle :global(.toggle-moon) { display: none; }
    :root:not([data-theme='light']) .theme-toggle :global(.toggle-sun) { display: block; }
  }
  :root[data-theme='dark'] .theme-toggle :global(.toggle-moon) { display: none; }
  :root[data-theme='dark'] .theme-toggle :global(.toggle-sun) { display: block; }
</style>

<script>
  const STARLIGHT_THEME_KEY = "starlight-theme";

  // Without a stored choice the page has no data-theme and the system
  // carries the mode, so the first click has to read the system to know
  // what it is switching away from.
  const currentTheme = () => {
    const pinned = document.documentElement.dataset.theme;
    if (pinned === "light" || pinned === "dark") return pinned;
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  };

  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
  toggle?.addEventListener("click", () => {
    const next = currentTheme() === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem(STARLIGHT_THEME_KEY, next);
    } catch {
      /* private mode etc. — theme choice only applies to this session */
    }
  });
</script>
