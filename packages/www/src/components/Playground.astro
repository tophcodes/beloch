---
// Live Beloch playground: CodeMirror 6 editor -> Web Worker (eval-worker.js,
// running the committed js_of_ocaml bundle) -> @beloch/scene + @beloch/render-svg
// -> injected SVG. No framework island — a plain client <script type="module">
// wires every `.beloch-playground` instance on the page (Astro dedupes and
// hoists this script once even if the component is used multiple times, so
// the wiring must be instance-scoped via querySelectorAll, not a singleton).
//
// Beloch-aware syntax highlighting (tree-sitter, via ../lib/highlight-bel.ts)
// is a build-time-only pipeline today (see Beloch.astro) — a live CM6
// language/highlight extension for .bel is not wired up yet, so the editor
// runs with CM6's basicSetup only (no Beloch token coloring).
import { highlightBel } from "../lib/highlight-bel";

interface Props {
  code?: string;
  height?: number;
  // Build-time-rendered SVG markup shown in `.pg-result` before any live
  // evaluation has run (e.g. a static hero fold rendered via evalBelToFold,
  // the same build-time path `<Beloch>` uses). Optional — default behavior
  // (the "Run drücken" notice) is unchanged when absent.
  seed?: string;
  // The FOLD JSON `seed` was rendered from (JSON.stringify'd). Optional — when
  // present, the client parses it directly (parseFold + render-svg only, no
  // wasm) on mount to populate the scrubber immediately, without waiting for
  // a Run click or the eval Worker's wasm boot.
  seedFold?: string;
  // When true, defer creating the eval Worker (and the 5.7 MB wasm module it
  // pulls) until the user actually clicks Run, instead of on mount. Optional
  // — default is today's eager boot.
  lazy?: boolean;
  // "hero" is the landing's card: the program and the drawing, and nothing to
  // operate. No run button, no step rail, no paper choice, no export, and the
  // source is read-only. A visitor who wants to change something goes to the
  // playground, which is the one surface with an editor.
  variant?: "full" | "hero";
}
const { code = "", height = 320, seed, seedFold, lazy = false, variant = "full" } = Astro.props;

// The program, coloured at build time by the same grammar the editor will use
// (lib/highlight-bel.ts). It stands in the pane until the editor's parser has
// loaded, so the first paint already carries the syntax colours and mounting
// the editor never takes them away again. Line numbers are known here too.
const highlightedCode = code ? await highlightBel(code) : "";
const codeLines = code ? code.split("\n").length : 0;
---

<div
  class={`beloch-playground${variant === "hero" ? " is-hero" : ""}`}
  style={`--pg-height:${height}px`}
  data-lazy={lazy ? "true" : "false"}
  data-variant={variant}
>
  <div class="pg-pane pg-editor">
    <div class="pg-source">
      <template class="pg-source-seed">{code}</template>
      {code ? (
        <pre class="pg-source-static"><span class="pg-static-gutter">{Array.from({ length: codeLines }, (_, i) => i + 1).join("\n")}</span><code set:html={highlightedCode} /></pre>
      ) : null}
    </div>
    {seedFold ? <script type="application/json" class="pg-seed-fold" set:html={seedFold} /> : null}
  </div>
  <div class="pg-pane pg-output">
    <div class="pg-toolbar pg-toolbar-output">
      <div class="pg-toolbar-views" role="tablist" aria-label="View">
        <button type="button" role="tab" class="pg-view" data-view="cp" aria-selected="false">crease pattern</button>
        <button type="button" role="tab" class="pg-view is-active" data-view="folded" aria-selected="true">folded</button>
      </div>
      <div class="pg-toolbar-tools">
        <div class="pg-swatches" role="group" aria-label="Paper"></div>
        <button type="button" class="pg-export-toggle" aria-expanded="false">export</button>
      </div>
    </div>
    <div
      class="pg-result"
      role="group"
      aria-label="Drawing. Arrow keys step, plus and minus zoom, 0 resets the view."
    >
      <div class="pg-viewer-controls">
        <button type="button" class="pg-cycle pg-cycle-style">mono</button>
        <button type="button" class="pg-cycle pg-cycle-occl">hidden: off</button>
      </div>
      <div class="pg-canvas">
        {seed ? <Fragment set:html={seed} /> : <p class="pg-notice pg-notice-info">Press “Run” to evaluate.</p>}
      </div>
      <button type="button" class="pg-reset" hidden aria-label="Reset view" title="Reset view">
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
          <path
            d="M8 3.5a4.5 4.5 0 1 0 4.24 3"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />
          <path d="M12.5 1.5 L12.5 5 L9 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <div class="pg-export" hidden>
        <p class="pg-export-step"></p>
        <button type="button" data-export="download">Download SVG</button>
        <button type="button" data-export="copy">Copy SVG</button>
        <button type="button" data-export="link">Copy link to program + step</button>
        <p class="pg-export-said" role="status"></p>
      </div>
    </div>
    <aside class="pg-inspect" hidden></aside>
    <div class="pg-error" role="alert" hidden></div>
    <div class="pg-steps" hidden>
      <div class="pg-step-timeline">
        <button type="button" class="pg-step-nav pg-step-prev" aria-label="Previous step" title="Previous step">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path d="M10 3 L5 8 L10 13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="pg-step-track"></div>
        <button type="button" class="pg-step-nav pg-step-next" aria-label="Next step" title="Next step">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path d="M6 3 L11 8 L6 13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
      <span class="pg-step-label"></span>
    </div>
  </div>
  <button type="button" class="pg-run" aria-label="Run" title="Run">
    <svg class="pg-run-play" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
      <path d="M3 2 L13 8 L3 14 Z" fill="currentColor" />
    </svg>
    <span class="pg-run-spinner" aria-hidden="true"></span>
  </button>
  <div class="pg-run-hint" role="status" aria-live="polite"></div>
</div>

<style>
  /* 44 / 56. The drawing takes more than half the card, so its shorter edge
     clears 320 px at every width the two columns are used at (B3.2), and the
     editor still holds a forty-character line without wrapping. */
  .beloch-playground {
    display: grid;
    grid-template-columns: 44% 1fr;
    position: relative;
    margin: 1.5rem 0;
    border: 1px solid var(--bel-ui-divider);
    border-radius: var(--bel-radius-card);
    overflow: hidden;
    background: var(--bel-ui-surface);
    /* Opt the rendered paper's SVG backdrop rect out of its white default
       (WEB_THEME reads --bel-paper-background) so the paper lies on the transparent pane. */
    --bel-paper-background: transparent;
    /* The editor's step-marker gutter, in one place: the CodeMirror gutter
       reads it, and so does the static copy that stands in before the editor
       mounts, so the two cannot drift apart horizontally. */
    --pg-step-gutter: 14px;
  }
  /* Under the break the drawing goes above the code (B3.7), and the editor
     keeps a height that reaches past the fold, so the cut-off line at the
     bottom of the screen says there is more (B3.9). */
  @media (max-width: 720px) {
    .beloch-playground { grid-template-columns: 1fr; }
    .pg-output { order: 1; }
    .pg-editor { order: 2; }
    /* With the panes stacked there is no seam to sit on, so the run button
       goes into the corner of the pane it acts on. */
    .pg-run {
      left: auto;
      right: 14px;
      top: auto;
      bottom: 14px;
      transform: none;
    }
    .pg-run-hint {
      left: auto;
      right: 14px;
      top: auto;
      bottom: 66px;
      transform: none;
    }
  }

  /* The hero: program and drawing, and nothing to operate. It carries no card
     edge, because on the landing the page is its frame. Every token it uses
     the docs already have (8.1 of the conditions). */
  .beloch-playground.is-hero {
    /* Wide enough that the hero's program needs no horizontal scrollbar, and
       still the smaller of the two columns, so the drawing leads. */
    grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
    gap: 40px;
    border: none;
    border-radius: 0;
    background: transparent;
    overflow: visible;
  }
  .is-hero .pg-editor {
    border-right: none;
    border-radius: var(--bel-radius-card);
    overflow: hidden;
    align-self: center;
  }
  .is-hero .pg-toolbar,
  .is-hero .pg-run,
  .is-hero .pg-run-hint,
  .is-hero .pg-steps,
  .is-hero .pg-inspect,
  .is-hero .pg-error,
  .is-hero .pg-reset,
  .is-hero .pg-viewer-controls,
  .is-hero .pg-export {
    display: none;
  }
  /* The hero's row is sized by its two panes, so the drawing needs a height to
     fit into rather than a floor to grow from. The SVG's own `max-height:100%`
     resolves to nothing against a parent whose height is its content, so
     without a definite height up the chain the drawing draws at natural size
     and runs off the page. */
  .is-hero .pg-output {
    height: var(--pg-height, 320px);
  }
  .is-hero .pg-result {
    min-height: 0;
    cursor: default;
  }
  @media (max-width: 720px) {
    .beloch-playground.is-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .is-hero .pg-editor { border-top: none; }
  }

  .pg-pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .pg-editor {
    background: var(--bel-ui-code-surface);
    border-right: 1px solid var(--bel-ui-divider);
  }
  @media (max-width: 720px) {
    .pg-editor { border-right: none; border-bottom: 1px solid var(--bel-ui-divider); }
  }

  .pg-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 16px;
    gap: 8px 16px;
    font-family: var(--bel-font-mono);
    font-size: 12px;
  }
  .pg-output .pg-toolbar {
    color: var(--bel-ui-text-muted);
    border-bottom: 1px solid var(--bel-ui-divider);
  }
  .pg-toolbar-output {
    gap: 16px;
  }
  .pg-toolbar-tools {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-left: auto;
  }
  .pg-toolbar-views {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
  }

  /* Line style and paper are siblings: which ink the diagram uses, and what it
     is drawn on. A paper whose contrast the coloured style cannot hold
     switches that button off (see colorOk in lib/paper-schemes) and says why
     in its title, rather than dropping it and leaving a gap. */
  /* The two drawing switches sit over the paper rather than in the header
     row: they change what the reader is looking at, so they belong where
     the looking happens. Each is one button carrying its own state, cycled
     by clicking — see updateCycleButtons. Top left, opposite the reset
     button at top right. */
  .pg-viewer-controls {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    display: flex;
    gap: 6px;
  }
  .pg-cycle {
    background: color-mix(in srgb, var(--bel-ui-surface) 78%, transparent);
  }
  .pg-view,
  .pg-cycle,
  .pg-export-toggle {
    font: inherit;
    font-size: 12px;
    padding: 3px 10px;
    border-radius: var(--bel-radius-control);
    border: 1px solid var(--bel-ui-control-border);
    background: transparent;
    color: var(--bel-ui-text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: color var(--bel-duration-state) var(--bel-ease), border-color var(--bel-duration-state) var(--bel-ease);
  }
  .pg-view:hover,
  .pg-cycle:hover:not(:disabled),
  .pg-export-toggle:hover {
    color: var(--bel-ui-accent);
  }
  .pg-view.is-active,
  .pg-export-toggle[aria-expanded="true"] {
    border-color: var(--bel-ui-accent);
    color: var(--bel-ui-text);
  }
  .pg-cycle:disabled {
    cursor: default;
    border-color: var(--bel-ui-divider);
    color: var(--bel-ui-text-faint);
  }
  .pg-view:focus-visible,
  .pg-cycle:focus-visible,
  .pg-export-toggle:focus-visible {
    outline: 2px solid var(--bel-ui-accent);
    outline-offset: 2px;
  }

  .pg-run {
    position: absolute;
    left: 44%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--bel-ui-accent);
    background: var(--bel-ui-surface);
    color: var(--bel-ui-accent);
    cursor: pointer;
    transition: background var(--bel-duration-state) var(--bel-ease), color var(--bel-duration-state) var(--bel-ease);
  }
  .pg-run:hover:not(:disabled) {
    background: var(--bel-ui-accent);
    color: var(--bel-ui-accent-text);
  }
  .pg-run:disabled {
    cursor: default;
    border-color: var(--bel-ui-divider);
    color: var(--bel-ui-text-faint);
  }
  .pg-run-spinner {
    display: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid currentColor;
    border-top-color: transparent;
    animation: pg-spin 0.7s linear infinite;
  }
  .pg-run.is-loading .pg-run-play { display: none; }
  .pg-run.is-loading .pg-run-spinner { display: block; }
  /* Once the transfer reports itself, the ring turns by how much of the
     runtime has arrived instead of looping: the movement carries the progress
     the status line spells out (B2.12). */
  .pg-run.has-progress .pg-run-spinner {
    animation: none;
    transform: rotate(var(--pg-load-turn, 0deg));
    transition: transform var(--bel-duration-state) var(--bel-ease);
  }
  @keyframes pg-spin {
    to { transform: rotate(360deg); }
  }

  .pg-run-hint {
    position: absolute;
    left: 44%;
    top: calc(50% + 36px);
    transform: translateX(-50%);
    z-index: 2;
    max-width: calc(100% - 24px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--bel-font-mono);
    font-size: 11px;
    color: var(--bel-ui-text-muted);
    background: var(--bel-ui-surface);
    border: 1px solid var(--bel-ui-divider);
    border-radius: 999px;
    padding: 3px 10px;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--bel-duration-state) var(--bel-ease);
  }
  .pg-run-hint.is-visible {
    opacity: 1;
  }

  /* The editor fills its pane through the flex chain rather than a percentage
     height: this box takes its size from `min-height` and from growing, so its
     computed height stays `auto` and a child's `height: 100%` would resolve to
     its own content, leaving a strip of pane below the editor. */
  .pg-source {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: var(--pg-height, 320px);
    resize: vertical;
    overflow: hidden;
    background: transparent;
  }
  .pg-source :global(.cm-editor) {
    flex: 1;
    min-height: 0;
  }

  /* The build-time copy of the program, holding the pane until the editor's
     parser has loaded. Its type grid is the editor's: the same font, the same
     --bel-code-* scale, the same content padding and the same gutter width, so
     the swap moves no glyph. cm-mount.test.ts pins the four values that have
     to agree. */
  .pg-source-static {
    display: grid;
    grid-template-columns: var(--pg-step-gutter) auto minmax(0, 1fr);
    flex: 1;
    min-height: 0;
    margin: 0;
    padding: 14px 18px 14px 0;
    overflow: hidden;
    font-family: var(--bel-font-mono);
    font-size: var(--bel-code-size);
    line-height: var(--bel-code-line);
    color: var(--bel-ui-code-text);
    white-space: pre;
  }
  .pg-static-gutter {
    grid-column: 2;
    padding-right: 3px;
    padding-left: 5px;
    margin-right: 18px;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    min-width: 20px;
    text-align: right;
    color: var(--bel-ui-code-gutter);
    user-select: none;
  }
  .pg-source-static code {
    font: inherit;
    background: none;
    padding: 0;
    white-space: pre;
  }
  .pg-source :global(.cm-scroller) {
    overflow: auto;
  }
  .pg-source :global(.cm-step-gutter) {
    width: var(--pg-step-gutter);
  }
  /* basicSetup brings a fold gutter. Folding needs a language to supply the
     ranges, and this editor colours through decorations rather than through a
     CodeMirror language, so that gutter can never show a marker. Hidden, it
     stops taking ten pixels that the static copy would otherwise have to
     reproduce to keep the swap from moving the text.
     `!important` because CodeMirror's base theme marks every gutter's display
     `flex !important` to stop margin collapsing, and nothing weaker reaches
     past that. */
  .pg-source :global(.cm-foldGutter) {
    display: none !important;
  }
  /* The editor sits on the code surface, so the step marker takes that
     surface's fixed accent rather than the one that follows the mode. */
  .pg-source :global(.cm-step-dot) {
    display: block;
    width: 8px;
    height: 8px;
    margin: 6px auto 0;
    border-radius: 50%;
    background: var(--bel-ui-code-accent);
  }
  .pg-source :global(.cm-step-line) {
    background: color-mix(in srgb, var(--bel-ui-code-accent) 15%, transparent);
  }
  /* Every place the clicked bundle is named: the operands of a construction,
     the arguments of a flatten, a filter. Marked on the characters rather
     than the line, because a line can name several creases. */
  .pg-source :global(.cm-bel-ref) {
    border-radius: 2px;
    background: color-mix(in srgb, var(--bel-ui-code-accent) 28%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--bel-ui-code-accent) 45%, transparent);
  }
  /* The line a failed run named, on the same always-dark surface and in that
     surface's own error colour. It stands next to the step line rather than
     replacing it: the drawing the step marks is still on screen. */
  .pg-source :global(.cm-error-line) {
    background: color-mix(in srgb, var(--bel-ui-code-error) 12%, transparent);
    box-shadow: inset 3px 0 0 var(--bel-ui-code-error);
  }

  .pg-output {
    background: transparent;
  }
  .pg-result {
    position: relative;
    flex: 1;
    min-height: var(--pg-height, 320px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
  }
  .pg-result.is-panning {
    cursor: grabbing;
  }
  /* The paper itself: pan/zoom transform target. Origin 0 0 keeps the
     zoom-toward-cursor math (in the client script) layout-agnostic. */
  /* The canvas fills the pane rather than shrinking to the drawing, so its
     height is definite and the SVG's own `max-height: 100%` has something to
     resolve against. Against a parent whose height is its content that
     percentage resolves to nothing and a large drawing renders at natural size
     and gets clipped. The drawing stays centred because this is itself a
     centring flex container, and the pan/zoom maths reads this element's live
     rect, so a bigger box changes nothing there. */
  .pg-canvas {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    flex: 1;
    min-width: 0;
    min-height: 0;
    transform-origin: 0 0;
    will-change: transform;
  }
  .pg-canvas :global(svg) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }
  /* Cursor→SVG side of the bidirectional entity highlight: outlines the
     crease segment(s) whose provenance span covers the editor's cursor
     line. Overrides the per-segment stroke/stroke-width attributes
     render-scene.ts emits (CSS class beats presentation attributes). */
  .pg-canvas :global(.pg-hl) {
    stroke: var(--bel-ui-accent);
    stroke-width: 4;
  }
  /* Occluded segments of a highlighted bundle, drawn from inspect data since
     they have no rendered line — dashed + semi-transparent to read as "behind". */
  .pg-canvas :global(.pg-hl-ghost) {
    stroke: var(--bel-ui-accent);
    stroke-width: 2.5;
    stroke-dasharray: 5 4;
    opacity: 0.55;
    fill: none;
    pointer-events: none;
  }
  /* Notices (info/error) mustn't inherit the grab cursor — they're not
     draggable paper. */
  .pg-canvas:has(:global(.pg-notice)) {
    cursor: default;
  }
  /* Crease hit-area (task 8): enhanceCreaseHits inserts one of these,
     transparent and fat, right after every real crease line so there's a
     forgiving click target — the visible line itself stays thin. */
  .pg-canvas :global(line.pg-hit) {
    stroke: transparent;
    stroke-width: 14;
    fill: none;
    pointer-events: stroke;
    cursor: pointer;
  }
  /* The point twin is a disc rather than a fat stroke, so it takes the
     pointer over its whole area. */
  .pg-canvas :global(circle.pg-hit) {
    fill: transparent;
    stroke: none;
    pointer-events: fill;
    cursor: pointer;
  }
  /* Everything grabs the paper by default (see .pg-result above) — creases
     (and their hit-area twins) are the one thing you can click, so they get
     their own cursor to signal that. Task 9: paper boundary lines are
     selectable too but carry no data-crease-id, so this also matches on
     data-kind="crease" directly (a superset of the data-crease-id case). */
  .pg-canvas :global([data-crease-id]),
  .pg-canvas :global(line[data-kind="crease"]) {
    cursor: pointer;
  }

  .pg-reset {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border-radius: var(--bel-radius-control);
    border: 1px solid var(--bel-ui-control-border);
    background: color-mix(in srgb, var(--bel-ui-surface) 78%, transparent);
    color: var(--bel-ui-text-muted);
    cursor: pointer;
    opacity: 0.45;
    transition: opacity var(--bel-duration-state) var(--bel-ease), color var(--bel-duration-state) var(--bel-ease);
  }
  .pg-result:hover .pg-reset:not([hidden]),
  .pg-reset:hover,
  .pg-reset:focus-visible {
    opacity: 1;
  }
  .pg-reset:hover {
    color: var(--bel-ui-accent);
  }
  .pg-reset:focus-visible {
    outline: 2px solid var(--bel-ui-accent);
    outline-offset: 2px;
  }
  .pg-reset[hidden] {
    display: none;
  }

  /* Cursor-following tooltip (task 8): fixed positioning, left/top driven
     from the pointer event each mousemove. `pointer-events: none` while
     following — the tooltip sits right where the cursor is, so if it could
     receive pointer events, hovering it would itself register as "leaving"
     the crease underneath and flicker the tooltip shut. Anchoring re-enables
     them (the close button + segment rows need clicks). */
  /* The inspector is a rail under the drawing. It keeps one place, so it does
     not move under the pointer as the answer changes, it covers no paper
     (B3.11), and it stays where it is across a step change. Below the break
     it is the same rail in the same place. */
  .pg-inspect {
    position: relative;
    max-height: 40vh;
    overflow: auto;
    background: var(--bel-ui-surface);
    border-top: 1px solid var(--bel-ui-divider);
    padding: 10px 16px;
    font: 12px/1.5 var(--bel-font-mono);
    color: var(--bel-ui-text-muted);
  }
  .pg-inspect[hidden] {
    display: none;
  }
  /* The rail holds the height of an answer while it has none, so pointing at a
     crease fills it instead of pushing the step bar down the card. */
  .pg-inspect {
    min-height: 62px;
  }
  .pg-inspect :global(.pg-inspect-rest) {
    color: var(--bel-ui-text-faint);
  }
  /* These children are injected via innerHTML, so they never carry Astro's
     scope attribute — the rules MUST be :global (like .pg-hl / .pg-hit above),
     or they silently don't apply. */
  .pg-inspect :global(h4) {
    margin: 0 0 4px;
    font-size: 12px;
    color: var(--bel-ui-text);
    padding-right: 18px; /* room for the close button */
  }
  .pg-inspect :global(.pg-inspect-sub) {
    color: var(--bel-ui-text-muted);
    margin-bottom: 4px;
  }
  .pg-inspect :global(.pg-inspect-close) {
    position: absolute;
    top: 2px;
    right: 4px;
    z-index: 1;
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    background: transparent;
    box-shadow: none;
    color: var(--bel-ui-text);
    font: 18px/1 ui-sans-serif, system-ui, sans-serif;
    cursor: pointer;
    padding: 4px;
    opacity: 0.5;
  }
  .pg-inspect :global(.pg-inspect-close:hover) {
    opacity: 1;
  }
  .pg-inspect :global(.pg-inspect-close:focus-visible) {
    outline: 2px solid var(--bel-ui-accent);
    border-radius: var(--bel-radius-control);
  }
  .pg-inspect :global(.seg) {
    border-top: 1px solid var(--bel-ui-divider);
    margin: 4px -12px 0;
    padding: 5px 12px 4px;
    cursor: pointer;
  }
  .pg-inspect :global(.seg:hover) {
    color: var(--bel-ui-text);
    background: color-mix(in srgb, var(--bel-ui-text) 10%, transparent);
  }

  .pg-canvas :global(.pg-notice) {
    margin: 0;
    max-width: 32ch;
    text-align: center;
    font-family: var(--bel-font-prose);
    font-size: 13.5px;
    line-height: 1.5;
  }
  .pg-canvas :global(.pg-notice-info) { color: var(--bel-ui-text-muted); }

  .pg-swatches { display: inline-flex; gap: 8px; }
  .pg-swatches :global(.pg-swatch) {
    width: 22px; height: 22px; padding: 0;
    border-radius: 50%;
    border: 1px solid var(--bel-ui-control-border);
    cursor: pointer;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }
  .pg-swatches :global(.pg-swatch:hover) {
    border-color: var(--bel-ui-accent);
  }
  .pg-swatches :global(.pg-swatch:focus-visible) {
    outline: 2px solid var(--bel-ui-accent);
    outline-offset: 2px;
  }
  /* The chosen paper carries a ring in the panel colour and then the accent,
     so the mark reads against a swatch of any lightness. */
  .pg-swatches :global(.pg-swatch.is-active) {
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.08),
      0 0 0 2px var(--bel-ui-surface),
      0 0 0 4px var(--bel-ui-accent);
  }

  /* The drawing takes focus as one target: arrow keys walk the steps, plus and
     minus zoom, 0 resets. The ring is offset inwards because this pane runs to
     the card's own edge, and a ring outside it would sit on that edge. */
  .pg-result:focus-visible {
    outline: 2px solid var(--bel-ui-accent);
    outline-offset: -4px;
  }
  /* A crease is reached with the keyboard through its hit line, which is
     transparent until it carries focus. An `outline` on an SVG line is drawn
     around its bounding box, so the hit stroke itself is what shows. */
  .pg-canvas :global(.pg-hit:focus-visible) {
    outline: none;
    stroke: var(--bel-ui-accent);
    stroke-opacity: 0.4;
  }

  /* Export sits in the quiet zone beside the reset button: it is reachable
     without the drawing moving, and it covers paper only while it is open. */
  .pg-export {
    position: absolute;
    top: 10px;
    right: 48px;
    z-index: 5;
    width: 240px;
    padding: 8px 12px 10px;
    background: var(--bel-ui-surface);
    border: 1px solid var(--bel-ui-divider);
    border-radius: var(--bel-radius-card);
    font-family: var(--bel-font-mono);
  }
  .pg-export[hidden] { display: none; }
  .pg-export-step {
    margin: 0 0 2px;
    font-size: 11px;
    color: var(--bel-ui-text-faint);
  }
  .pg-export button {
    display: block;
    width: 100%;
    text-align: left;
    font: inherit;
    font-size: 12px;
    color: var(--bel-ui-text);
    background: transparent;
    border: 0;
    padding: 5px 0;
    cursor: pointer;
  }
  .pg-export button:hover { color: var(--bel-ui-accent); }
  .pg-export button:focus-visible {
    outline: 2px solid var(--bel-ui-accent);
    outline-offset: 1px;
  }
  .pg-export button[data-export="link"] {
    border-top: 1px solid var(--bel-ui-divider);
    margin-top: 4px;
  }
  .pg-export-said {
    margin: 2px 0 0;
    min-height: 1em;
    font-size: 11px;
    color: var(--bel-ui-text-muted);
  }

  /* A diagnostic stands beside the drawing it belongs to and never in place of
     it: the last valid drawing is what the reader is comparing the message
     against (B3.5). */
  .pg-error {
    padding: 9px 16px;
    border-top: 1px solid var(--bel-ui-divider);
    font-family: var(--bel-font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--bel-ui-text);
  }
  .pg-error[hidden] { display: none; }
  .pg-error :global(.pg-error-where) {
    color: var(--bel-ui-error);
    font-weight: 600;
    margin-right: 8px;
  }

  .pg-steps {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
    padding: 8px 16px;
    border-top: 1px solid var(--bel-ui-divider);
    font-family: var(--bel-font-mono);
    font-size: 11px;
    color: var(--bel-ui-text-muted);
  }
  .pg-steps[hidden] { display: none; }

  .pg-step-timeline {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pg-step-nav {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border-radius: var(--bel-radius-control);
    border: 1px solid var(--bel-ui-control-border);
    background: transparent;
    color: var(--bel-ui-text-muted);
    cursor: pointer;
    transition: color var(--bel-duration-state) var(--bel-ease), border-color var(--bel-duration-state) var(--bel-ease);
  }
  .pg-step-nav:hover:not(:disabled) {
    color: var(--bel-ui-accent);
    border-color: var(--bel-ui-accent);
  }
  .pg-step-nav:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* The track: dots spread edge-to-edge over a connecting rule, with a
     valley-colored progress fill running left→current so the position is
     legible in the bar itself (--pg-progress is set per step in JS). */
  .pg-step-track {
    position: relative;
    flex: 1;
    min-width: 0;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .pg-step-track::before,
  .pg-step-track::after {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    height: 3px;
    border-radius: 3px;
    transform: translateY(-50%);
    /* Purely decorative rules — must never intercept the pointer, or the
       dots underneath lose their pointer cursor / clickability. */
    pointer-events: none;
  }
  .pg-step-track::before {
    right: 0;
    background: var(--bel-ui-divider);
  }
  .pg-step-track::after {
    width: var(--pg-progress, 0%);
    background: var(--bel-ui-accent);
    transition: width var(--bel-duration-state) var(--bel-ease);
  }
  :global(.pg-step-dot) {
    position: relative;
    z-index: 1;
    flex: none;
    width: 34px;
    height: 34px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  :global(.pg-step-dot)::before {
    content: "";
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--bel-ui-control-border);
    background: var(--bel-ui-surface);
    /* Panel-colored gap ring separates the dot from the track line so it
       clearly reads as sitting *on top of* the line, not merged into it. */
    box-shadow: 0 0 0 3px var(--bel-ui-surface);
    transition: transform var(--bel-duration-state) var(--bel-ease), background var(--bel-duration-state) var(--bel-ease), border-color var(--bel-duration-state) var(--bel-ease);
  }
  :global(.pg-step-dot:hover)::before {
    border-color: var(--bel-ui-accent);
    transform: scale(1.15);
  }
  /* Steps at or before the current one read as "reached" (filled valley);
     the current one is additionally enlarged with a halo ring. */
  :global(.pg-step-dot.is-past)::before {
    background: var(--bel-ui-accent);
    border-color: var(--bel-ui-accent);
  }
  :global(.pg-step-dot.is-active) {
    z-index: 2;
  }
  :global(.pg-step-dot.is-active)::before {
    width: 18px;
    height: 18px;
    background: var(--bel-ui-accent);
    border-color: var(--bel-ui-accent);
    /* Inner panel gap ring + outer valley glow — pops the current dot off
       both the line and its neighbors. */
    box-shadow:
      0 0 0 3px var(--bel-ui-surface),
      0 0 0 6px color-mix(in srgb, var(--bel-ui-accent) 30%, transparent);
  }
  .pg-step-label {
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<script>
  import { EditorView, basicSetup } from "codemirror";
  import { EditorState } from "@codemirror/state";
  import { keymap } from "@codemirror/view";
  import { stepMarkerExtensions, setStepLineOn, setErrorLineOn } from "../lib/cm-step-marker";
  import { refMarkExtensions, setRefSpansOn } from "../lib/cm-ref-marks";
  import { initBelHighlight, belHighlighting } from "../lib/cm-bel-highlight";
  import { swapDrawing, type FadeLength } from "../lib/crossfade";
  import { parseFold, type FoldScene, type Statement, type Vec2 } from "@beloch/scene";
  import {
    colorLineStyle,
    renderCP,
    renderFolded,
    renderScene,
    sceneLayout,
    DEFAULT_THEME,
    WEB_THEME,
    type Theme,
  } from "@beloch/render-svg";
  import { SCHEMES, STORAGE_KEY, DEFAULT_ID, applyScheme, resolveScheme } from "../lib/paper-schemes";
  import { lineOfSpan, lookupEntity, type EntityRef } from "../lib/inspect-lookup";
  import { segMatchesLine } from "../lib/stack-picker";
  import { hoverSummary, segmentRows, edgeSegmentRows } from "../lib/tooltip-content";
  import { bundleElements } from "../lib/bundle-highlight";
  import { enhanceCreaseHits, enhancePointHits, CREASE_SELECTOR, HIT_CLASS } from "../lib/crease-hits";
  import { edgeOfLine } from "../lib/edge-lookup";
  import { runUi, type RuntimePhase } from "../lib/playground-run-state";

  // Two separate limits. Booting the Worker pulls the wasm runtime over the
  // network (megabytes, once per visitor); the evaluation itself then runs
  // locally. The eval limit starts only once the Worker reports its runtime
  // ready (see public/beloch/eval-worker.js), so a slow line stays
  // distinguishable from a hung evaluator.
  // Which drawing of a state the stage shows. Both come off one step index.
  type View = "cp" | "folded";

  const LOAD_TIMEOUT_MS = 60000;
  const EVAL_TIMEOUT_MS = 8000;

  const editorTheme = EditorView.theme(
    {
      "&": {
        color: "var(--bel-ui-code-text)",
        backgroundColor: "transparent",
        height: "100%",
      },
      ".cm-scroller": {
        fontFamily: "var(--bel-font-mono)",
        fontSize: "var(--bel-code-size)",
        lineHeight: "var(--bel-code-line)",
      },
      ".cm-content": { padding: "14px 18px", caretColor: "var(--bel-ui-code-text)" },
      ".cm-gutters": {
        backgroundColor: "transparent",
        color: "var(--bel-ui-code-gutter)",
        border: "none",
        borderRight: "1px solid rgba(255, 255, 255, 0.08)",
      },
      ".cm-activeLine": { backgroundColor: "rgba(255, 255, 255, 0.04)" },
      ".cm-activeLineGutter": { backgroundColor: "rgba(255, 255, 255, 0.04)" },
      "&.cm-focused": { outline: "none" },
    },
    { dark: true },
  );

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  // Vanilla pan/zoom over a transform target (`.pg-canvas`) inside a viewport
  // (`.pg-result`). No library — a translate()+scale() matrix driven by
  // pointer-drag (pan) and wheel (zoom-toward-cursor). The zoom math is
  // layout-agnostic: it reads the target's live client rect each wheel tick,
  // so it works whether the canvas is flex-centered (identity) or panned.
  function createPanZoom(
    viewport: HTMLElement,
    target: HTMLElement,
    resetBtn: HTMLElement,
  ) {
    const MIN = 0.2;
    const MAX = 8;
    let scale = 1;
    let tx = 0;
    let ty = 0;
    let enabled = true;
    let dragging = false;
    let pointerId = -1;
    let lastX = 0;
    let lastY = 0;
    // Total displacement since pointerdown, past which a gesture counts as a
    // pan rather than a click — read by the entity-inspector click handler
    // (below) so a pan-and-release doesn't also pin whatever entity happens
    // to sit under the cursor at drop.
    const DRAG_THRESHOLD = 4;
    let downX = 0;
    let downY = 0;
    let dragMoved = false;

    function apply() {
      target.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
    }
    function reset() {
      scale = 1;
      tx = 0;
      ty = 0;
      apply();
    }
    function setEnabled(on: boolean) {
      enabled = on;
      if (!on) endDrag();
    }

    // Scaling about a point: with transform-origin 0 0, keeping that point
    // fixed means translate delta = (point − target-origin)·(1 − s'/s).
    function zoomAbout(clientX: number, clientY: number, next: number) {
      const clamped = Math.min(MAX, Math.max(MIN, next));
      if (clamped === scale) return;
      const cr = target.getBoundingClientRect();
      const ratio = clamped / scale;
      tx += (clientX - cr.left) * (1 - ratio);
      ty += (clientY - cr.top) * (1 - ratio);
      scale = clamped;
      apply();
    }

    // Zoom from the keyboard has no cursor to hold still, so it holds the
    // middle of the viewport.
    function zoomBy(factor: number) {
      const r = viewport.getBoundingClientRect();
      zoomAbout(r.left + r.width / 2, r.top + r.height / 2, scale * factor);
    }

    // A wheel or a swipe over the drawing scrolls the page, like everywhere
    // else on it (B3.8). Zoom asks for itself: the modifier a trackpad pinch
    // already sends, or the drawing holding focus, which is also the state in
    // which + and − zoom.
    viewport.addEventListener(
      "wheel",
      (e: WheelEvent) => {
        if (!enabled) return;
        const asked = e.ctrlKey || e.metaKey || viewport.contains(document.activeElement);
        if (!asked) return;
        e.preventDefault();
        zoomAbout(e.clientX, e.clientY, scale * Math.exp(-e.deltaY * 0.0015));
      },
      { passive: false },
    );

    viewport.addEventListener("pointerdown", (e: PointerEvent) => {
      if (!enabled || e.button !== 0) return;
      if (resetBtn.contains(e.target as Node)) return;
      dragging = true;
      pointerId = e.pointerId;
      lastX = e.clientX;
      lastY = e.clientY;
      downX = e.clientX;
      downY = e.clientY;
      dragMoved = false;
      viewport.classList.add("is-panning");
    });
    viewport.addEventListener("pointermove", (e: PointerEvent) => {
      if (!dragging) return;
      tx += e.clientX - lastX;
      ty += e.clientY - lastY;
      lastX = e.clientX;
      lastY = e.clientY;
      if (!dragMoved && Math.hypot(e.clientX - downX, e.clientY - downY) > DRAG_THRESHOLD) {
        dragMoved = true;
        // Capture the pointer only once a genuine drag starts — NOT on
        // pointerdown. Capturing on down retargets the synthesized `click` to
        // the viewport, so a plain click's `e.target` is no longer the crease
        // line and the inspector can't anchor. A pure click never crosses the
        // threshold, so it never captures and keeps its real target.
        viewport.setPointerCapture(pointerId);
      }
      apply();
    });
    function endDrag() {
      if (!dragging) return;
      dragging = false;
      if (pointerId !== -1 && viewport.hasPointerCapture(pointerId)) {
        viewport.releasePointerCapture(pointerId);
      }
      pointerId = -1;
      viewport.classList.remove("is-panning");
    }
    viewport.addEventListener("pointerup", endDrag);
    viewport.addEventListener("pointercancel", endDrag);
    resetBtn.addEventListener("click", reset);

    // wasDrag() is read by the click handler, which fires AFTER pointerup
    // (and thus after endDrag() has already reset `dragging`) — dragMoved
    // survives that reset so the click handler can still tell a pan-release
    // apart from a genuine click.
    //
    // isDragging() is different: it reflects the LIVE `dragging` flag, for
    // the hover tooltip's mousemove handler (task 8) — that one needs to
    // know whether a pan is happening RIGHT NOW (so it doesn't flicker the
    // tooltip while the pointer crosses creases mid-drag), not whether the
    // gesture that JUST ended was a pan (wasDrag() stays true until the
    // NEXT pointerdown, which would wrongly suppress hover for a while
    // after a finished pan).
    return { reset, setEnabled, zoomBy, wasDrag: () => dragMoved, isDragging: () => dragging };
  }

  async function setup(root: HTMLElement) {
    const sourceMount = root.querySelector<HTMLDivElement>(".pg-source");
    const runBtn = root.querySelector<HTMLButtonElement>(".pg-run");
    const result = root.querySelector<HTMLDivElement>(".pg-result");
    const canvas = result?.querySelector<HTMLDivElement>(".pg-canvas");
    const resetBtn = root.querySelector<HTMLButtonElement>(".pg-reset");
    const runHint = root.querySelector<HTMLDivElement>(".pg-run-hint");
    const stepsBar = root.querySelector<HTMLDivElement>(".pg-steps");
    const stepDots = root.querySelector<HTMLDivElement>(".pg-step-track");
    const stepLabel = root.querySelector<HTMLSpanElement>(".pg-step-label");
    const stepPrev = root.querySelector<HTMLButtonElement>(".pg-step-prev");
    const stepNext = root.querySelector<HTMLButtonElement>(".pg-step-next");
    const inspectPanel = root.querySelector<HTMLElement>(".pg-inspect");
    const errorBox = root.querySelector<HTMLDivElement>(".pg-error");
    const exportToggle = root.querySelector<HTMLButtonElement>(".pg-export-toggle");
    const exportPanel = root.querySelector<HTMLDivElement>(".pg-export");
    // Queried here rather than beside the export wiring below, because
    // renderStep reaches for them through updateExportPanel and runs first.
    const exportSaid = exportPanel?.querySelector<HTMLParagraphElement>(".pg-export-said") ?? null;
    const exportStepLine = exportPanel?.querySelector<HTMLParagraphElement>(".pg-export-step") ?? null;
    if (!sourceMount || !runBtn || !result || !canvas || !resetBtn || !runHint || !stepsBar || !stepDots || !stepLabel || !stepPrev || !stepNext || !inspectPanel || !errorBox || !exportToggle || !exportPanel) return;

    const panZoom = createPanZoom(result, canvas, resetBtn);
    // A build-time `seed` SVG is already in the canvas; enable pan/zoom + the
    // reset affordance for it. The "Run drücken" notice is not pannable.
    {
      const hasSeedSvg = !!canvas.querySelector("svg");
      panZoom.setEnabled(hasSeedSvg);
      resetBtn.hidden = !hasSeedSvg;
    }

    function setRunHint(text: string) {
      runHint!.textContent = text;
      runHint!.classList.toggle("is-visible", text !== "");
    }

    const seed = sourceMount.querySelector<HTMLTemplateElement>(".pg-source-seed");
    const initialCode = seed?.content.textContent ?? "";
    // The server's coloured copy stays in the pane until the editor is built,
    // and goes in the same frame the editor goes in, so the reader sees the
    // program in its colours from the first paint through to typing in it.
    const staticSource = sourceMount.querySelector<HTMLElement>(".pg-source-static");
    const highlighter = await initBelHighlight().catch((err) => {
      // A grammar that fails to load costs the colours, not the editor.
      console.warn("playground: syntax highlighting unavailable", err);
      return null;
    });

    // Lazy instances defer the eval Worker (see bootIfNeeded below) until the
    // user actually clicks Run — focusing or editing the code must not, on
    // its own, kick off a run or pull in the wasm module.
    const lazy = root.dataset.lazy === "true";
    // The hero shows a program and its drawing and offers nothing to operate:
    // the controls are hidden, so the behaviour behind them is not wired up
    // either, and the source is read-only.
    const hero = root.dataset.variant === "hero";

    // Run is available whenever no run is in flight, including on first
    // contact with the seeded code. A re-run of unchanged source reports
    // itself in the status line. The states and their wording live in
    // ../lib/playground-run-state.
    let running = false;
    let phase: RuntimePhase = "cold";
    // The run that just finished re-ran source identical to the previous
    // completed run's.
    let repeat = false;
    // A run was dropped because the runtime took longer than LOAD_TIMEOUT_MS.
    let loadStalled = false;
    // Source of the last run the worker actually answered; null until then.
    let lastRunCode: string | null = null;
    // Share of the runtime that has arrived, as the worker reports it, or null
    // while it reports nothing (see public/beloch/eval-worker.js).
    let loadProgress: number | null = null;
    function updateRunButtonState() {
      const ui = runUi({ phase, running, repeat, loadStalled, progress: loadProgress });
      runBtn!.classList.toggle("has-progress", loadProgress !== null);
      // Two and a half turns over the whole transfer, so the ring keeps moving
      // visibly between one reported percent and the next.
      if (loadProgress !== null) {
        runBtn!.style.setProperty("--pg-load-turn", `${Math.round(loadProgress * 900)}deg`);
      }
      runBtn.disabled = ui.disabled;
      runBtn.title = ui.title;
      setRunHint(ui.status);
      // Line numbers from the last run no longer necessarily match the
      // edited text — clear the gutter indicator, but leave the scrubber
      // and the currently-shown SVG alone (same "stale result stays
      // visible" philosophy as the Run button itself).
      if (editor.state.doc.toString() !== lastRunCode) setStepLineOn(editor, null);
    }

    const editor = new EditorView({
      state: EditorState.create({
        doc: initialCode,
        extensions: [
          ...stepMarkerExtensions,
          ...refMarkExtensions,
          basicSetup,
          ...(highlighter ? [belHighlighting(highlighter)] : []),
          EditorView.editable.of(!hero),
          keymap.of([
            {
              key: "Mod-Enter",
              run: () => {
                runBtn.click();
                return true;
              },
            },
          ]),
          editorTheme,
          EditorView.updateListener.of((update) => {
            if (update.docChanged) {
              repeat = false;
              updateRunButtonState();
            }
            if (update.selectionSet) highlightCreasesOnLine(update.state.doc.lineAt(update.state.selection.main.head).number);
          }),
        ],
      }),
      parent: sourceMount,
    });
    staticSource?.remove();
    updateRunButtonState();

    // Exposed so pages embedding this playground (e.g. the landing page's
    // example chips) can load a sample without reaching into CM6 internals.
    (root as unknown as { belochSetCode: (code: string) => void }).belochSetCode = (code) => {
      editor.dispatch({ changes: { from: 0, to: editor.state.doc.length, insert: code } });
    };

    // Which paper the drawing is on, and which of the two line styles draws on
    // it. They belong together: the coloured style is only offered where the
    // paper holds the crease colours (colorOk in lib/paper-schemes), so
    // picking a paper can decide the style.
    let currentSchemeId: string;
    try {
      currentSchemeId = resolveScheme(localStorage.getItem(STORAGE_KEY)).id;
    } catch {
      currentSchemeId = DEFAULT_ID;
    }
    let lineStyleId: "mono" | "colour" = "mono";
    // What the folded view does with the crease segments that lie under other
    // layers. The flat sheet occludes nothing, so this only bites in "folded".
    let hiddenMode: "hide" | "dashed" | "depth" = "hide";
    // Which drawing of the current state is on the stage. Both are the same
    // state: the crease pattern is the flat sheet with the creases that exist
    // by this step, the folded view is that state seen from above with the
    // layers resolved. Switching the tab never moves the step.
    //
    // The folded state leads, because that is what the server already put in
    // the card (index.astro seeds renderFolded) and what the reader pressed
    // Run to see.
    let currentView: View = "folded";

    // The theme the stage draws with: the engine's own colours, resolved by
    // the page through CSS variables, under the chosen line style. Monochrome
    // is the Yoshizawa-Randlett notation a printed diagram uses and carries
    // mountain against valley in the dash pattern; coloured carries it in the
    // hue and reads faster where the paper allows it.
    const renderTheme = (): Partial<Theme> =>
      lineStyleId === "colour" ? { ...WEB_THEME, lineStyle: colorLineStyle } : WEB_THEME;

    // The same drawing with every colour spelled out, for a file that leaves
    // the page. `background: transparent` emits no backdrop behind the paper,
    // so the sheet is what lands in a slide or an issue (B3.10, B3.11).
    const literalTheme = (): Partial<Theme> => {
      const scheme = resolveScheme(currentSchemeId);
      return {
        ...DEFAULT_THEME,
        fill: scheme.fill,
        front: scheme.front,
        back: scheme.back,
        ink: scheme.ink ?? DEFAULT_THEME.ink,
        boundary: scheme.ink ?? DEFAULT_THEME.boundary,
        background: "transparent",
        lineStyle: lineStyleId === "colour" ? colorLineStyle : DEFAULT_THEME.lineStyle,
      };
    };

    // Re-draws what is on the stage after a choice that changes how it looks
    // rather than which state it shows, so the view and the step stay put.
    function rerenderCurrent(fade: FadeLength | null = null) {
      if (!currentScene) return;
      if (currentStatements.length > 0) renderStep(currentStep, true, fade !== null, fade);
      else showSvg(svgForStep(0, renderTheme()), true, fade);
    }

    // The two drawing switches over the paper. Each button carries its own
    // state as its label and steps to the next on click, so the pair takes
    // the width of two words instead of five. A state the current paper or
    // view cannot hold disables the button rather than hiding it, and the
    // title says why.
    const styleBtn = root.querySelector<HTMLButtonElement>(".pg-cycle-style");
    const occlBtn = root.querySelector<HTMLButtonElement>(".pg-cycle-occl");
    const OCCL_LABEL: Record<typeof hiddenMode, string> = {
      hide: "hidden: off",
      dashed: "hidden: dashed",
      depth: "hidden: depth",
    };
    const OCCL_TITLE: Record<typeof hiddenMode, string> = {
      hide: "Buried crease segments are not drawn. Click for dashed.",
      dashed: "Buried crease segments drawn alike. Click to fade them by depth.",
      depth: "Buried crease segments fade with the layers over them. Click to stop drawing them.",
    };
    function updateCycleButtons() {
      const scheme = resolveScheme(currentSchemeId);
      if (styleBtn) {
        styleBtn.textContent = lineStyleId;
        styleBtn.disabled = !scheme.colorOk;
        styleBtn.title = !scheme.colorOk
          ? `Only monochrome on ${scheme.label}: every crease colour falls below 2:1 on this paper`
          : lineStyleId === "mono"
            ? "Yoshizawa-Randlett notation, monochrome. Click for one colour per fold direction."
            : "One colour per fold direction. Click for monochrome.";
      }
      if (occlBtn) {
        const flat = currentView === "cp";
        occlBtn.textContent = OCCL_LABEL[hiddenMode];
        occlBtn.disabled = flat;
        occlBtn.title = flat
          ? "The crease pattern is one flat sheet: nothing is buried"
          : OCCL_TITLE[hiddenMode];
      }
    }
    const viewsBar = root.querySelector<HTMLDivElement>(".pg-toolbar-views");
    function updateViewTabs() {
      viewsBar?.querySelectorAll<HTMLButtonElement>(".pg-view").forEach((b) => {
        const on = b.dataset.view === currentView;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-selected", String(on));
      });
    }
    viewsBar?.addEventListener("click", (e: MouseEvent) => {
      const b = (e.target as Element).closest<HTMLButtonElement>(".pg-view");
      if (!b) return;
      const v = b.dataset.view as View;
      if (v === currentView) return;
      currentView = v;
      updateViewTabs();
      updateCycleButtons();
      // Two views of one state, so the shorter of the two lengths.
      rerenderCurrent("view");
    });
    updateViewTabs();

    styleBtn?.addEventListener("click", () => {
      if (styleBtn.disabled) return;
      lineStyleId = lineStyleId === "mono" ? "colour" : "mono";
      updateCycleButtons();
      rerenderCurrent();
    });
    const OCCL_CYCLE = ["hide", "dashed", "depth"] as const;
    occlBtn?.addEventListener("click", () => {
      if (occlBtn.disabled) return;
      hiddenMode = OCCL_CYCLE[(OCCL_CYCLE.indexOf(hiddenMode) + 1) % OCCL_CYCLE.length]!;
      updateCycleButtons();
      rerenderCurrent();
    });
    updateCycleButtons();

    const swatchBar = root.querySelector<HTMLDivElement>(".pg-swatches");
    if (swatchBar) {
      const activeId = currentSchemeId;
      const buttons = SCHEMES.map((s) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "pg-swatch";
        b.style.background = s.swatch;
        b.title = s.label;
        b.setAttribute("aria-label", s.label);
        b.setAttribute("aria-pressed", String(s.id === activeId));
        b.dataset.schemeId = s.id;
        if (s.id === activeId) b.classList.add("is-active");
        b.addEventListener("click", () => {
          applyScheme(s.id);
          currentSchemeId = s.id;
          // The coloured style falls below 2:1 on kraft and indigo, so a move
          // to one of those papers takes the drawing back to monochrome
          // instead of leaving an unreadable one on screen.
          if (!s.colorOk && lineStyleId === "colour") lineStyleId = "mono";
          updateCycleButtons();
          rerenderCurrent();
          swatchBar.querySelectorAll(".pg-swatch").forEach((el) => {
            el.classList.toggle("is-active", el === b);
            el.setAttribute("aria-pressed", String(el === b));
          });
        });
        return b;
      });
      swatchBar.append(...buttons);
    }

    let worker: Worker | null = null;
    // Load limit (runtime boot) and eval limit (one postMessage round trip);
    // at most one of them runs at a time.
    let loadTimer: ReturnType<typeof setTimeout> | null = null;
    let evalTimer: ReturnType<typeof setTimeout> | null = null;
    // Source waiting for the runtime to report ready, and the source of the
    // request currently with the worker.
    let pendingCode: string | null = null;
    let dispatchedCode: string | null = null;
    let currentScene: FoldScene | null = null;
    let currentStatements: Statement[] = [];
    let currentStep = 0;
    // The step a shared `?s=` names, held until the run behind it produces one
    // (see the bottom of setup).
    let pendingSharedStep: number | null = null;
    // The anchored (click-pinned) entity, if any — while set, hover no
    // longer overrides the tooltip (see the mousemove handler below) and it
    // stops following the cursor. Cleared only by the tooltip's own close
    // (X) button or a fresh run (clearStepsUI) — a background click no
    // longer clears it (task 8: explicit X-to-close replaces that).
    let pinned: EntityRef | null = null;
    // Coincident-line chooser state (see renderChoice): open flag and the
    // overlapping entities offered.
    let choiceOpen = false;
    let choiceEnts: EntityRef[] = [];

    // "Folded view" = geometry drawn via renderFolded's occlusion pipeline
    // (any step, including step 0's flat sheet — it still goes through the
    // same table-space/occlusion machinery); the only path that does NOT is
    // renderCP, taken exactly once by applyFold below when a scene has no
    // fold/mark statements at all. currentStatements is populated only on
    // the renderFolded path, so its presence doubles as the view accessor —
    // no separate mode flag needed.
    const inFoldedView = () => currentStatements.length > 0;
    // beloch:inspect carries the FINAL fold's geometry only; the stepper renders
    // a different (partial) placement per step, so any inspect-geometry path
    // (proximity detection, ghosting hidden segments) is valid only on the last
    // step. Off it, hover falls back to the per-step DOM data-crease-id.
    const onFinalStep = () => currentStatements.length === 0 || currentStep === currentStatements.length;

    const clearHl = () => {
      canvas.querySelectorAll(".pg-hl").forEach((el) => el.classList.remove("pg-hl"));
      canvas.querySelectorAll(".pg-hl-ghost").forEach((el) => el.remove());
    };
    // Point→segment distance + tolerance, shared by proximity detection and
    // the hidden-segment test. EPS is in SVG user units (~px at 1:1 zoom).
    const EPS = 6;
    const pointSegDist = (px: number, py: number, ax: number, ay: number, bx: number, by: number): number => {
      const dx = bx - ax, dy = by - ay;
      const len2 = dx * dx + dy * dy;
      let t = len2 ? ((px - ax) * dx + (py - ay) * dy) / len2 : 0;
      t = Math.max(0, Math.min(1, t));
      return Math.hypot(px - (ax + t * dx), py - (ay + t * dy));
    };
    // A highlighted bundle's OCCLUDED segments have no rendered <line> (a fold
    // hides layers below), so they couldn't be shown. Draw each hidden segment
    // as a dashed ghost from the inspect data, in the SVG's own user space
    // (sceneLayout coords) so it pans/zooms with everything.
    const SVG_NS = "http://www.w3.org/2000/svg";
    const drawGhost = (ax: number, ay: number, bx: number, by: number) => {
      // Guard every ghost path (bundle + picked-segment) at once: inspect
      // geometry only lines up with the rendered final-fold placement.
      if (!onFinalStep()) return;
      const svg = canvas.querySelector("svg");
      if (!svg) return;
      const l = document.createElementNS(SVG_NS, "line");
      l.setAttribute("x1", String(ax));
      l.setAttribute("y1", String(ay));
      l.setAttribute("x2", String(bx));
      l.setAttribute("y2", String(by));
      l.setAttribute("class", "pg-hl-ghost");
      svg.appendChild(l);
    };
    // Ghost every segment whose midpoint isn't near an already-drawn line
    // (i.e. it's occluded / not rendered at this step).
    const ghostHidden = (segments: { table: [Vec2, Vec2] }[], drawnLines: Element[]) => {
      // inspect geometry is final-fold only; drawing it over an earlier step's
      // placement would put ghosts at the wrong positions.
      if (!currentScene || !onFinalStep()) return;
      const layout = sceneLayout(currentScene);
      const drawn = drawnLines.map((el) => [
        Number(el.getAttribute("x1")), Number(el.getAttribute("y1")),
        Number(el.getAttribute("x2")), Number(el.getAttribute("y2")),
      ] as const);
      for (const s of segments) {
        const ax = layout.tx(s.table[0][0]), ay = layout.ty(s.table[0][1]);
        const bx = layout.tx(s.table[1][0]), by = layout.ty(s.table[1][1]);
        const mx = (ax + bx) / 2, my = (ay + by) / 2;
        if (!drawn.some(([x1, y1, x2, y2]) => pointSegDist(mx, my, x1, y1, x2, y2) <= EPS)) {
          drawGhost(ax, ay, bx, by);
        }
      }
    };
    // no-clear adders (so several bundles can be lit at once for the
    // coincident-line case); the public highlight* wrap them with a clearHl.
    // Each also ghosts the bundle's occluded segments.
    const addBundleHl = (creaseId: string) => {
      const drawn = Array.from(bundleElements(canvas, creaseId));
      drawn.forEach((el) => el.classList.add("pg-hl"));
      const c = currentScene?.inspect?.creases[creaseId];
      if (c) ghostHidden(c.segments, drawn);
    };
    const addEdgeHl = (name: string) => {
      const insp = currentScene?.inspect;
      if (!insp || !currentScene) return;
      const layout = sceneLayout(currentScene);
      const drawn: Element[] = [];
      canvas.querySelectorAll(CREASE_SELECTOR).forEach((el) => {
        const x1 = Number(el.getAttribute("x1"));
        const y1 = Number(el.getAttribute("y1"));
        const x2 = Number(el.getAttribute("x2"));
        const y2 = Number(el.getAttribute("y2"));
        if (edgeOfLine(insp.edges, x1, y1, x2, y2, layout) === name) {
          el.classList.add("pg-hl");
          drawn.push(el);
        }
      });
      const e = insp.edges[name];
      if (e) ghostHidden(e.segments, drawn);
    };
    const addEntityHl = (ref: EntityRef) => {
      if (ref.kind === "crease") addBundleHl(ref.creaseId);
      else if (ref.kind === "edge") addEdgeHl(ref.name);
    };
    // Whole-bundle highlight (task 8): every segment sharing `creaseId`, across
    // flaps/layers. `--var` names ONE crease_id whose segments are the bundle.
    const highlightBundle = (creaseId: string) => { clearHl(); addBundleHl(creaseId); };
    // Same for a paper-boundary edge (task 9); boundary lines carry no
    // data-crease-id, so they're matched by geometry (edgeOfLine).
    const highlightEdgeBundle = (name: string) => { clearHl(); addEdgeHl(name); };
    // All coincident entities at once (the chooser hover/anchor).
    const highlightEntities = (ents: EntityRef[]) => { clearHl(); ents.forEach(addEntityHl); };
    // The drawing is rebuilt on every step and the highlight lives on its
    // elements, so an anchored bundle loses its classes together with the
    // old SVG. Putting them back after each swap is what keeps a clicked
    // bundle lit while the reader steps through the program. A bundle with
    // no segment at the step on screen lights nothing, which is the honest
    // answer rather than an empty promise.
    // Every place the program NAMES the anchored entities, out of
    // beloch:references: the operands of a construction, the arguments of a
    // flatten, a filter over the bundle. The emitter resolved each of those
    // mentions, so this needs no guessing at the text.
    const markRefsFor = (ents: EntityRef[]) => {
      const refs = currentScene?.references ?? [];
      setRefSpansOn(
        editor,
        refs
          .filter((r) =>
            ents.some((e) =>
              e.kind === "crease"
                ? r.creaseId !== null && String(r.creaseId) === e.creaseId
                : e.kind === "edge"
                  ? r.edge === e.name
                  : false,
            ),
          )
          .map((r) => r.span),
      );
    };
    const reapplyAnchorHl = () => {
      if (choiceOpen && choiceEnts.length) highlightEntities(choiceEnts);
      else if (pinned) highlightEntities([pinned]);
    };
    // Resolves the pointer target to an EntityRef: lookupEntity first
    // (crease/face/vertex, attr-based); if that's null AND the target is a
    // crease-layer line or its `.pg-hit` twin, fall back to geometry — this
    // is the only way to identify a paper-boundary line, which carries no
    // data-crease-id at all (task 9).
    const resolveRef = (target: Element): EntityRef | null => {
      const ref = lookupEntity(target);
      if (ref) return ref;
      if (!currentScene?.inspect) return null;
      const line = target.closest(`line[data-kind="crease"], .${HIT_CLASS}`);
      if (!line) return null;
      const x1 = Number(line.getAttribute("x1"));
      const y1 = Number(line.getAttribute("y1"));
      const x2 = Number(line.getAttribute("x2"));
      const y2 = Number(line.getAttribute("y2"));
      const layout = sceneLayout(currentScene);
      const name = edgeOfLine(currentScene.inspect.edges, x1, y1, x2, y2, layout);
      return name ? { kind: "edge", name } : null;
    };

    // Renders `ref` into the tooltip, or hides it for null/an entity the
    // current scene has no `inspect` data for (e.g. a scene evaluated
    // before beloch:inspect was emitted, or a mark tick whose crease has no
    // inspect entry). `anchored` selects the content: a crease's anchored
    // view is the segment-row list (subsumes the Task 7 stack picker);
    // everything else (hover preview, and face/vertex regardless of
    // anchoring) is the lightweight one-line summary from hoverSummary.
    // With nothing to answer, the rail says what it is for. It keeps its place
    // either way: a rail that appeared and vanished under the pointer would
    // move the step bar every time the reader crossed a crease.
    function restInspect() {
      inspectPanel!.innerHTML =
        '<div class="pg-inspect-rest">Point at a crease, or press Enter on one, to see the statement that made it.</div>';
      inspectPanel!.hidden = !currentScene;
    }

    function renderInspect(ref: EntityRef | null, anchored: boolean) {
      const insp = currentScene?.inspect;
      if (!ref || !insp) {
        restInspect();
        return;
      }
      const closeBtn = anchored ? `<button type="button" class="pg-inspect-close" aria-label="Close">×</button>` : "";
      let html: string;
      if (ref.kind === "crease" && anchored) {
        const c = insp.creases[ref.creaseId];
        if (!c) {
          restInspect();
          return;
        }
        // Named -> its name; unnamed (an unbound fold's result) -> "unnamed
        // line" plus the source line that constructed it, so the user can find
        // and bind/assign it.
        const title = c.name ? `--${c.name}` : "unnamed line";
        const srcLine = c.name ? null : lineOfSpan(c.span);
        const rows = segmentRows(insp, ref.creaseId, inFoldedView());
        html =
          closeBtn +
          `<h4>${escapeHtml(title)}</h4>` +
          `<div class="pg-inspect-sub">${srcLine ? `at line ${srcLine} · ` : ""}${rows.length} segment${rows.length === 1 ? "" : "s"}</div>` +
          // One segment = the whole bundle; no per-segment picker needed.
          (rows.length > 1
            ? rows
                .map(
                  (r, n) =>
                    `<div class="seg" data-pick-seg="${r.index}" data-pick-crease="${escapeHtml(ref.creaseId)}">` +
                    `Segment ${n + 1} · ${escapeHtml(r.assignment)}</div>`,
                )
                .join("")
            : "");
      } else if (ref.kind === "edge" && anchored) {
        // Anchored view for a paper-boundary edge bundle (task 9) — same
        // subsuming-the-stack-picker idea as the crease branch above, but
        // simpler: a boundary segment has one face (no l|r, no provenance
        // axiom/sources — it's the sheet's edge, not a fold).
        const e = insp.edges[ref.name];
        if (!e) {
          restInspect();
          return;
        }
        const rows = edgeSegmentRows(insp, ref.name);
        html =
          closeBtn +
          `<h4>${escapeHtml(`--${e.name}`)}</h4>` +
          `<div class="pg-inspect-sub">${rows.length} segment${rows.length === 1 ? "" : "s"}</div>` +
          (rows.length > 1
            ? rows
                .map(
                  (r, n) =>
                    `<div class="seg" data-pick-seg="${r.index}" data-pick-edge="${escapeHtml(ref.name)}">` +
                    `Segment ${n + 1} · ${escapeHtml(r.assignment)}</div>`,
                )
                .join("")
            : "");
      } else {
        const summary = hoverSummary(ref, insp);
        if (!summary) {
          restInspect();
          return;
        }
        html =
          closeBtn +
          `<h4>${escapeHtml(summary.title)}</h4>` +
          (summary.detail ? `<div>${escapeHtml(summary.detail)}</div>` : "");
      }
      inspectPanel!.innerHTML = html;
      inspectPanel!.hidden = false;
    }

    function closeAnchor() {
      pinned = null;
      choiceOpen = false;
      restInspect();
      clearHl();
      setRefSpansOn(editor, []);
    }

    // Distinct crease/edge entities whose line lies under a screen point.
    // Multiple lines (e.g. a construction crease and a paper edge) can project
    // onto the SAME table coords in the folded view; elementsFromPoint returns
    // every stacked element there (each crease line has a wide transparent
    // .pg-hit twin, so the hit is forgiving), and we resolve + dedupe them.
    // Faces/vertices are ignored — this is about overlapping LINES; a bare
    // face click still goes through resolveRef in the click handler.
    const entityKey = (r: EntityRef): string =>
      r.kind === "crease" ? `c:${r.creaseId}`
      : r.kind === "edge" ? `e:${r.name}`
      : r.kind === "face" ? `f:${r.index}`
      : `v:${r.index}`;
    // Map a screen (client) point into the SVG's own user space, where the
    // rendered line coords and makeLayout output live. getScreenCTM folds in
    // the canvas pan/zoom CSS transform, so inverting it is exact at any zoom.
    const svgLocalPoint = (clientX: number, clientY: number): Vec2 | null => {
      const svg = canvas.querySelector("svg");
      const ctm = svg?.getScreenCTM();
      if (!svg || !ctm) return null;
      const pt = svg.createSVGPoint();
      pt.x = clientX;
      pt.y = clientY;
      const l = pt.matrixTransform(ctm.inverse());
      return [l.x, l.y];
    };
    // Every distinct inspect entity (crease OR edge) whose segment passes
    // within EPS of the point — matched against the inspect DATA by proximity,
    // not against rendered <line>s. This surfaces COINCIDENT entities the
    // renderer collapses: when creases fold onto each other / onto a paper edge
    // they share table coords and dedupe to one <line>, and segments of
    // different lengths (a full diagonal vs. a short merged piece) still count
    // as long as the click sits on them. ≥2 ⇒ the coincident-line chooser.
    // (pointSegDist + EPS are defined with the highlight helpers above.)
    const lineEntitiesAtPoint = (clientX: number, clientY: number): EntityRef[] => {
      const insp = currentScene?.inspect;
      const local = svgLocalPoint(clientX, clientY);
      // Final-fold geometry only; off the last step, hover/click fall back to
      // the per-step DOM resolver (data-crease-id) — no proximity, no chooser.
      if (!insp || !currentScene || !local || !onFinalStep()) return [];
      const [px, py] = local;
      const layout = sceneLayout(currentScene);
      const seen = new Set<string>();
      const out: EntityRef[] = [];
      const check = (ref: EntityRef, segs: { table: [Vec2, Vec2] }[]) => {
        for (const s of segs) {
          const ax = layout.tx(s.table[0][0]), ay = layout.ty(s.table[0][1]);
          const bx = layout.tx(s.table[1][0]), by = layout.ty(s.table[1][1]);
          if (pointSegDist(px, py, ax, ay, bx, by) <= EPS) {
            const k = entityKey(ref);
            if (!seen.has(k)) { seen.add(k); out.push(ref); }
            return;
          }
        }
      };
      for (const [cid, c] of Object.entries(insp.creases)) check({ kind: "crease", creaseId: cid }, c.segments);
      for (const [name, e] of Object.entries(insp.edges)) check({ kind: "edge", name }, e.segments);
      return out;
    };

    // Anchor one entity's tooltip at (x,y): shared tail of a direct single
    // click and a chooser-row pick.
    const anchorEntity = (ref: EntityRef) => {
      pinned = ref;
      choiceOpen = false;
      markRefsFor([ref]);
      if (ref.kind === "crease") highlightBundle(ref.creaseId);
      else if (ref.kind === "edge") highlightEdgeBundle(ref.name);
      renderInspect(ref, true);
      if (ref.kind === "crease") {
        const ln = lineOfSpan(currentScene?.inspect?.creases[ref.creaseId]?.span ?? null);
        // Mark the statement that built this crease, but leave the editor
        // where the reader left it: they clicked the drawing, not the code.
        if (ln) setStepLineOn(editor, ln, { reveal: false });
      }
    };

    // The coincident-line chooser: a materialized list of the overlapping
    // entities. Clicking a row (inspectPanel listener) drills into that one via
    // anchorEntity; hovering a row previews its bundle highlight.
    // The coincident-line chooser content — shared by hover (anchored=false: a
    // live preview that follows the cursor, so hover and click show the SAME
    // "N Linien hier") and click (anchored=true: pinned, with an X and
    // clickable rows to drill into one). Hovering a row previews its bundle.
    const renderChoice = (ents: EntityRef[], anchored: boolean) => {
      const insp = currentScene?.inspect;
      if (!insp) return;
      const closeBtn = anchored
        ? `<button type="button" class="pg-inspect-close" aria-label="Close">×</button>`
        : "";
      inspectPanel!.innerHTML =
        closeBtn +
        `<h4>${ents.length} lines here</h4>` +
        ents
          .map((r, i) => {
            const t = hoverSummary(r, insp)?.title ?? entityKey(r);
            return `<div class="seg" data-choice-idx="${i}">${escapeHtml(t)}</div>`;
          })
          .join("");
      inspectPanel!.hidden = false;
      if (anchored) {
        choiceEnts = ents;
        choiceOpen = true;
      }
    };

    // The reverse direction of the click→line jump above: moving the
    // editor cursor onto a source line outlines every SVG crease segment
    // whose provenance span covers that line (read-only, no pinning).
    const highlightCreasesOnLine = (line: number) => {
      clearHl();
      const insp = currentScene?.inspect;
      if (!insp) return;
      for (const [cid, c] of Object.entries(insp.creases)) {
        if (lineOfSpan(c.span) === line) bundleElements(canvas, cid).forEach((el) => el.classList.add("pg-hl"));
      }
    };

    // Hover previews the entity under the cursor, following it with the
    // tooltip and (for a crease) the whole-bundle highlight; anchored
    // (pinned) suppresses this entirely. isDragging() (not wasDrag()) is
    // the right guard here — it reflects whether a pan is happening RIGHT
    // NOW, so hover resumes as soon as the drag actually ends rather than
    // staying suppressed until the next pointerdown (see createPanZoom).
    if (!hero) result.addEventListener("mousemove", (e: MouseEvent) => {
      if (pinned || choiceOpen || panZoom.isDragging()) return;
      // Same proximity detection as the click, so hover and click agree.
      const ents = lineEntitiesAtPoint(e.clientX, e.clientY);
      if (ents.length >= 2) {
        // Preview the chooser so hover already shows "N Linien hier" — not one
        // entity that then surprises with a chooser on click.
        highlightEntities(ents);
        renderChoice(ents, false);
        return;
      }
      const ref = ents[0] ?? resolveRef(e.target as Element);
      if (ref?.kind === "crease") highlightBundle(ref.creaseId);
      else if (ref?.kind === "edge") highlightEdgeBundle(ref.name);
      else clearHl();
      renderInspect(ref, false);
    });
    // A click anchors (materializes) the tooltip at the click position — it
    // stops following the cursor and gains a close (X) button; only that X
    // clears it now (see closeAnchor). Clicking empty paper (no entity under
    // the cursor) is a no-op rather than clearing an existing anchor — the
    // old "background click unpins" behavior is replaced by X-to-close.
    // Pan gestures must not register as a click here — wasDrag() is only
    // true after the pointer actually moved past the pan threshold during
    // this press.
    if (!hero) result.addEventListener("click", (e: MouseEvent) => {
      if (panZoom.wasDrag()) return;
      // Multiple distinct lines stacked at the click → anchor the chooser
      // (same content the hover was already previewing).
      const ents = lineEntitiesAtPoint(e.clientX, e.clientY);
      if (ents.length >= 2) {
        pinned = null;
        highlightEntities(ents);
        markRefsFor(ents);
        renderChoice(ents, true);
        return;
      }
      const ref = ents[0] ?? resolveRef(e.target as Element);
      if (!ref) return;
      anchorEntity(ref);
    });

    // Picking a segment row (anchored crease view only) highlights the SVG
    // line(s) it corresponds to by GEOMETRY, not a data-seg index (there is
    // none — dropped in Task 4). The segment's `table` endpoints are in the
    // evaluator's table space; a rendered crease `<line>`'s x1/y1/x2/y2 are
    // in SVG pixel space, produced by render-scene.ts as
    // `mx(tx(x)), ty(y)` off the layout `sceneLayout(scene)` builds
    // (see layout.ts + render-scene.ts) — `mx` only differs from `tx` for
    // `view: "bottom"`, which this Playground never passes, so plain
    // `tx`/`ty` is the exact same transform.
    // Running the segment's table endpoints through that SAME layout puts
    // both sides of the comparison in the rendered pixel space. A segment
    // fully occluded by a layer above it draws no line at all while the
    // hidden-edge control is off — zero matches then, and nothing
    // highlights, the honest outcome for a layer this top-view projection
    // can't show. With the control on, the buried run is drawn and carries
    // `data-occluded`, so it matches like any other segment.
    // Hovering OR clicking a row narrows the highlight to just that segment
    // (removing it from the rest of the bundle); a click additionally
    // stopPropagation()s so it doesn't bubble into result's click handler
    // above and re-anchor on whatever's under the tooltip (Task 7 already
    // learned this).
    //
    // Task 9: a row now comes from either a crease bundle (`data-pick-crease`
    // — re-identify candidate lines by `[data-crease-id]`, via
    // bundleElements) or a paper-boundary edge bundle (`data-pick-edge` — no
    // id to select by, so every crease-layer line is a candidate, narrowed
    // by geometry same as the single-segment match below).
    const pickSegment = (row: HTMLElement) => {
      const cid = row.dataset.pickCrease;
      const eid = row.dataset.pickEdge;
      const segIndex = Number(row.dataset.pickSeg);
      const s = cid
        ? currentScene?.inspect?.creases[cid]?.segments[segIndex]
        : eid
          ? currentScene?.inspect?.edges[eid]?.segments[segIndex]
          : undefined;
      if (!currentScene || !s || (!cid && !eid)) return;
      const layout = sceneLayout(currentScene);
      const p0: Vec2 = [layout.tx(s.table[0][0]), layout.ty(s.table[0][1])];
      const p1: Vec2 = [layout.tx(s.table[1][0]), layout.ty(s.table[1][1])];
      clearHl();
      const candidates = cid ? bundleElements(canvas, cid) : Array.from(canvas.querySelectorAll(CREASE_SELECTOR));
      let matched = false;
      candidates.forEach((el) => {
        const x1 = Number(el.getAttribute("x1"));
        const y1 = Number(el.getAttribute("y1"));
        const x2 = Number(el.getAttribute("x2"));
        const y2 = Number(el.getAttribute("y2"));
        if (segMatchesLine(p0, p1, x1, y1, x2, y2)) {
          el.classList.add("pg-hl");
          matched = true;
        }
      });
      // Picked an occluded segment (no rendered line) → ghost it so it shows.
      if (!matched) drawGhost(p0[0], p0[1], p1[0], p1[1]);
    };
    inspectPanel.addEventListener("click", (e: MouseEvent) => {
      const target = e.target as Element;
      if (target.closest(".pg-inspect-close")) {
        e.stopPropagation();
        closeAnchor();
        return;
      }
      // Chooser row → drill into that overlapping entity, at the chooser's spot.
      const choice = target.closest<HTMLElement>("[data-choice-idx]");
      if (choice) {
        e.stopPropagation();
        const ref = choiceEnts[Number(choice.dataset.choiceIdx)];
        if (ref) anchorEntity(ref);
        return;
      }
      const row = target.closest<HTMLElement>("[data-pick-seg]");
      if (!row) return;
      e.stopPropagation();
      pickSegment(row);
    });
    inspectPanel.addEventListener("mouseover", (e: MouseEvent) => {
      const target = e.target as Element;
      const row = target.closest<HTMLElement>("[data-pick-seg]");
      if (row) {
        pickSegment(row);
        return;
      }
      // Previewing a chooser row highlights that entity's whole bundle.
      const choice = target.closest<HTMLElement>("[data-choice-idx]");
      if (choice) {
        const ref = choiceEnts[Number(choice.dataset.choiceIdx)];
        if (!ref) return;
        clearHl();
        if (ref.kind === "crease") highlightBundle(ref.creaseId);
        else if (ref.kind === "edge") highlightEdgeBundle(ref.name);
      }
    });

    // Prev/next just walk the clamped index; renderStep re-clamps and keeps
    // the nav buttons' disabled state in sync (see updateStepsUI).
    stepPrev.addEventListener("click", () => renderStep(currentStep - 1, true, true));
    stepNext.addEventListener("click", () => renderStep(currentStep + 1, true, true));

    // A diagnostic goes beside the drawing, never in its place: the last valid
    // drawing is what the reader is holding the message against, and wiping it
    // takes that away at the moment it is needed (B3.5). The line the
    // evaluator named is marked in the editor at the same time.
    //
    // The alert region is written before it is shown, and hidden before it is
    // emptied. A screen reader announces whatever lands in a live region, so
    // emptying a visible one reads the clearing out as a message of its own.
    const showDiagnostic = (message: string, where: string, line: number | null) => {
      errorBox!.innerHTML = `<span class="pg-error-where">${escapeHtml(where)}</span>${escapeHtml(message)}`;
      errorBox!.hidden = false;
      setErrorLineOn(editor, line);
    };
    const clearDiagnostic = () => {
      errorBox!.hidden = true;
      errorBox!.textContent = "";
      setErrorLineOn(editor, null);
    };
    const showInfo = (message: string) => showDiagnostic(message, "note", null);
    const showError = (message: string, line: number | null = null) =>
      showDiagnostic(message, line === null ? "error" : `line ${line}`, line);
    // keepView leaves the current pan/zoom transform in place — the canvas
    // element (the transform target) survives innerHTML swaps, so stepping
    // through the timeline keeps the user's framing. A fresh run passes
    // keepView=false to re-fit the newly-parsed paper.
    const showSvg = (svg: string, keepView = false, fade: FadeLength | null = null) => {
      swapDrawing(canvas, svg, fade);
      // The outgoing state is inert, so only the step that is current gets hit
      // areas; `querySelector` finds it because the fading layer sits after it.
      // Bigger click/hover target per crease line and per point dot; the
      // drawn line and dot stay as thin as the notation wants them.
      const live = canvas.querySelector("svg") ?? canvas;
      enhanceCreaseHits(live);
      enhancePointHits(live);
      makeCreasesReachable();
      reapplyAnchorHl();
      // A drawing on the stage means the rail has something to stand for. A
      // pinned answer survives a step change, which is what the rail is for.
      if (!hero && !pinned && !choiceOpen) restInspect();
      if (!keepView) panZoom.reset();
      panZoom.setEnabled(true);
      resetBtn.hidden = false;
    };

    // Rebuilds the scrubber's dots for a freshly-parsed set of statements
    // (called once per successful run, not per statement-click). The timeline
    // has n+1 stops: index 0 is the flat starting sheet, 1..n each statement.
    // Hidden when there's nothing to navigate (no statements at all).
    function buildStepsUI(statements: Statement[]) {
      const n = statements.length;
      stepDots!.innerHTML = "";
      if (n < 1) {
        stepsBar!.hidden = true;
        return;
      }
      stepsBar!.hidden = false;
      for (let i = 0; i <= n; i++) {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "pg-step-dot";
        dot.setAttribute("aria-label", i === 0 ? "Starting paper" : `Step ${i} of ${n}`);
        dot.setAttribute("aria-current", "false");
        dot.addEventListener("click", () => renderStep(i, true, true));
        stepDots!.appendChild(dot);
      }
    }

    // Clears the scrubber + gutter marker so a stale scene from a previous
    // multi-step run can't linger (and stay clickable) once a later run
    // doesn't produce a fresh multi-step scene of its own.
    function clearStepsUI() {
      currentScene = null;
      currentStatements = [];
      pinned = null;
      choiceOpen = false;
      inspectPanel!.hidden = true;
      inspectPanel!.textContent = "";
      clearHl();
      setRefSpansOn(editor, []);
      stepsBar!.hidden = true;
      setStepLineOn(editor, null);
    }

    // Cheap per-step-change update: toggles the active dot + label text,
    // without touching event listeners (buildStepsUI owns those).
    function updateStepsUI(i: number, statements: Statement[]) {
      const n = statements.length;
      stepDots!.querySelectorAll<HTMLButtonElement>(".pg-step-dot").forEach((dot, idx) => {
        dot.classList.toggle("is-active", idx === i);
        dot.classList.toggle("is-past", idx < i);
        dot.setAttribute("aria-current", idx === i ? "true" : "false");
      });
      stepDots!.style.setProperty("--pg-progress", n > 0 ? `${(i / n) * 100}%` : "0%");
      if (i === 0) {
        stepLabel!.textContent = `Step 0/${n} · empty paper`;
      } else {
        stepLabel!.textContent = `Step ${i}/${n}`;
      }
      stepPrev!.disabled = i <= 0;
      stepNext!.disabled = i >= n;
    }

    // Client-side-only re-render of one statement of the already-parsed
    // scene — no worker round-trip, since one eval already returned every
    // frame and every statement's own mark geometry. A fold-kind statement
    // just re-renders its backdrop frame; a mark-kind statement re-renders
    // the SAME backdrop (marks don't fold anything) with its own mark
    // overlaid.
    // `animate` is what the reader's click carries in: a step reached by
    // clicking crossfades from the step it left, a step rendered because a run
    // just finished appears outright.
    // One step of the current scene as SVG, under whichever theme is asked
    // for. The stage asks with the web theme, whose colours are variables the
    // page resolves; the export asks with literals (see literalTheme).
    function svgForStep(i: number, theme: Partial<Theme>, view: View = currentView): string {
      if (!currentScene) return "";
      // A scene with no statements has no timeline: its one drawing is the
      // crease pattern, whichever tab is up.
      if (currentStatements.length === 0) return renderCP(currentScene, { theme }).toString();
      // Step 0 is the flat starting sheet, before any fold or mark — so it
      // shows no statement's creases (index -1) and no marks.
      const stmt = i === 0 ? null : currentStatements[i - 1]!;
      const activeMarks = stmt ? stmt.keptMarks : [];
      const newestCreaseId = activeMarks.at(-1)?.creaseId;
      if (view === "cp") {
        // The flat sheet carrying the creases scored up to this statement,
        // plus the marks still dangling at it — so a scored line first shows
        // as a mark and turns into a crease at the statement that folds it.
        return renderScene(currentScene, {
          theme,
          isometry: { kind: "flat" },
          texture: {
            upToStatement: i - 1,
            creases: true,
            marks: true,
            points: true,
            lines: true,
            faces: "outline",
          },
          markOverlay: { marks: activeMarks, newestCreaseId },
        }).toString();
      }
      if (!stmt) {
        return renderFolded(currentScene, { theme, step: "0", hidden: hiddenMode }).toString();
      }
      return renderFolded(currentScene, {
        theme,
        step: String(stmt.frameIndex),
        hidden: hiddenMode,
        markOverlay: activeMarks.length > 0 ? { marks: activeMarks, newestCreaseId } : undefined,
      }).toString();
    }

    // `fadeOverride` is for a swap that is not a step change at all: switching
    // the tab, or the line style, shows the same state drawn differently.
    function renderStep(i: number, keepView = true, animate = false, fadeOverride: FadeLength | null = null) {
      if (!currentScene || currentStatements.length === 0) return;
      const n = currentStatements.length;
      const clamped = Math.max(0, Math.min(i, n));
      currentStep = clamped;
      try {
        const svg = svgForStep(clamped, renderTheme());
        if (clamped === 0) {
          showSvg(svg, keepView, fadeOverride ?? (animate ? "view" : null));
          setStepLineOn(editor, null);
        } else {
          const stmt = currentStatements[clamped - 1]!;
          // A mark folds nothing, so it changes the view rather than the paper.
          // A crease pattern never folds either: the sheet stays flat and gains
          // a line.
          const stepFade: FadeLength =
            currentView === "cp" || stmt.kind !== "fold" ? "view" : "fold";
          showSvg(svg, keepView, fadeOverride ?? (animate ? stepFade : null));
          setStepLineOn(editor, stmt.sourceLine);
        }
      } catch (err) {
        showError(`Render error: ${err instanceof Error ? err.message : String(err)}`);
        return;
      }
      updateStepsUI(clamped, currentStatements);
      updateExportPanel();
    }

    function clearTimers() {
      if (loadTimer !== null) clearTimeout(loadTimer);
      if (evalTimer !== null) clearTimeout(evalTimer);
      loadTimer = null;
      evalTimer = null;
    }

    function finish(handler: () => void) {
      clearTimers();
      pendingCode = null;
      dispatchedCode = null;
      running = false;
      runBtn!.classList.remove("is-loading");
      updateRunButtonState();
      handler();
    }

    // Parses+renders an already-computed FOLD document (from the eval Worker,
    // or a build-time seed) — pure @beloch/scene + @beloch/render-svg, no
    // wasm involved. Shared by the worker-response path and the seed-fold
    // bootstrap below, so both build the scrubber the same way.
    function applyFold(fold: unknown) {
      try {
        const scene = parseFold(fold as object);
        if (scene.statements.length > 0) {
          currentScene = scene;
          currentStatements = scene.statements;
          buildStepsUI(scene.statements);
          const target = pendingSharedStep;
          pendingSharedStep = null;
          renderStep(target ?? scene.statements.length, false);
        } else {
          showSvg(renderCP(scene, { theme: renderTheme() }).toString());
        }
      } catch (err) {
        showError(`Render error: ${err instanceof Error ? err.message : String(err)}`);
      }
    }

    function renderResult(raw: string) {
      clearStepsUI();
      let parsed: { ok: boolean; fold?: unknown; kind?: string; message?: string; line?: number };
      try {
        parsed = JSON.parse(raw);
      } catch (err) {
        showError(`Invalid response from the evaluator: ${String(err)}`);
        return;
      }
      if (parsed.ok) {
        applyFold(parsed.fold);
        return;
      }
      if (parsed.kind === "native") {
        showInfo(
          "This expression needs native evaluation (an irrational number via √/∛ beyond the browser fragment).",
        );
        return;
      }
      showError(parsed.message ?? "Unknown error.", parsed.line ?? null);
    }

    function wireWorker() {
      worker!.onmessage = (e: MessageEvent<{ raw?: string; ready?: boolean; loaded?: number; total?: number }>) => {
        // Transfer progress, while the runtime is still on its way.
        if (e.data.total !== undefined && e.data.loaded !== undefined) {
          loadProgress = e.data.total > 0 ? e.data.loaded / e.data.total : null;
          updateRunButtonState();
          return;
        }
        // The worker announces its instantiated wasm runtime (eval-worker.js).
        // Until that arrives, a pending run is waiting on the network, so the
        // short evaluation limit must not be running yet.
        if (e.data.ready) {
          phase = "ready";
          loadStalled = false;
          loadProgress = null;
          clearTimers();
          const queued = pendingCode;
          pendingCode = null;
          if (queued !== null) startEval(queued);
          else updateRunButtonState();
          return;
        }
        // Only an answered request updates the baseline for "same code as
        // the last run". A timeout or worker error leaves it where it was,
        // so a retry is not announced as a repeat.
        lastRunCode = dispatchedCode;
        const raw = e.data.raw ?? "";
        finish(() => renderResult(raw));
      };
      worker!.onerror = (e: ErrorEvent) => {
        finish(() => showError(`Worker error: ${e.message}`));
      };
    }

    function spawnWorker() {
      worker = new Worker("/beloch/eval-worker.js");
      phase = "loading";
      wireWorker();
    }

    // Creates the Worker (and triggers its wasm download) on first use. A
    // no-op once `worker` exists — the eager path creates it once on mount,
    // the lazy path only once the user actually clicks Run.
    function bootIfNeeded() {
      if (worker) return;
      spawnWorker();
    }

    // Hands one source string to a ready worker, under the evaluation limit.
    function startEval(code: string) {
      dispatchedCode = code;
      evalTimer = setTimeout(() => {
        evalTimer = null;
        // A hung evaluation needs a fresh worker; it re-reads the runtime
        // from the HTTP cache. A slow *load* never reaches this path.
        worker!.terminate();
        spawnWorker();
        dispatchedCode = null;
        running = false;
        repeat = false;
        runBtn!.classList.remove("is-loading");
        updateRunButtonState();
        showError("Evaluation aborted (timeout).");
      }, EVAL_TIMEOUT_MS);
      updateRunButtonState();
      worker!.postMessage(code);
    }

    function run() {
      if (running) return; // guard against overlapping runs
      // The standing diagnostic describes the previous run; this one answers
      // for itself. The drawing stays either way.
      clearDiagnostic();
      const codeToRun = editor.state.doc.toString();
      repeat = lastRunCode !== null && codeToRun === lastRunCode;
      loadStalled = false;
      running = true;
      runBtn!.classList.add("is-loading");
      bootIfNeeded();
      if (phase === "ready") {
        startEval(codeToRun);
        return;
      }

      // Still booting: the run waits for the ready signal under the generous
      // load limit. On expiry the worker keeps its download running (it is
      // never terminated here), so pressing Run again picks the transfer up
      // where it stands; the status line says as much.
      pendingCode = codeToRun;
      loadTimer = setTimeout(() => {
        loadTimer = null;
        pendingCode = null;
        running = false;
        repeat = false;
        loadStalled = true;
        runBtn!.classList.remove("is-loading");
        updateRunButtonState();
      }, LOAD_TIMEOUT_MS);
      updateRunButtonState();
    }

    // If a seed FOLD was embedded at build time, parse+render it right away
    // — no wasm, no Run click, works even while the eval Worker hasn't
    // (and for `lazy` instances, won't yet) booted. Wraps the pre-rendered
    // SSR `seed` SVG with a live scene, so scrubbing works immediately.
    const seedFoldTag = root.querySelector<HTMLScriptElement>("script.pg-seed-fold");
    const seedFoldRaw = seedFoldTag?.textContent?.trim() ?? "";
    if (seedFoldRaw) {
      try {
        applyFold(JSON.parse(seedFoldRaw));
      } catch {
        // Build-time-trusted JSON; a parse failure here is a build bug, not
        // a user error — leave the SSR seed SVG showing rather than error.
      }
    }

    // ── Export ───────────────────────────────────────────────────────────
    // What leaves the page is what the render path produces, re-rendered from
    // the scene rather than lifted out of the DOM: the stage's copy carries
    // hit lines, highlight classes and colours that are CSS variables, none of
    // which mean anything in a file (B3.10). The trigger sits in the quiet
    // zone beside the reset button, so nothing is laid over the drawing while
    // the panel is shut (B3.11).
    function updateExportPanel() {
      if (!exportStepLine) return;
      const n = currentStatements.length;
      exportStepLine.textContent = n > 0 ? `step ${currentStep} of ${n}` : "crease pattern";
    }

    const say = (text: string) => {
      if (exportSaid) exportSaid.textContent = text;
    };

    const setExportOpen = (open: boolean) => {
      exportPanel!.hidden = !open;
      exportToggle!.setAttribute("aria-expanded", String(open));
      if (open) {
        updateExportPanel();
        say("");
      }
    };

    exportToggle.addEventListener("click", () => setExportOpen(exportPanel!.hidden));
    // Clicking away shuts the panel; it covers paper only while it is in use.
    document.addEventListener("click", (e: MouseEvent) => {
      const t = e.target as Node;
      if (exportPanel!.hidden) return;
      if (exportPanel!.contains(t) || exportToggle!.contains(t)) return;
      setExportOpen(false);
    });
    exportPanel.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key !== "Escape") return;
      setExportOpen(false);
      exportToggle!.focus();
    });

    // base64url of the UTF-8 bytes, so a program with umlauts or a long line
    // survives the trip through a URL. Built a chunk at a time because
    // String.fromCharCode(...bytes) overflows the argument list on a long one.
    function encodeProgram(src: string): string {
      const bytes = new TextEncoder().encode(src);
      let binary = "";
      for (let i = 0; i < bytes.length; i += 0x8000) {
        binary += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
      }
      return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
    }
    function decodeProgram(param: string): string | null {
      try {
        const b64 = param.replace(/-/g, "+").replace(/_/g, "/");
        const binary = atob(b64);
        const bytes = new Uint8Array(binary.length);
        for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
        return new TextDecoder().decode(bytes);
      } catch {
        return null;
      }
    }

    const shareLink = () => {
      const url = new URL(window.location.href);
      url.searchParams.set("p", encodeProgram(editor.state.doc.toString()));
      url.searchParams.set("s", String(currentStep));
      return url.toString();
    };

    const copyText = async (text: string, said: string) => {
      try {
        await navigator.clipboard.writeText(text);
        say(said);
      } catch {
        say("the browser refused the clipboard");
      }
    };

    exportPanel.addEventListener("click", (e: MouseEvent) => {
      const b = (e.target as Element).closest<HTMLButtonElement>("[data-export]");
      if (!b) return;
      const what = b.dataset.export;
      if (what === "link") {
        void copyText(shareLink(), "link copied");
        return;
      }
      if (!currentScene) {
        say("nothing drawn yet");
        return;
      }
      let svg: string;
      try {
        svg = svgForStep(currentStep, literalTheme());
      } catch (err) {
        say(`render failed: ${err instanceof Error ? err.message : String(err)}`);
        return;
      }
      if (what === "copy") {
        void copyText(svg, "SVG copied");
        return;
      }
      const url = URL.createObjectURL(new Blob([svg], { type: "image/svg+xml" }));
      const a = document.createElement("a");
      a.href = url;
      a.download = currentStatements.length > 0 ? `beloch-step-${currentStep}.svg` : "beloch.svg";
      a.click();
      URL.revokeObjectURL(url);
      say("SVG downloaded");
    });

    // ── Keyboard ─────────────────────────────────────────────────────────
    // Everything the drawing can do is reachable without a pointer (B7). The
    // stage is one tab stop: the horizontal arrows walk the steps, + and −
    // zoom, 0 puts the view back. A crease is reached through its hit line,
    // and the vertical arrows move from one crease to the next, so a drawing
    // with twenty creases does not put twenty tab stops between this card and
    // the rest of the page.
    if (!hero) result.tabIndex = 0;
    result.addEventListener("keydown", (e: KeyboardEvent) => {
      // A control inside the stage keeps its own keys.
      if (e.target !== result) return;
      switch (e.key) {
        case "ArrowRight":
          renderStep(currentStep + 1, true, true);
          break;
        case "ArrowLeft":
          renderStep(currentStep - 1, true, true);
          break;
        case "+":
        case "=":
          panZoom.zoomBy(1.15);
          break;
        case "-":
          panZoom.zoomBy(1 / 1.15);
          break;
        case "0":
          panZoom.reset();
          break;
        default:
          return;
      }
      e.preventDefault();
    });

    // Every hit target on the stage: the fat twins over crease lines and the
    // discs over point dots, in document order.
    function hitLines(): SVGElement[] {
      return Array.from(canvas!.querySelectorAll<SVGElement>(`.${HIT_CLASS}`));
    }

    // Called after every drawing swap, because the hit targets are rebuilt
    // with the SVG. One of them holds the tab stop; the rest are reachable
    // from it.
    function makeCreasesReachable() {
      if (hero) return;
      const insp = currentScene?.inspect;
      hitLines().forEach((el, i) => {
        el.setAttribute("tabindex", i === 0 ? "0" : "-1");
        el.setAttribute("role", "button");
        const ref = resolveRef(el);
        const title = ref && insp ? hoverSummary(ref, insp)?.title : null;
        // A paper edge carries no inspect entry to take a name from, so it is
        // named for what it is rather than as a crease. Same for a point dot,
        // whose twin is reachable too.
        const fallback =
          ref?.kind === "edge" ? "Paper edge"
            : ref?.kind === "vertex" ? "Point"
              : "Crease line";
        el.setAttribute("aria-label", title ?? fallback);
      });
    }

    canvas.addEventListener("keydown", (e: KeyboardEvent) => {
      const el = e.target as Element;
      if (hero || !el.classList?.contains(HIT_CLASS)) return;
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        const lines = hitLines();
        const i = lines.indexOf(el as SVGElement);
        const next = lines[(i + (e.key === "ArrowDown" ? 1 : lines.length - 1)) % lines.length];
        if (!next) return;
        lines.forEach((l) => l.setAttribute("tabindex", "-1"));
        next.setAttribute("tabindex", "0");
        next.focus();
        e.preventDefault();
        return;
      }
      if (e.key === "Enter" || e.key === " ") {
        const ref = resolveRef(el);
        if (ref) anchorEntity(ref);
        e.preventDefault();
        return;
      }
      if (e.key === "Escape") {
        closeAnchor();
        result!.focus();
        e.preventDefault();
      }
    });

    runBtn.addEventListener("click", run);

    // A shared link carries the program in `?p=` and the step it was shared at
    // in `?s=`. That link is the reason the visitor opened the page, so it
    // loads and runs on arrival even on an instance that otherwise waits for a
    // click, and the step is taken once the run has produced one.
    const sharedParams = new URLSearchParams(window.location.search);
    const sharedRaw = sharedParams.get("p");
    const sharedProgram = sharedRaw === null ? null : decodeProgram(sharedRaw);
    if (sharedProgram !== null) {
      const step = Number(sharedParams.get("s"));
      pendingSharedStep = Number.isInteger(step) && step >= 0 ? step : null;
      editor.dispatch({ changes: { from: 0, to: editor.state.doc.length, insert: sharedProgram } });
      bootIfNeeded();
      run();
      return;
    }

    if (!lazy) {
      bootIfNeeded();
      if (initialCode.trim()) run();
    }
  }

  document
    .querySelectorAll<HTMLElement>(".beloch-playground")
    .forEach((root) => {
      void setup(root).catch((err) => console.error("playground: setup failed", err));
    });
</script>
