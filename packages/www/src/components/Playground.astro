---
// Live Beloch playground: CodeMirror 6 editor -> Web Worker (eval-worker.js,
// running the committed js_of_ocaml bundle) -> @beloch/scene + @beloch/render-svg
// -> injected SVG. No framework island — a plain client <script type="module">
// wires every `.beloch-playground` instance on the page (Astro dedupes and
// hoists this script once even if the component is used multiple times, so
// the wiring must be instance-scoped via querySelectorAll, not a singleton).
//
// Beloch-aware syntax highlighting (tree-sitter, via ../lib/highlight-bel.ts)
// is a build-time-only pipeline today (see Beloch.astro) — a live CM6
// language/highlight extension for .bel is not wired up yet, so the editor
// runs with CM6's basicSetup only (no Beloch token coloring).
interface Props {
  code?: string;
  height?: number;
  // Build-time-rendered SVG markup shown in `.pg-result` before any live
  // evaluation has run (e.g. a static hero fold rendered via evalBelToFold,
  // the same build-time path `<Beloch>` uses). Optional — default behavior
  // (the "Run drücken" notice) is unchanged when absent.
  seed?: string;
  // When true, defer creating the eval Worker (and the 5.7 MB wasm module it
  // pulls) until the user actually clicks Run, instead of on mount. Optional
  // — default is today's eager boot.
  lazy?: boolean;
}
const { code = "", height = 320, seed, lazy = false } = Astro.props;
---

<div
  class="beloch-playground"
  style={`--pg-height:${height}px`}
  data-lazy={lazy ? "true" : "false"}
>
  <div class="pg-pane pg-editor">
    <div class="pg-source"><template class="pg-source-seed">{code}</template></div>
  </div>
  <div class="pg-pane pg-output">
    <div class="pg-toolbar pg-toolbar-output">
      <div class="pg-swatches" role="group" aria-label="Paper"></div>
    </div>
    <div class="pg-result">
      {seed ? <Fragment set:html={seed} /> : <p class="pg-notice pg-notice-info">„Run“ drücken, um auszuwerten.</p>}
    </div>
  </div>
  <button type="button" class="pg-run" aria-label="Run" title="Run">
    <svg class="pg-run-play" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
      <path d="M3 2 L13 8 L3 14 Z" fill="currentColor" />
    </svg>
    <span class="pg-run-spinner" aria-hidden="true"></span>
  </button>
  <div class="pg-run-hint" role="status" aria-live="polite"></div>
</div>

<style>
  .beloch-playground {
    display: grid;
    grid-template-columns: 1fr 1fr;
    position: relative;
    margin: 1.5rem 0;
    border: 1px solid var(--beloch-border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--beloch-panel);
  }
  @media (max-width: 720px) {
    .beloch-playground { grid-template-columns: 1fr; }
  }

  .pg-pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .pg-editor {
    background: var(--beloch-code-bg);
    border-right: 1px solid var(--beloch-border);
  }
  @media (max-width: 720px) {
    .pg-editor { border-right: none; border-bottom: 1px solid var(--beloch-border); }
  }

  .pg-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 16px;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 12px;
  }
  .pg-output .pg-toolbar {
    color: var(--beloch-muted);
    border-bottom: 1px solid var(--beloch-border);
  }
  .pg-toolbar-output {
    justify-content: flex-end;
  }

  .pg-run {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--beloch-valley);
    background: var(--beloch-panel);
    color: var(--beloch-valley);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .pg-run:hover:not(:disabled) {
    background: var(--beloch-valley);
    color: #fff;
  }
  .pg-run:disabled {
    cursor: default;
    border-color: var(--beloch-border);
    color: var(--beloch-muted);
  }
  .pg-run-spinner {
    display: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid currentColor;
    border-top-color: transparent;
    animation: pg-spin 0.7s linear infinite;
  }
  .pg-run.is-loading .pg-run-play { display: none; }
  .pg-run.is-loading .pg-run-spinner { display: block; }
  @keyframes pg-spin {
    to { transform: rotate(360deg); }
  }

  .pg-run-hint {
    position: absolute;
    left: 50%;
    top: calc(50% + 36px);
    transform: translateX(-50%);
    z-index: 2;
    max-width: calc(100% - 24px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 11px;
    color: var(--beloch-muted);
    background: var(--beloch-panel);
    border: 1px solid var(--beloch-border);
    border-radius: 999px;
    padding: 3px 10px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }
  .pg-run-hint.is-visible {
    opacity: 1;
  }

  .pg-source {
    flex: 1;
    min-height: var(--pg-height, 320px);
    resize: vertical;
    overflow: hidden;
    background: transparent;
  }
  .pg-source :global(.cm-editor) {
    height: 100%;
  }
  .pg-source :global(.cm-scroller) {
    overflow: auto;
  }

  .pg-output {
    background: var(--beloch-panel);
  }
  .pg-result {
    flex: 1;
    min-height: var(--pg-height, 320px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px;
    overflow: auto;
  }
  .pg-result :global(svg) {
    max-width: 100%;
    height: auto;
  }

  .pg-notice {
    margin: 0;
    max-width: 32ch;
    text-align: center;
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    font-size: 13.5px;
    line-height: 1.5;
  }
  .pg-notice-info { color: var(--beloch-muted); }
  .pg-notice-error { color: var(--beloch-mountain); }

  .pg-swatches { display: inline-flex; gap: 8px; }
  .pg-swatch {
    width: 22px; height: 22px; padding: 0;
    border-radius: 50%;
    border: 1px solid var(--beloch-border);
    cursor: pointer;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }
  .pg-swatch.is-active {
    outline: 2px solid var(--beloch-valley);
    outline-offset: 1px;
  }
</style>

<script>
  import { EditorView, basicSetup } from "codemirror";
  import { EditorState } from "@codemirror/state";
  import { keymap } from "@codemirror/view";
  import { parseFold } from "@beloch/scene";
  import { renderCP, renderFolded, WEB_THEME } from "@beloch/render-svg";
  import { SCHEMES, STORAGE_KEY, DEFAULT_ID, applyScheme, resolveScheme } from "../lib/paper-schemes";

  const TIMEOUT_MS = 8000;

  const editorTheme = EditorView.theme(
    {
      "&": {
        color: "#C9D2DE",
        backgroundColor: "transparent",
        height: "100%",
      },
      ".cm-scroller": {
        fontFamily: "'IBM Plex Mono', ui-monospace, monospace",
        fontSize: "13.5px",
        lineHeight: "22px",
      },
      ".cm-content": { padding: "14px 18px", caretColor: "#C9D2DE" },
      ".cm-gutters": {
        backgroundColor: "transparent",
        color: "#55627A",
        border: "none",
        borderRight: "1px solid rgba(255, 255, 255, 0.08)",
      },
      ".cm-activeLine": { backgroundColor: "rgba(255, 255, 255, 0.04)" },
      ".cm-activeLineGutter": { backgroundColor: "rgba(255, 255, 255, 0.04)" },
      "&.cm-focused": { outline: "none" },
    },
    { dark: true },
  );

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");
  }

  function setup(root: HTMLElement) {
    const sourceMount = root.querySelector<HTMLDivElement>(".pg-source");
    const runBtn = root.querySelector<HTMLButtonElement>(".pg-run");
    const result = root.querySelector<HTMLDivElement>(".pg-result");
    const runHint = root.querySelector<HTMLDivElement>(".pg-run-hint");
    if (!sourceMount || !runBtn || !result || !runHint) return;

    function setRunHint(text: string) {
      runHint!.textContent = text;
      runHint!.classList.toggle("is-visible", text !== "");
    }

    const seed = sourceMount.querySelector<HTMLTemplateElement>(".pg-source-seed");
    const initialCode = seed?.content.textContent ?? "";
    sourceMount.textContent = "";

    // Lazy instances defer the eval Worker (see bootIfNeeded below) until the
    // user actually clicks Run — focusing or editing the code must not, on
    // its own, kick off a run or pull in the wasm module.
    const lazy = root.dataset.lazy === "true";

    // Run is only meaningful once the doc differs from whatever was last
    // sent to the worker (or the initial/seeded code, before any run).
    let running = false;
    let lastRunCode = initialCode;
    function updateRunButtonState() {
      const dirty = editor.state.doc.toString() !== lastRunCode;
      runBtn.disabled = running || !dirty;
      runBtn.title = running
        ? "wertet aus …"
        : dirty
          ? "Run"
          : "Code ändern, um erneut auszuführen";
    }

    const editor = new EditorView({
      state: EditorState.create({
        doc: initialCode,
        extensions: [
          basicSetup,
          keymap.of([
            {
              key: "Mod-Enter",
              run: () => {
                runBtn.click();
                return true;
              },
            },
          ]),
          editorTheme,
          EditorView.updateListener.of((update) => {
            if (update.docChanged) updateRunButtonState();
          }),
        ],
      }),
      parent: sourceMount,
    });
    updateRunButtonState();

    // Exposed so pages embedding this playground (e.g. the landing page's
    // example chips) can load a sample without reaching into CM6 internals.
    (root as unknown as { belochSetCode: (code: string) => void }).belochSetCode = (code) => {
      editor.dispatch({ changes: { from: 0, to: editor.state.doc.length, insert: code } });
    };

    const swatchBar = root.querySelector<HTMLDivElement>(".pg-swatches");
    if (swatchBar) {
      let activeId: string;
      try {
        activeId = resolveScheme(localStorage.getItem(STORAGE_KEY)).id;
      } catch {
        activeId = DEFAULT_ID;
      }
      const buttons = SCHEMES.map((s) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "pg-swatch";
        b.style.background = s.swatch;
        b.title = s.label;
        b.setAttribute("aria-label", s.label);
        b.setAttribute("aria-pressed", String(s.id === activeId));
        b.dataset.schemeId = s.id;
        if (s.id === activeId) b.classList.add("is-active");
        b.addEventListener("click", () => {
          applyScheme(s.id);
          swatchBar.querySelectorAll(".pg-swatch").forEach((el) => {
            el.classList.toggle("is-active", el === b);
            el.setAttribute("aria-pressed", String(el === b));
          });
        });
        return b;
      });
      swatchBar.append(...buttons);
    }

    let worker: Worker | null = null;
    let timer: ReturnType<typeof setTimeout> | null = null;

    const showInfo = (message: string) => {
      result.innerHTML = `<p class="pg-notice pg-notice-info">${escapeHtml(message)}</p>`;
    };
    const showError = (message: string) => {
      result.innerHTML = `<p class="pg-notice pg-notice-error">${escapeHtml(message)}</p>`;
    };
    const showSvg = (svg: string) => {
      result.innerHTML = svg;
    };

    function finish(handler: () => void) {
      if (timer !== null) clearTimeout(timer);
      timer = null;
      running = false;
      runBtn!.classList.remove("is-loading");
      updateRunButtonState();
      setRunHint("");
      handler();
    }

    function renderResult(raw: string) {
      let parsed: { ok: boolean; fold?: unknown; kind?: string; message?: string };
      try {
        parsed = JSON.parse(raw);
      } catch (err) {
        showError(`Ungültige Antwort vom Auswerter: ${String(err)}`);
        return;
      }
      if (parsed.ok) {
        try {
          const scene = parseFold(parsed.fold as object);
          const doc = scene.steps.length > 0
            ? renderFolded(scene, { theme: WEB_THEME })
            : renderCP(scene, { theme: WEB_THEME });
          showSvg(doc.toString());
        } catch (err) {
          showError(`Render-Fehler: ${err instanceof Error ? err.message : String(err)}`);
        }
        return;
      }
      if (parsed.kind === "native") {
        showInfo(
          "Dieser Ausdruck braucht die native Auswertung (irrationale Zahl über √/∛ jenseits des Browser-Fragments).",
        );
        return;
      }
      showError(parsed.message ?? "Unbekannter Fehler.");
    }

    function wireWorker() {
      worker!.onmessage = (e: MessageEvent<{ raw: string }>) => {
        finish(() => renderResult(e.data.raw));
      };
      worker!.onerror = (e: ErrorEvent) => {
        finish(() => showError(`Worker-Fehler: ${e.message}`));
      };
    }

    // Creates the Worker (and triggers its wasm download) on first use. A
    // no-op once `worker` exists — the eager path creates it once on mount,
    // the lazy path only once the user actually clicks Run.
    function bootIfNeeded() {
      if (worker) return;
      worker = new Worker("/beloch/eval-worker.js");
      wireWorker();
    }

    function run() {
      if (timer !== null) return; // guard against overlapping runs
      const cold = !worker; // no Worker yet -> this run also pays for the wasm boot
      bootIfNeeded();
      const codeToRun = editor.state.doc.toString();
      lastRunCode = codeToRun;
      running = true;
      runBtn!.classList.add("is-loading");
      updateRunButtonState();
      setRunHint(cold ? "lädt Playground-Runtime …" : "berechnet Geometrie …");

      timer = setTimeout(() => {
        timer = null;
        worker!.terminate();
        worker = new Worker("/beloch/eval-worker.js");
        wireWorker();
        running = false;
        runBtn!.classList.remove("is-loading");
        updateRunButtonState();
        setRunHint("");
        showError("Auswertung abgebrochen (Zeitüberschreitung).");
      }, TIMEOUT_MS);

      worker!.postMessage(codeToRun);
    }

    runBtn.addEventListener("click", run);

    if (!lazy) {
      worker = new Worker("/beloch/eval-worker.js");
      wireWorker();
      if (initialCode.trim()) run();
    }
  }

  document
    .querySelectorAll<HTMLElement>(".beloch-playground")
    .forEach(setup);
</script>
