---
// Live Beloch playground: CodeMirror 6 editor -> Web Worker (eval-worker.js,
// running the committed js_of_ocaml bundle) -> @beloch/scene + @beloch/render-svg
// -> injected SVG. No framework island — a plain client <script type="module">
// wires every `.beloch-playground` instance on the page (Astro dedupes and
// hoists this script once even if the component is used multiple times, so
// the wiring must be instance-scoped via querySelectorAll, not a singleton).
//
// Beloch-aware syntax highlighting (tree-sitter, via ../lib/highlight-bel.ts)
// is a build-time-only pipeline today (see Beloch.astro) — a live CM6
// language/highlight extension for .bel is not wired up yet, so the editor
// runs with CM6's basicSetup only (no Beloch token coloring).
import { highlightBel } from "../lib/highlight-bel";

interface Props {
  code?: string;
  height?: number;
  // Build-time-rendered SVG markup shown in `.pg-result` before any live
  // evaluation has run (e.g. a static fold rendered via evalBelToFold,
  // the same build-time path `<Beloch>` uses). Optional — default behavior
  // (the "Run drücken" notice) is unchanged when absent.
  seed?: string;
  // The FOLD JSON `seed` was rendered from (JSON.stringify'd). Optional — when
  // present, the client parses it directly (parseFold + render-svg only, no
  // wasm) on mount to populate the scrubber immediately, without waiting for
  // a Run click or the eval Worker's wasm boot.
  seedFold?: string;
  // When true, defer creating the eval Worker (and the 5.7 MB wasm module it
  // pulls) until the user actually clicks Run, instead of on mount. Optional
  // — default is today's eager boot.
  lazy?: boolean;
}
const { code = "", height = 320, seed, seedFold, lazy = false } = Astro.props;

// The program, coloured at build time by the same grammar the editor will use
// (lib/highlight-bel.ts). It stands in the pane until the editor's parser has
// loaded, so the first paint already carries the syntax colours and mounting
// the editor never takes them away again. Line numbers are known here too.
const highlightedCode = code ? await highlightBel(code) : "";
const codeLines = code ? code.split("\n").length : 0;
---

<div
  class="beloch-playground"
  style={`--pg-height:${height}px`}
  data-lazy={lazy ? "true" : "false"}
>
  <div class="pg-pane pg-editor">
    <button type="button" class="pg-run" aria-label="Run" title="Run">
      <svg class="pg-run-play" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
        <path d="M3 2 L13 8 L3 14 Z" fill="currentColor" />
      </svg>
      <span class="pg-run-spinner" aria-hidden="true"></span>
    </button>
    <div class="pg-run-hint" role="status" aria-live="polite"></div>
    <button
      type="button"
      class="pg-debug"
      aria-pressed="false"
      disabled
      title="Show the values the program binds (Ctrl/Cmd+Shift+D)"
    >values</button>
    <div class="pg-source">
      <template class="pg-source-seed">{code}</template>
      {code ? (
        <pre class="pg-source-static"><span class="pg-static-gutter">{Array.from({ length: codeLines }, (_, i) => i + 1).join("\n")}</span><code set:html={highlightedCode} /></pre>
      ) : null}
    </div>
    {seedFold ? <script type="application/json" class="pg-seed-fold" set:html={seedFold} /> : null}
  </div>
  <div class="pg-pane pg-output">
    <div class="pg-toolbar pg-toolbar-output">
      <div class="pg-toolbar-views pg-segmented" role="tablist" aria-label="View">
        <button type="button" role="tab" class="pg-view" data-view="cp" aria-selected="false">crease pattern</button>
        <button type="button" role="tab" class="pg-view is-active" data-view="folded" aria-selected="true">folded</button>
      </div>
      <div class="pg-toolbar-tools">
        <div class="pg-menu">
          <button type="button" class="pg-menu-toggle pg-view-toggle" aria-expanded="false" aria-haspopup="true">
            <span class="pg-menu-swatch" aria-hidden="true"></span>view<span class="pg-menu-caret" aria-hidden="true">▾</span>
          </button>
          <div class="pg-menu-panel pg-view-panel" hidden>
            <div class="pg-menu-group">
              <p class="pg-menu-head" aria-hidden="true">Paper</p>
              <div class="pg-swatches" role="group" aria-label="Paper"></div>
              <p class="pg-menu-note"></p>
            </div>
            <div class="pg-menu-group">
              <p class="pg-menu-head" aria-hidden="true">Lines</p>
              <div class="pg-segmented pg-styles" role="group" aria-label="Line style">
                <button type="button" class="pg-style" data-style="colour" aria-pressed="false">color</button>
                <button type="button" class="pg-style is-active" data-style="mono" aria-pressed="true">mono</button>
              </div>
            </div>
            <label class="pg-menu-check">
              <span>hidden lines</span>
              <input type="checkbox" class="pg-hidden-lines" />
            </label>
          </div>
        </div>
        <div class="pg-menu">
          <button type="button" class="pg-menu-toggle pg-export-toggle" aria-expanded="false" aria-haspopup="true">
            export<span class="pg-menu-caret" aria-hidden="true">▾</span>
          </button>
          <div class="pg-menu-panel pg-export" hidden>
            <p class="pg-export-step"></p>
            <button type="button" data-export="download">Download SVG</button>
            <button type="button" data-export="copy">Copy SVG</button>
            <button type="button" data-export="link">Copy link to program + step</button>
            <p class="pg-export-said" role="status"></p>
          </div>
        </div>
      </div>
    </div>
    <div
      class="pg-result"
      role="group"
      aria-label="Drawing. Arrow keys step, plus and minus zoom, 0 resets the view."
    >
      <div class="pg-canvas">
        {seed ? <Fragment set:html={seed} /> : <p class="pg-notice pg-notice-info">Press “Run” to evaluate.</p>}
      </div>
      <button type="button" class="pg-reset" hidden aria-label="Reset view" title="Reset view">
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
          <path
            d="M8 3.5a4.5 4.5 0 1 0 4.24 3"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />
          <path d="M12.5 1.5 L12.5 5 L9 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <aside class="pg-card" aria-label="Selection" hidden></aside>
    </div>
    <div class="pg-error" role="alert" hidden></div>
    <div class="pg-steps" hidden>
      <div class="pg-step-timeline">
        <button type="button" class="pg-step-nav pg-step-prev" aria-label="Previous step" title="Previous step">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path d="M10 3 L5 8 L10 13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="pg-step-track"></div>
        <button type="button" class="pg-step-nav pg-step-next" aria-label="Next step" title="Next step">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path d="M6 3 L11 8 L6 13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
      <span class="pg-step-label"></span>
    </div>
  </div>
</div>

<style>
  /* 44 / 56. The drawing takes more than half the card, so its shorter edge
     clears 320 px at every width the two columns are used at (B3.2), and the
     editor still holds a forty-character line without wrapping. */
  .beloch-playground {
    display: grid;
    grid-template-columns: 44% 1fr;
    position: relative;
    margin: 1.5rem 0;
    border: 1px solid var(--bel-ui-divider);
    border-radius: var(--bel-radius-card);
    overflow: hidden;
    background: var(--bel-ui-surface);
    /* Opt the rendered paper's SVG backdrop rect out of its white default
       (WEB_THEME reads --bel-paper-background) so the paper lies on the transparent pane. */
    --bel-paper-background: transparent;
  }
  /* Under the break the drawing goes above the code (B3.7), and the editor
     keeps a height that reaches past the fold, so the cut-off line at the
     bottom of the screen says there is more (B3.9). */
  @media (max-width: 720px) {
    .beloch-playground { grid-template-columns: 1fr; }
    .pg-output { order: 1; }
    .pg-editor { order: 2; }
  }

  .pg-pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .pg-editor {
    position: relative;
    background: var(--bel-ui-code-surface);
    border-right: 1px solid var(--bel-ui-divider);
  }
  @media (max-width: 720px) {
    .pg-editor { border-right: none; border-bottom: 1px solid var(--bel-ui-divider); }
  }

  .pg-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 16px;
    gap: 8px 16px;
    font-family: var(--bel-font-mono);
    font-size: var(--bel-text-xs);
  }
  .pg-output .pg-toolbar {
    color: var(--bel-ui-text-muted);
    border-bottom: 1px solid var(--bel-ui-divider);
  }
  .pg-toolbar-output {
    gap: 16px;
  }
  .pg-toolbar-tools {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-left: auto;
  }


  /* A set of states one control chooses between is drawn as one control: the
     segments carry the border between them, and the chosen one is filled
     rather than outlined, so the pair reads as a switch and not as two
     buttons that happen to touch. */
  .pg-segmented {
    display: flex;
    align-items: center;
    border: 1px solid var(--bel-ui-divider);
    border-radius: var(--bel-radius-control);
    overflow: hidden;
  }
  .pg-segmented > button {
    font: inherit;
    font-size: var(--bel-text-xs);
    padding: 4px 10px;
    border: 0;
    background: var(--bel-ui-surface);
    color: var(--bel-ui-text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: color var(--bel-duration-state) var(--bel-ease), background var(--bel-duration-state) var(--bel-ease);
  }
  .pg-segmented > button + button {
    border-left: 1px solid var(--bel-ui-divider);
  }
  /* In a menu the control runs the width of the panel, so its segments split
     that width rather than sitting in the corner of it. */
  .pg-view-panel .pg-segmented > button { flex: 1; }
  .pg-segmented > button:hover:not(:disabled) { color: var(--bel-ui-accent); }
  .pg-segmented > button.is-active {
    background: var(--bel-ui-quiet);
    color: var(--bel-ui-text);
  }
  /* A paper the coloured style cannot hold switches that segment off (see
     colorOk in lib/paper-schemes) and the note under the swatches says why,
     rather than dropping it and leaving a gap. */
  .pg-segmented > button:disabled {
    cursor: default;
    color: var(--bel-ui-text-faint);
  }
  .pg-segmented > button:focus-visible {
    outline: 2px solid var(--bel-ui-accent);
    outline-offset: -2px;
  }

  /* A menu is a word in the bar and a panel under it. Two of them: what the
     drawing looks like, and what leaves the page. Both hold choices a reader
     makes rarely, which is why they are folded away and the bar stays short
     enough to read in one pass. */
  .pg-menu {
    position: relative;
    display: flex;
  }
  .pg-menu-toggle {
    font: inherit;
    font-size: var(--bel-text-xs);
    display: flex;
    align-items: center;
    gap: var(--bel-space-1);
    padding: 3px 10px;
    border-radius: var(--bel-radius-control);
    border: 1px solid var(--bel-ui-control-border);
    background: transparent;
    color: var(--bel-ui-text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: color var(--bel-duration-state) var(--bel-ease), border-color var(--bel-duration-state) var(--bel-ease);
  }
  .pg-menu-toggle:hover { color: var(--bel-ui-accent); }
  .pg-menu-toggle[aria-expanded="true"] {
    border-color: var(--bel-ui-accent);
    color: var(--bel-ui-text);
  }
  .pg-menu-toggle:focus-visible {
    outline: 2px solid var(--bel-ui-accent);
    outline-offset: 2px;
  }
  .pg-menu-caret { font-size: var(--bel-text-2xs); }
  /* The paper the drawing is on, shown in the closed menu: the choice is
     visible without opening what made it. */
  .pg-menu-swatch {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    border: 1px solid var(--bel-ui-control-border);
  }
  .pg-menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    z-index: 5;
    background: var(--bel-ui-surface);
    border: 1px solid var(--bel-ui-divider);
    border-radius: var(--bel-radius-card);
    box-shadow: var(--bel-shadow-overlay);
    font-family: var(--bel-font-mono);
  }
  .pg-menu-panel[hidden] { display: none; }
  .pg-view-panel {
    width: 232px;
    padding: var(--bel-space-2);
    display: flex;
    flex-direction: column;
    gap: var(--bel-space-2);
  }
  .pg-menu-group {
    display: flex;
    flex-direction: column;
    gap: var(--bel-space-1);
  }
  .pg-menu-head {
    margin: 0;
    font-size: var(--bel-text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bel-ui-text-muted);
  }
  .pg-menu-note {
    margin: 0;
    font-size: var(--bel-text-2xs);
    color: var(--bel-ui-text-muted);
    min-height: 1em;
  }
  .pg-menu-check {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--bel-space-1);
    font-size: var(--bel-text-xs);
    color: var(--bel-ui-text);
    cursor: pointer;
  }
  /* A switch nothing can be said about is still shown, with the reason in its
     title: hidden lines mean nothing on a flat sheet. */
  .pg-menu-check:has(input:disabled) {
    color: var(--bel-ui-text-faint);
    cursor: default;
  }
  .pg-menu-check input {
    accent-color: var(--bel-ui-accent);
    width: 15px;
    height: 15px;
    margin: 0;
    cursor: inherit;
  }
  .pg-menu-check input:focus-visible {
    outline: 2px solid var(--bel-ui-accent);
    outline-offset: 2px;
  }

  /* The button sits in the top right of the program it runs. On the seam
     between the panes it stood over the drawing's left edge, which is where
     the paper is widest; a program's first lines are short, so the corner over
     the code is the quietest place on the card. It takes the code surface's
     own palette, because that is the surface it lies on. */
  /* The debug toggle, under the Run button on the code surface: the mode is
     the editor's, so the control stands with the editor rather than in the
     toolbar over the drawing. */
  .pg-debug {
    position: absolute;
    top: 10px;
    right: 58px;
    z-index: 2;
    height: 40px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--bel-ui-code-gutter) 45%, transparent);
    background: color-mix(in srgb, var(--bel-ui-code-surface) 92%, transparent);
    color: var(--bel-ui-code-text);
    font-family: var(--bel-font-mono);
    font-size: var(--bel-text-2xs);
    cursor: pointer;
    transition:
      color var(--bel-duration-state) var(--bel-ease),
      border-color var(--bel-duration-state) var(--bel-ease);
  }
  .pg-debug:hover:not(:disabled) { color: var(--bel-ui-code-accent); }
  .pg-debug.is-active {
    color: var(--bel-ui-code-accent);
    border-color: var(--bel-ui-code-accent);
  }
  .pg-debug:disabled {
    opacity: 0.45;
    cursor: default;
  }
  .pg-run {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--bel-ui-code-accent);
    background: color-mix(in srgb, var(--bel-ui-code-surface) 82%, transparent);
    color: var(--bel-ui-code-accent);
    cursor: pointer;
    transition: background var(--bel-duration-state) var(--bel-ease), color var(--bel-duration-state) var(--bel-ease);
  }
  .pg-run:hover:not(:disabled) {
    background: var(--bel-ui-code-accent);
    color: var(--bel-ui-code-surface);
  }
  .pg-run:disabled {
    cursor: default;
    border-color: var(--bel-ui-code-gutter);
    color: var(--bel-ui-code-gutter);
  }
  .pg-run-spinner {
    display: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid currentColor;
    border-top-color: transparent;
    animation: pg-spin 0.7s linear infinite;
  }
  .pg-run-play {
    /* A triangle carries its mass to the left of its box, so the optical
       centre of the circle is two pixels right of the geometric one. */
    margin-left: 2px;
  }
  .pg-run.is-loading .pg-run-play { display: none; }
  .pg-run.is-loading .pg-run-spinner { display: block; }
  /* Once the transfer reports itself, the ring turns by how much of the
     runtime has arrived instead of looping: the movement carries the progress
     the status line spells out (B2.12). */
  .pg-run.has-progress .pg-run-spinner {
    animation: none;
    transform: rotate(var(--pg-load-turn, 0deg));
    transition: transform var(--bel-duration-state) var(--bel-ease);
  }
  @keyframes pg-spin {
    to { transform: rotate(360deg); }
  }

  .pg-run-hint {
    position: absolute;
    top: 56px;
    right: 10px;
    z-index: 2;
    max-width: calc(100% - 20px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--bel-font-mono);
    font-size: var(--bel-text-2xs);
    /* Beside the button, so both read as one control on the code surface. */
    color: var(--bel-ui-code-text);
    background: color-mix(in srgb, var(--bel-ui-code-surface) 92%, transparent);
    border: 1px solid color-mix(in srgb, var(--bel-ui-code-gutter) 45%, transparent);
    border-radius: 999px;
    padding: 3px 10px;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--bel-duration-state) var(--bel-ease);
  }
  .pg-run-hint.is-visible {
    opacity: 1;
  }

  /* The editor fills its pane through the flex chain rather than a percentage
     height: this box takes its size from `min-height` and from growing, so its
     computed height stays `auto` and a child's `height: 100%` would resolve to
     its own content, leaving a strip of pane below the editor. */
  .pg-source {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: var(--pg-height, 320px);
    resize: vertical;
    overflow: hidden;
    background: transparent;
  }
  .pg-source :global(.cm-editor) {
    flex: 1;
    min-height: 0;
  }

  /* The build-time copy of the program, holding the pane until the editor's
     parser has loaded. Its type grid is the editor's: the same font, the same
     --bel-code-* scale, the same content padding and the same gutter width, so
     the swap moves no glyph. cm-mount.test.ts pins the four values that have
     to agree. */
  .pg-source-static {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    flex: 1;
    min-height: 0;
    margin: 0;
    padding: 14px 18px 14px 0;
    overflow: hidden;
    font-family: var(--bel-font-mono);
    font-size: var(--bel-code-size);
    line-height: var(--bel-code-line);
    color: var(--bel-ui-code-text);
    white-space: pre;
  }
  .pg-static-gutter {
    grid-column: 1;
    padding-right: 3px;
    padding-left: 12px;
    margin-right: 18px;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    min-width: 20px;
    text-align: right;
    color: var(--bel-ui-code-gutter);
    user-select: none;
  }
  .pg-source-static code {
    font: inherit;
    background: none;
    padding: 0;
    white-space: pre;
  }
  .pg-source :global(.cm-scroller) {
    overflow: auto;
  }
  /* basicSetup brings a fold gutter. Folding needs a language to supply the
     ranges, and this editor colours through decorations rather than through a
     CodeMirror language, so that gutter can never show a marker. Hidden, it
     stops taking ten pixels that the static copy would otherwise have to
     reproduce to keep the swap from moving the text.
     `!important` because CodeMirror's base theme marks every gutter's display
     `flex !important` to stop margin collapsing, and nothing weaker reaches
     past that. */
  .pg-source :global(.cm-foldGutter) {
    display: none !important;
  }
  /* The line the drawing stands at, marked in the column the reader already
     reads the program in. The editor sits on the code surface, so the mark
     takes that surface's fixed accent rather than the one that follows the
     mode. */
  .pg-source :global(.cm-step-line) {
    background: color-mix(in srgb, var(--bel-ui-code-accent) 15%, transparent);
  }
  /* A word that binds a value, while debug mode is on: the target a reader
     aims at, drawn on the characters rather than the line, since a statement
     binds where it spells the name. One word per box, which is also what keeps
     the outline whole: the editor cuts a mark at every syntax span, so a box
     over a whole statement would be drawn once per token. The selected ones
     are filled. */
  .pg-source :global(.cm-debug-box) {
    border-radius: 2px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--bel-ui-code-accent) 50%, transparent);
    cursor: pointer;
  }
  /* What the sheet brings, under the line that declares the paper: the four
     corners and the four edges, which no statement binds and which the source
     therefore has nowhere to box. Chips rather than text, so the row reads as
     part of the editor's chrome and not as a line of the program. */
  /* The rows read as lines of the program: the editor's type, its line height,
     its indent, and the colours the grammar gives a point and a line. What
     marks the names as targets is the box every other target carries. The
     block takes a ground of its own, because these values come with the sheet
     rather than from the text above them. */
  .pg-source :global(.cm-debug-chips) {
    background: color-mix(in srgb, var(--bel-ui-code-accent) 7%, transparent);
    box-shadow: inset 2px 0 0 color-mix(in srgb, var(--bel-ui-code-accent) 35%, transparent);
  }
  .pg-source :global(.cm-debug-chip-row) {
    /* The indent of a line of code, so the names stand under the program. */
    padding: 0 18px;
    white-space: pre;
  }
  .pg-source :global(.cm-debug-chip) {
    margin-right: 1ch;
    cursor: pointer;
  }
  .pg-source :global(.cm-debug-note) {
    margin-left: 1ch;
  }
  .pg-source :global(.cm-debug-box.is-on) {
    background: color-mix(in srgb, var(--bel-ui-code-accent) 30%, transparent);
    box-shadow: 0 0 0 1px var(--bel-ui-code-accent);
  }
  /* Every place the clicked bundle is named: the operands of a construction,
     the arguments of a flatten, a filter. Marked on the characters rather
     than the line, because a line can name several creases. */
  .pg-source :global(.cm-bel-ref) {
    border-radius: 2px;
    background: color-mix(in srgb, var(--bel-ui-code-accent) 28%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--bel-ui-code-accent) 45%, transparent);
  }
  /* The line a failed run named, on the same always-dark surface and in that
     surface's own error colour. It stands next to the step line rather than
     replacing it: the drawing the step marks is still on screen. */
  .pg-source :global(.cm-error-line) {
    background: color-mix(in srgb, var(--bel-ui-code-error) 12%, transparent);
    box-shadow: inset 3px 0 0 var(--bel-ui-code-error);
  }

  .pg-output {
    background: transparent;
  }
  .pg-result {
    position: relative;
    flex: 1;
    min-height: var(--pg-height, 320px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px;
    overflow: hidden;
    background: transparent;
    cursor: grab;
  }
  .pg-result.is-panning {
    cursor: grabbing;
  }
  /* The paper itself: pan/zoom transform target. Origin 0 0 keeps the
     zoom-toward-cursor math (in the client script) layout-agnostic. */
  /* The canvas fills the pane rather than shrinking to the drawing, so its
     height is definite and the SVG's own `max-height: 100%` has something to
     resolve against. Against a parent whose height is its content that
     percentage resolves to nothing and a large drawing renders at natural size
     and gets clipped. The drawing stays centred because this is itself a
     centring flex container, and the pan/zoom maths reads this element's live
     rect, so a bigger box changes nothing there. */
  .pg-canvas {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    flex: 1;
    min-width: 0;
    min-height: 0;
    transform-origin: 0 0;
    will-change: transform;
  }
  .pg-canvas :global(svg) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }
  /* Cursor→SVG side of the bidirectional entity highlight: outlines the
     crease segment(s) whose provenance span covers the editor's cursor
     line. Overrides the per-segment stroke/stroke-width attributes
     render-scene.ts emits (CSS class beats presentation attributes). */
  .pg-canvas :global(.bel-hl) {
    stroke: var(--bel-ui-accent);
    stroke-width: 4;
  }
  /* A name is read rather than followed, so it takes the accent as its colour.
     The stroke above would put a four-pixel outline around every glyph and
     close the letters up. The white halo underneath stays: it is what keeps
     the name legible over a crease. */
  .pg-canvas :global(text.bel-hl) {
    fill: var(--bel-ui-accent);
    stroke: white;
    stroke-width: 2.5;
    paint-order: stroke;
  }
  /* The dot of a highlighted point is filled rather than outlined, for the
     same reason: at three pixels across, a four-pixel stroke is all there is
     of it. */
  .pg-canvas :global(circle.bel-hl) {
    fill: var(--bel-ui-accent);
    stroke: none;
  }
  /* Occluded segments of a highlighted bundle, drawn from inspect data since
     they have no rendered line — dashed + semi-transparent to read as "behind". */
  .pg-canvas :global(.bel-hl-ghost) {
    stroke: var(--bel-ui-accent);
    stroke-width: 2.5;
    stroke-dasharray: 5 4;
    opacity: 0.55;
    fill: none;
    pointer-events: none;
  }
  /* Notices (info/error) mustn't inherit the grab cursor — they're not
     draggable paper. */
  .pg-canvas:has(:global(.pg-notice)) {
    cursor: default;
  }
  /* Crease hit-area: the renderer inserts one of these, transparent and fat,
     right after every real crease line so there's a forgiving click target;
     the visible line itself stays thin. */
  .pg-canvas :global(line.bel-hit) {
    stroke: transparent;
    stroke-width: 14;
    fill: none;
    pointer-events: stroke;
    cursor: pointer;
  }
  /* The point twin is a disc rather than a fat stroke, so it takes the
     pointer over its whole area. */
  .pg-canvas :global(circle.bel-hit) {
    fill: transparent;
    stroke: none;
    pointer-events: fill;
    cursor: pointer;
  }
  /* Everything grabs the paper by default (see .pg-result above) — creases
     (and their hit-area twins) are the one thing you can click, so they get
     their own cursor to signal that. Task 9: paper boundary lines are
     selectable too but carry no data-crease-id, so this also matches on
     data-kind="crease" directly (a superset of the data-crease-id case). */
  .pg-canvas :global([data-crease-id]),
  .pg-canvas :global(line[data-kind="crease"]) {
    cursor: pointer;
  }

  .pg-reset {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border-radius: var(--bel-radius-control);
    border: 1px solid var(--bel-ui-control-border);
    background: color-mix(in srgb, var(--bel-ui-surface) 78%, transparent);
    color: var(--bel-ui-text-muted);
    cursor: pointer;
    opacity: 0.45;
    transition: opacity var(--bel-duration-state) var(--bel-ease), color var(--bel-duration-state) var(--bel-ease);
  }
  .pg-result:hover .pg-reset:not([hidden]),
  .pg-reset:hover,
  .pg-reset:focus-visible {
    opacity: 1;
  }
  .pg-reset:hover {
    color: var(--bel-ui-accent);
  }
  .pg-reset:focus-visible {
    outline: 2px solid var(--bel-ui-accent);
    outline-offset: 2px;
  }
  .pg-reset[hidden] {
    display: none;
  }

  /* The selection card stands on the drawing at the place the reader clicked,
     so the answer sits next to the line it is about. It is positioned in the
     stage rather than in the canvas, which keeps it at reading size at every
     zoom; the script moves it with the pan and the zoom. */
  .pg-card {
    position: absolute;
    z-index: 5;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 10px;
    /* An absolute box shrinks to the room right of its anchor; the card
       grows left as often as right, so it sizes to its content instead. */
    width: max-content;
    max-width: min(420px, 90%);
    padding: 8px 8px 8px 12px;
    background: var(--bel-ui-surface);
    border: 1px solid var(--bel-ui-divider);
    border-radius: var(--bel-radius-card);
    box-shadow: var(--bel-shadow-overlay);
    font: 12.5px/1.45 var(--bel-font-mono);
    font-variant-ligatures: none;
    color: var(--bel-ui-text);
    cursor: auto;
  }
  .pg-card[hidden] {
    display: none;
  }
  /* These children are injected via innerHTML, so they never carry Astro's
     scope attribute — the rules MUST be :global (like .bel-hl / .bel-hit above),
     or they silently don't apply. */
  .pg-card :global(.pg-card-body) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .pg-card :global(.pg-card-head) {
    display: flex;
    gap: 8px;
    font-size: 11px;
    color: var(--bel-ui-text-muted);
  }
  .pg-card :global(.pg-card-name) {
    color: var(--bel-ui-accent);
  }
  .pg-card :global(.pg-card-text) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pg-card :global(.pg-card-close) {
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid var(--bel-ui-divider);
    border-radius: var(--bel-radius-control);
    background: var(--bel-ui-surface);
    color: var(--bel-ui-text-muted);
    font: inherit;
    cursor: pointer;
  }
  .pg-card :global(.pg-card-close:hover) {
    border-color: var(--bel-ui-control-border);
  }
  .pg-card :global(.pg-card-close:focus-visible) {
    outline: 2px solid var(--bel-ui-accent);
    outline-offset: 1px;
  }
  /* The segments of a bundle, and the lines a pixel offers, as rows under the
     answer: the stack picker lives in the card. */
  .pg-card :global(.seg) {
    grid-column: 1 / -1;
    border-top: 1px solid var(--bel-ui-divider);
    margin: 6px -8px 0 -12px;
    padding: 5px 12px 0;
    color: var(--bel-ui-text-muted);
    cursor: pointer;
  }
  .pg-card :global(.seg:hover) {
    color: var(--bel-ui-text);
    background: var(--bel-ui-quiet);
  }

  .pg-canvas :global(.pg-notice) {
    margin: 0;
    max-width: 32ch;
    text-align: center;
    font-family: var(--bel-font-prose);
    font-size: 13.5px;
    line-height: var(--bel-line-height);
  }
  .pg-canvas :global(.pg-notice-info) { color: var(--bel-ui-text-muted); }

  .pg-swatches { display: inline-flex; gap: 8px; }
  .pg-swatches :global(.pg-swatch) {
    width: 22px; height: 22px; padding: 0;
    border-radius: 50%;
    border: 1px solid var(--bel-ui-control-border);
    cursor: pointer;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }
  .pg-swatches :global(.pg-swatch:hover) {
    border-color: var(--bel-ui-accent);
  }
  .pg-swatches :global(.pg-swatch:focus-visible) {
    outline: 2px solid var(--bel-ui-accent);
    outline-offset: 2px;
  }
  /* The chosen paper carries a ring in the panel colour and then the accent,
     so the mark reads against a swatch of any lightness. */
  .pg-swatches :global(.pg-swatch.is-active) {
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.08),
      0 0 0 2px var(--bel-ui-surface),
      0 0 0 4px var(--bel-ui-accent);
  }

  /* The drawing takes focus as one target: arrow keys walk the steps, plus and
     minus zoom, 0 resets. The ring is offset inwards because this pane runs to
     the card's own edge, and a ring outside it would sit on that edge. */
  .pg-result:focus-visible {
    outline: 2px solid var(--bel-ui-accent);
    outline-offset: -4px;
  }
  /* A crease is reached with the keyboard through its hit line, which is
     transparent until it carries focus. An `outline` on an SVG line is drawn
     around its bounding box, so the hit stroke itself is what shows. */
  .pg-canvas :global(.bel-hit:focus-visible) {
    outline: none;
    stroke: var(--bel-ui-accent);
    stroke-opacity: 0.4;
  }

  /* What leaves the page hangs under the word that offers it, so nothing is
     laid over the drawing while the reader is choosing. */
  .pg-export {
    width: 240px;
    padding: 8px 12px 10px;
  }
  .pg-export-step {
    margin: 0 0 2px;
    font-size: var(--bel-text-2xs);
    color: var(--bel-ui-text-faint);
  }
  .pg-export button {
    display: block;
    width: 100%;
    text-align: left;
    font: inherit;
    font-size: var(--bel-text-xs);
    color: var(--bel-ui-text);
    background: transparent;
    border: 0;
    padding: 5px 0;
    cursor: pointer;
  }
  .pg-export button:hover { color: var(--bel-ui-accent); }
  .pg-export button:focus-visible {
    outline: 2px solid var(--bel-ui-accent);
    outline-offset: 1px;
  }
  .pg-export button[data-export="link"] {
    border-top: 1px solid var(--bel-ui-divider);
    margin-top: 4px;
  }
  .pg-export-said {
    margin: 2px 0 0;
    min-height: 1em;
    font-size: var(--bel-text-2xs);
    color: var(--bel-ui-text-muted);
  }

  /* A diagnostic stands beside the drawing it belongs to and never in place of
     it: the last valid drawing is what the reader is comparing the message
     against (B3.5). */
  .pg-error {
    padding: 9px 16px;
    border-top: 1px solid var(--bel-ui-divider);
    font-family: var(--bel-font-mono);
    font-size: var(--bel-text-xs);
    line-height: 1.5;
    color: var(--bel-ui-text);
  }
  .pg-error[hidden] { display: none; }
  .pg-error :global(.pg-error-where) {
    color: var(--bel-ui-error);
    font-weight: 600;
    margin-right: 8px;
  }

  .pg-steps {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
    padding: 8px 16px;
    border-top: 1px solid var(--bel-ui-divider);
    font-family: var(--bel-font-mono);
    font-size: var(--bel-text-2xs);
    color: var(--bel-ui-text-muted);
  }
  .pg-steps[hidden] { display: none; }

  .pg-step-timeline {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pg-step-nav {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border-radius: var(--bel-radius-control);
    border: 1px solid var(--bel-ui-control-border);
    background: transparent;
    color: var(--bel-ui-text-muted);
    cursor: pointer;
    transition: color var(--bel-duration-state) var(--bel-ease), border-color var(--bel-duration-state) var(--bel-ease);
  }
  .pg-step-nav:hover:not(:disabled) {
    color: var(--bel-ui-accent);
    border-color: var(--bel-ui-accent);
  }
  .pg-step-nav:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* The track: dots spread edge-to-edge over a connecting rule, with a
     valley-colored progress fill running left→current so the position is
     legible in the bar itself (--pg-progress is set per step in JS). */
  .pg-step-track {
    position: relative;
    flex: 1;
    min-width: 0;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .pg-step-track::before,
  .pg-step-track::after {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    height: 3px;
    border-radius: 3px;
    transform: translateY(-50%);
    /* Purely decorative rules — must never intercept the pointer, or the
       dots underneath lose their pointer cursor / clickability. */
    pointer-events: none;
  }
  .pg-step-track::before {
    right: 0;
    background: var(--bel-ui-divider);
  }
  .pg-step-track::after {
    width: var(--pg-progress, 0%);
    background: var(--bel-ui-accent);
    transition: width var(--bel-duration-state) var(--bel-ease);
  }
  :global(.pg-step-dot) {
    position: relative;
    z-index: 1;
    flex: none;
    width: 34px;
    height: 34px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  :global(.pg-step-dot)::before {
    content: "";
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--bel-ui-control-border);
    background: var(--bel-ui-surface);
    /* Panel-colored gap ring separates the dot from the track line so it
       clearly reads as sitting *on top of* the line, not merged into it. */
    box-shadow: 0 0 0 3px var(--bel-ui-surface);
    transition: transform var(--bel-duration-state) var(--bel-ease), background var(--bel-duration-state) var(--bel-ease), border-color var(--bel-duration-state) var(--bel-ease);
  }
  :global(.pg-step-dot:hover)::before {
    border-color: var(--bel-ui-accent);
    transform: scale(1.15);
  }
  /* Steps at or before the current one read as "reached" (filled valley);
     the current one is additionally enlarged with a halo ring. */
  :global(.pg-step-dot.is-past)::before {
    background: var(--bel-ui-accent);
    border-color: var(--bel-ui-accent);
  }
  :global(.pg-step-dot.is-active) {
    z-index: 2;
  }
  :global(.pg-step-dot.is-active)::before {
    width: 18px;
    height: 18px;
    background: var(--bel-ui-accent);
    border-color: var(--bel-ui-accent);
    /* Inner panel gap ring + outer valley glow — pops the current dot off
       both the line and its neighbors. */
    box-shadow:
      0 0 0 3px var(--bel-ui-surface),
      0 0 0 6px color-mix(in srgb, var(--bel-ui-accent) 30%, transparent);
  }
  .pg-step-label {
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<script>
  import { EditorView, basicSetup } from "codemirror";
  import { EditorState, Prec } from "@codemirror/state";
  import { keymap } from "@codemirror/view";
  import {
    stepMarkerExtensions,
    setStepLineOn,
    setErrorLineOn,
  } from "../lib/cm-step-marker";
  import {
    debugExtensions,
    debugIsOn,
    setDebugBoxesOn,
    setDebugChipsOn,
    setDebugModeOn,
    type DebugBox,
    type DebugChip,
  } from "../lib/cm-debug-boxes";
  import { refMarkExtensions, setRefSpansOn } from "../lib/cm-ref-marks";
  import { initBelHighlight, belHighlighting } from "../lib/cm-bel-highlight";
  import { parseFold, type FoldScene, type Statement, type Vec2 } from "@beloch/scene";
  import {
    colorLineStyle,
    sceneLayout,
    DEFAULT_THEME,
    WEB_THEME,
    type Theme,
  } from "@beloch/render-svg";
  import {
    createRuntime,
    renderCommand,
    sameEntity,
    toggleEntity,
    type View,
  } from "@beloch/runtime";
  import { SCHEMES, STORAGE_KEY, DEFAULT_ID, applyScheme, resolveScheme } from "../lib/paper-schemes";
  import { lookupEntity, type EntityRef } from "../lib/inspect-lookup";
  import { segMatchesLine } from "../lib/stack-picker";
  import { hoverSummary, segmentRows, edgeSegmentRows } from "../lib/tooltip-content";
  import { cardContent, cardPlacement } from "../lib/selection-card";
  import { bundleElements } from "../lib/bundle-highlight";
  import {
    debugTargets,
    entitiesAtLine,
    refSpansFor,
    sourceLineOf,
    type DebugTarget,
    type SpanPos,
  } from "@beloch/runtime-editor";
  import { createPick } from "@beloch/runtime-pick";
  import {
    clearHighlight,
    commandToSvg,
    createDomRenderer,
    lightEntities,
    CREASE_SELECTOR,
    GHOST_CLASS,
    HIT_SELECTOR,
    HIT_CLASS,
    HL_CLASS,
    type FadeLength,
  } from "@beloch/runtime-render-dom";
  import { edgeOfLine } from "../lib/edge-lookup";
  import { pointSegDist, segmentDrawnAt, type DrawnLine } from "../lib/pick-visibility";
  import {
    createEvaluator,
    initialEvaluatorState,
    runUi,
    type Diagnostic,
    type EvaluatorState,
  } from "@beloch/runtime-eval";

  const editorTheme = EditorView.theme(
    {
      "&": {
        color: "var(--bel-ui-code-text)",
        backgroundColor: "transparent",
        height: "100%",
      },
      ".cm-scroller": {
        fontFamily: "var(--bel-font-mono)",
        fontSize: "var(--bel-code-size)",
        lineHeight: "var(--bel-code-line)",
      },
      // The padding is on the line rather than on the content, so a line's box
      // starts where the gutter ends. The step block's bar is drawn at that
      // edge, which gives it a lane of its own instead of a place against the
      // first character.
      ".cm-content": { padding: "14px 0", caretColor: "var(--bel-ui-code-text)" },
      ".cm-line": { padding: "0 18px", position: "relative" },
      // Opaque, because the gutter stays put while a long line scrolls
      // sideways, and the code would otherwise show through it.
      ".cm-gutters": {
        backgroundColor: "var(--bel-ui-code-surface)",
        color: "var(--bel-ui-code-gutter)",
        border: "none",
        borderRight: "1px solid rgba(255, 255, 255, 0.08)",
      },
      ".cm-lineNumbers .cm-gutterElement": { padding: "0 3px 0 12px" },
      ".cm-activeLine": { backgroundColor: "rgba(255, 255, 255, 0.04)" },
      ".cm-activeLineGutter": { backgroundColor: "rgba(255, 255, 255, 0.04)" },
      "&.cm-focused": { outline: "none" },
    },
    { dark: true },
  );

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  // Vanilla pan/zoom over a transform target (`.pg-canvas`) inside a viewport
  // (`.pg-result`). No library — a translate()+scale() matrix driven by
  // pointer-drag (pan) and wheel (zoom-toward-cursor). The zoom math is
  // layout-agnostic: it reads the target's live client rect each wheel tick,
  // so it works whether the canvas is flex-centered (identity) or panned.
  function createPanZoom(
    viewport: HTMLElement,
    target: HTMLElement,
    resetBtn: HTMLElement,
    onMove: () => void,
  ) {
    const MIN = 0.2;
    const MAX = 8;
    let scale = 1;
    let tx = 0;
    let ty = 0;
    let enabled = true;
    let dragging = false;
    let pointerId = -1;
    let lastX = 0;
    let lastY = 0;
    // Total displacement since pointerdown, past which a gesture counts as a
    // pan rather than a click — read by the entity-inspector click handler
    // (below) so a pan-and-release doesn't also pin whatever entity happens
    // to sit under the cursor at drop.
    const DRAG_THRESHOLD = 4;
    let downX = 0;
    let downY = 0;
    let dragMoved = false;

    function apply() {
      target.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      onMove();
    }
    function reset() {
      scale = 1;
      tx = 0;
      ty = 0;
      apply();
    }
    function setEnabled(on: boolean) {
      enabled = on;
      if (!on) endDrag();
    }

    // Scaling about a point: with transform-origin 0 0, keeping that point
    // fixed means translate delta = (point − target-origin)·(1 − s'/s).
    function zoomAbout(clientX: number, clientY: number, next: number) {
      const clamped = Math.min(MAX, Math.max(MIN, next));
      if (clamped === scale) return;
      const cr = target.getBoundingClientRect();
      const ratio = clamped / scale;
      tx += (clientX - cr.left) * (1 - ratio);
      ty += (clientY - cr.top) * (1 - ratio);
      scale = clamped;
      apply();
    }

    // Zoom from the keyboard has no cursor to hold still, so it holds the
    // middle of the viewport.
    function zoomBy(factor: number) {
      const r = viewport.getBoundingClientRect();
      zoomAbout(r.left + r.width / 2, r.top + r.height / 2, scale * factor);
    }

    // A wheel or a swipe over the drawing scrolls the page, like everywhere
    // else on it (B3.8). Zoom asks for itself: the modifier a trackpad pinch
    // already sends, or the drawing holding focus, which is also the state in
    // which + and − zoom.
    viewport.addEventListener(
      "wheel",
      (e: WheelEvent) => {
        if (!enabled) return;
        const asked = e.ctrlKey || e.metaKey || viewport.contains(document.activeElement);
        if (!asked) return;
        e.preventDefault();
        zoomAbout(e.clientX, e.clientY, scale * Math.exp(-e.deltaY * 0.0015));
      },
      { passive: false },
    );

    viewport.addEventListener("pointerdown", (e: PointerEvent) => {
      if (!enabled || e.button !== 0) return;
      if (resetBtn.contains(e.target as Node)) return;
      dragging = true;
      pointerId = e.pointerId;
      lastX = e.clientX;
      lastY = e.clientY;
      downX = e.clientX;
      downY = e.clientY;
      dragMoved = false;
      viewport.classList.add("is-panning");
    });
    viewport.addEventListener("pointermove", (e: PointerEvent) => {
      if (!dragging) return;
      tx += e.clientX - lastX;
      ty += e.clientY - lastY;
      lastX = e.clientX;
      lastY = e.clientY;
      if (!dragMoved && Math.hypot(e.clientX - downX, e.clientY - downY) > DRAG_THRESHOLD) {
        dragMoved = true;
        // Capture the pointer only once a genuine drag starts — NOT on
        // pointerdown. Capturing on down retargets the synthesized `click` to
        // the viewport, so a plain click's `e.target` is no longer the crease
        // line and the inspector can't anchor. A pure click never crosses the
        // threshold, so it never captures and keeps its real target.
        viewport.setPointerCapture(pointerId);
      }
      apply();
    });
    function endDrag() {
      if (!dragging) return;
      dragging = false;
      if (pointerId !== -1 && viewport.hasPointerCapture(pointerId)) {
        viewport.releasePointerCapture(pointerId);
      }
      pointerId = -1;
      viewport.classList.remove("is-panning");
    }
    viewport.addEventListener("pointerup", endDrag);
    viewport.addEventListener("pointercancel", endDrag);
    resetBtn.addEventListener("click", reset);

    // wasDrag() is read by the click handler, which fires AFTER pointerup
    // (and thus after endDrag() has already reset `dragging`) — dragMoved
    // survives that reset so the click handler can still tell a pan-release
    // apart from a genuine click.
    //
    // isDragging() is different: it reflects the LIVE `dragging` flag, for
    // the hover tooltip's mousemove handler (task 8) — that one needs to
    // know whether a pan is happening RIGHT NOW (so it doesn't flicker the
    // tooltip while the pointer crosses creases mid-drag), not whether the
    // gesture that JUST ended was a pan (wasDrag() stays true until the
    // NEXT pointerdown, which would wrongly suppress hover for a while
    // after a finished pan).
    return { reset, setEnabled, zoomBy, wasDrag: () => dragMoved, isDragging: () => dragging };
  }

  async function setup(root: HTMLElement) {
    const sourceMount = root.querySelector<HTMLDivElement>(".pg-source");
    const runBtn = root.querySelector<HTMLButtonElement>(".pg-run");
    const result = root.querySelector<HTMLDivElement>(".pg-result");
    const canvas = result?.querySelector<HTMLDivElement>(".pg-canvas");
    const resetBtn = root.querySelector<HTMLButtonElement>(".pg-reset");
    const runHint = root.querySelector<HTMLDivElement>(".pg-run-hint");
    const stepsBar = root.querySelector<HTMLDivElement>(".pg-steps");
    const stepDots = root.querySelector<HTMLDivElement>(".pg-step-track");
    const stepLabel = root.querySelector<HTMLSpanElement>(".pg-step-label");
    const stepPrev = root.querySelector<HTMLButtonElement>(".pg-step-prev");
    const stepNext = root.querySelector<HTMLButtonElement>(".pg-step-next");
    const card = root.querySelector<HTMLElement>(".pg-card");
    const errorBox = root.querySelector<HTMLDivElement>(".pg-error");
    const debugBtn = root.querySelector<HTMLButtonElement>(".pg-debug");
    const exportToggle = root.querySelector<HTMLButtonElement>(".pg-export-toggle");
    const exportPanel = root.querySelector<HTMLDivElement>(".pg-export");
    // Queried here rather than beside the export wiring below, because
    // renderStep reaches for them through updateExportPanel and runs first.
    const exportSaid = exportPanel?.querySelector<HTMLParagraphElement>(".pg-export-said") ?? null;
    const exportStepLine = exportPanel?.querySelector<HTMLParagraphElement>(".pg-export-step") ?? null;
    if (!sourceMount || !runBtn || !result || !canvas || !resetBtn || !runHint || !stepsBar || !stepDots || !stepLabel || !stepPrev || !stepNext || !card || !errorBox || !exportToggle || !exportPanel || !debugBtn) return;

    const panZoom = createPanZoom(result, canvas, resetBtn, () => placeCard());
    new ResizeObserver(() => placeCard()).observe(result);
    // A build-time `seed` SVG is already in the canvas; enable pan/zoom + the
    // reset affordance for it. The "Run drücken" notice is not pannable.
    {
      const hasSeedSvg = !!canvas.querySelector("svg");
      panZoom.setEnabled(hasSeedSvg);
      resetBtn.hidden = !hasSeedSvg;
    }

    function setRunHint(text: string) {
      runHint!.textContent = text;
      runHint!.classList.toggle("is-visible", text !== "");
    }

    const seed = sourceMount.querySelector<HTMLTemplateElement>(".pg-source-seed");
    const initialCode = seed?.content.textContent ?? "";
    // The server's coloured copy stays in the pane until the editor is built,
    // and goes in the same frame the editor goes in, so the reader sees the
    // program in its colours from the first paint through to typing in it.
    const staticSource = sourceMount.querySelector<HTMLElement>(".pg-source-static");
    const highlighter = await initBelHighlight().catch((err) => {
      // A grammar that fails to load costs the colours, not the editor.
      console.warn("playground: syntax highlighting unavailable", err);
      return null;
    });

    // Lazy instances defer the eval Worker until the user actually clicks
    // Run — focusing or editing the code must not, on its own, kick off a run
    // or pull in the wasm module.
    const lazy = root.dataset.lazy === "true";

    // Debug mode's state. It stands here because the run button's own update
    // reads it, and that runs while the editor is being built.
    //
    // `documentSource` is the source the document in the slot was evaluated
    // from: the spans it carries point into that text, so the mode is offered
    // only while the editor still holds it.
    let documentSource: string | null = null;
    let debugList: DebugTarget[] = [];

    // The phases, both limits and the in-flight run belong to
    // @beloch/runtime-eval. What is held here is the last state it reported,
    // because the button is drawn from a snapshot rather than from a module
    // that may not exist yet when the editor first asks.
    let runState: EvaluatorState = initialEvaluatorState;
    function updateRunButtonState() {
      const ui = runUi(runState);
      const progress = runState.progress;
      runBtn!.classList.toggle("is-loading", runState.running);
      runBtn!.classList.toggle("has-progress", progress !== null);
      // Two and a half turns over the whole transfer, so the ring keeps moving
      // visibly between one reported percent and the next.
      if (progress !== null) {
        runBtn!.style.setProperty("--pg-load-turn", `${Math.round(progress * 900)}deg`);
      }
      runBtn.disabled = ui.disabled;
      runBtn.title = ui.title;
      setRunHint(ui.status);
      // Line numbers from the last run no longer necessarily match the
      // edited text — clear the gutter indicator, but leave the scrubber
      // and the currently-shown SVG alone (same "stale result stays
      // visible" philosophy as the Run button itself).
      if (editor.state.doc.toString() !== runState.answered) {
        setStepLineOn(editor, null);
      }
      updateDebugButton();
    }

    const editor = new EditorView({
      state: EditorState.create({
        doc: initialCode,
        extensions: [
          ...stepMarkerExtensions(),
          ...debugExtensions({ onPick: (id) => pickDebugTarget(id) }),
          ...refMarkExtensions,
          basicSetup,
          ...(highlighter ? [belHighlighting(highlighter)] : []),
          // Above basicSetup, which binds Mod-Enter to insertBlankLine in
          // CodeMirror's default keymap. Precedence goes by position in this
          // list, so a binding added after it never fires.
          Prec.highest(
            keymap.of([
              {
                key: "Mod-Enter",
                run: () => {
                  runBtn.click();
                  return true;
                },
              },
              {
                key: "Mod-Shift-d",
                run: () => {
                  debugBtn.click();
                  return true;
                },
              },
            ]),
          ),
          editorTheme,
          EditorView.updateListener.of((update) => {
            if (update.docChanged) updateRunButtonState();
            if (update.selectionSet) highlightCreasesOnLine(update.state.doc.lineAt(update.state.selection.main.head).number);
          }),
        ],
      }),
      parent: sourceMount,
    });
    staticSource?.remove();
    updateRunButtonState();

    // Exposed so pages embedding this playground (e.g. the landing page's
    // example chips) can load a sample without reaching into CM6 internals.
    (root as unknown as { belochSetCode: (code: string) => void }).belochSetCode = (code) => {
      editor.dispatch({ changes: { from: 0, to: editor.state.doc.length, insert: code } });
    };

    // Which paper the drawing is on, and which of the two line styles draws on
    // it. They belong together: the coloured style is only offered where the
    // paper holds the crease colours (colorOk in lib/paper-schemes), so
    // picking a paper can decide the style.
    let currentSchemeId: string;
    try {
      currentSchemeId = resolveScheme(localStorage.getItem(STORAGE_KEY)).id;
    } catch {
      currentSchemeId = DEFAULT_ID;
    }
    let lineStyleId: "mono" | "colour" = "mono";
    // What the folded view does with the crease segments that lie under other
    // layers. The flat sheet occludes nothing, so this only bites in "folded".
    // Two states, so a checkbox: a buried segment is either drawn or it is
    // not. Drawn means `depth`, which fades a segment by how deep it lies;
    // `dashed` drew every buried run alike and is given up with the switch
    // that cycled through the three.
    let hiddenMode: "hide" | "depth" = "hide";
    // Which drawing of the current state is on the stage. Both are the same
    // state: the crease pattern is the flat sheet with the creases that exist
    // by this step, the folded view is that state seen from above with the
    // layers resolved. Switching the tab never moves the step.
    //
    // The folded state leads, because that is what the server already put in
    // the card (index.astro seeds renderFolded) and what the reader pressed
    // Run to see.
    let currentView: View = "folded";

    // The theme the stage draws with: the engine's own colours, resolved by
    // the page through CSS variables, under the chosen line style. Monochrome
    // is the Yoshizawa-Randlett notation a printed diagram uses and carries
    // mountain against valley in the dash pattern; coloured carries it in the
    // hue and reads faster where the paper allows it.
    // One object per style rather than a fresh one per call: the renderer
    // compares the theme by identity to tell a redraw from a re-light.
    const COLOUR_THEME: Partial<Theme> = { ...WEB_THEME, lineStyle: colorLineStyle };
    const renderTheme = (): Partial<Theme> =>
      lineStyleId === "colour" ? COLOUR_THEME : WEB_THEME;

    // The same drawing with every colour spelled out, for a file that leaves
    // the page. `background: transparent` emits no backdrop behind the paper,
    // so the sheet is what lands in a slide or an issue (B3.10, B3.11).
    const literalTheme = (): Partial<Theme> => {
      const scheme = resolveScheme(currentSchemeId);
      return {
        ...DEFAULT_THEME,
        fill: scheme.fill,
        front: scheme.front,
        back: scheme.back,
        ink: scheme.ink ?? DEFAULT_THEME.ink,
        boundary: scheme.ink ?? DEFAULT_THEME.boundary,
        background: "transparent",
        lineStyle: lineStyleId === "colour" ? colorLineStyle : DEFAULT_THEME.lineStyle,
      };
    };

    // Re-draws what is on the stage after a choice that changes how it looks
    // rather than which state it shows, so the view and the step stay put.
    function rerenderCurrent(fade: FadeLength | null = null) {
      if (!currentScene()) return;
      if (currentWrites().length > 0) renderStep(currentStep(), true, fade !== null, fade);
      else drawCurrent(true, fade);
    }

    // What the drawing looks like, folded into one menu: the paper it is on,
    // the ink it is drawn with, and whether a buried segment is drawn at all.
    // Each is a choice a reader makes rarely, so the bar carries one word for
    // all three and the panel holds them.
    const viewToggle = root.querySelector<HTMLButtonElement>(".pg-view-toggle");
    const menuSwatch = root.querySelector<HTMLSpanElement>(".pg-menu-swatch");
    const stylesBar = root.querySelector<HTMLDivElement>(".pg-styles");
    const paperNote = root.querySelector<HTMLParagraphElement>(".pg-menu-note");
    const hiddenBox = root.querySelector<HTMLInputElement>(".pg-hidden-lines");
    function updateViewMenu() {
      const scheme = resolveScheme(currentSchemeId);
      // The closed menu carries the paper it chose, so the choice is visible
      // without opening what made it.
      if (menuSwatch) menuSwatch.style.background = scheme.swatch;
      if (viewToggle) viewToggle.title = `Drawn on ${scheme.label}, ${lineStyleId}`;
      if (paperNote) {
        paperNote.textContent = scheme.colorOk
          ? scheme.label
          : `${scheme.label} · monochrome only, every crease colour falls below 2:1 on it`;
      }
      stylesBar?.querySelectorAll<HTMLButtonElement>(".pg-style").forEach((b) => {
        const on = b.dataset.style === lineStyleId;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-pressed", String(on));
        b.disabled = b.dataset.style === "colour" && !scheme.colorOk;
        b.title =
          b.dataset.style === "mono"
            ? "Yoshizawa-Randlett notation, monochrome"
            : scheme.colorOk
              ? "One colour per fold direction"
              : `Not on ${scheme.label}: every crease colour falls below 2:1 on this paper`;
      });
      if (hiddenBox) {
        const flat = currentView === "cp";
        hiddenBox.checked = hiddenMode === "depth";
        hiddenBox.disabled = flat;
        hiddenBox.title = flat
          ? "The crease pattern is one flat sheet: nothing is buried"
          : "Buried crease segments fade with the layers over them";
      }
    }
    const viewsBar = root.querySelector<HTMLDivElement>(".pg-toolbar-views");
    function updateViewTabs() {
      viewsBar?.querySelectorAll<HTMLButtonElement>(".pg-view").forEach((b) => {
        const on = b.dataset.view === currentView;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-selected", String(on));
      });
    }
    viewsBar?.addEventListener("click", (e: MouseEvent) => {
      const b = (e.target as Element).closest<HTMLButtonElement>(".pg-view");
      if (!b) return;
      const v = b.dataset.view as View;
      if (v === currentView) return;
      currentView = v;
      updateViewTabs();
      updateViewMenu();
      // Two views of one state, so the shorter of the two lengths.
      rerenderCurrent("view");
    });
    updateViewTabs();

    stylesBar?.addEventListener("click", (e: MouseEvent) => {
      const b = (e.target as Element).closest<HTMLButtonElement>(".pg-style");
      if (!b || b.disabled) return;
      const style = b.dataset.style === "colour" ? "colour" : "mono";
      if (style === lineStyleId) return;
      lineStyleId = style;
      updateViewMenu();
      rerenderCurrent();
    });
    hiddenBox?.addEventListener("change", () => {
      hiddenMode = hiddenBox.checked ? "depth" : "hide";
      updateViewMenu();
      rerenderCurrent();
    });
    updateViewMenu();

    const swatchBar = root.querySelector<HTMLDivElement>(".pg-swatches");
    if (swatchBar) {
      const activeId = currentSchemeId;
      const buttons = SCHEMES.map((s) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "pg-swatch";
        b.style.background = s.swatch;
        b.title = s.label;
        b.setAttribute("aria-label", s.label);
        b.setAttribute("aria-pressed", String(s.id === activeId));
        b.dataset.schemeId = s.id;
        if (s.id === activeId) b.classList.add("is-active");
        b.addEventListener("click", () => {
          applyScheme(s.id);
          currentSchemeId = s.id;
          // The coloured style falls below 2:1 on kraft and indigo, so a move
          // to one of those papers takes the drawing back to monochrome
          // instead of leaving an unreadable one on screen.
          if (!s.colorOk && lineStyleId === "colour") lineStyleId = "mono";
          updateViewMenu();
          rerenderCurrent();
          swatchBar.querySelectorAll(".pg-swatch").forEach((el) => {
            el.classList.toggle("is-active", el === b);
            el.setAttribute("aria-pressed", String(el === b));
          });
        });
        return b;
      });
      swatchBar.append(...buttons);
    }

    // The document and the step live in the runtime; the stage reads them back
    // through these. Everything derived from them (which frame to draw, which
    // marks still dangle) is the runtime's answer rather than this file's.
    const runtime = createRuntime();
    const renderer = createDomRenderer(canvas);
    const currentScene = (): FoldScene | null => runtime.state.scene;
    // What the stepper walks: the statements that changed the paper (ADR 0026).
    const currentWrites = (): Statement[] => runtime.state.scene?.writes ?? [];
    const currentStep = (): number => runtime.state.step;
    // The step a shared `?s=` names, held until the run behind it produces one
    // (see the bottom of setup).
    let pendingSharedStep: number | null = null;
    // The anchored entity is the runtime's settled selection. While one is
    // set, hover no longer overrides the tooltip (see the mousemove handler
    // below) and the tooltip stops following the cursor. It is cleared by the
    // tooltip's own close (X) button or by a fresh run; a background click
    // leaves it alone.
    //
    // "Pinned" is this view's word for it: what the runtime holds is that the
    // reader settled on this entity, and the tooltip's close button is how
    // this view lets them take it back.
    const pinned = (): EntityRef | null => runtime.state.selection[0] ?? null;
    const pin = (ref: EntityRef | null) => {
      runtime.dispatch({ type: "selection/set", entities: ref ? [ref] : [] });
      relight();
    };
    const hover = (ref: EntityRef | null) => {
      runtime.dispatch({ type: "hover/set", entity: ref });
      relight();
    };
    // Coincident lines: which entities a pixel offers, and whether the reader
    // has been asked. The list and the decision are the module's; the panel
    // that shows them and the highlight over them are this view's
    // (see renderChoice).
    const pick = createPick(runtime);

    // Debug mode: what the program binds, boxed in the source, with a click
    // adding that value to the selection. The spans come out of the document
    // the run answered, so the mode is only offered while the text in the
    // editor is the text that was run; entering it turns the editor read-only,
    // which keeps the two from parting company while it is on.
    //
    // The selection it fills is the core's, the same list a pick in the drawing
    // settles. Neither side knows about the other: both dispatch the same
    // event.
    const offsetsOf = (span: SpanPos): { from: number; to: number } | null => {
      const doc = editor.state.doc;
      if (span.fromLine < 1 || span.fromLine > doc.lines) return null;
      if (span.toLine < span.fromLine || span.toLine > doc.lines) return null;
      const from = doc.line(span.fromLine).from + span.fromCol - 1;
      const to = doc.line(span.toLine).from + span.toCol - 1;
      return to > from && to <= doc.length ? { from, to } : null;
    };

    // Where a target's box goes: the word the statement binds, found inside the
    // statement, which is a name at the head of a binding (`.o = …`) and a name
    // at the end of a write (`fold … as --bd`). A statement that binds a name
    // without spelling it gets no box, which an `apply` a name was exported
    // from is.
    //
    // A write that named nothing has only its own statement to point at, and
    // the box covers it whole.
    const isNameChar = (c: string | undefined): boolean =>
      c !== undefined && /[A-Za-z0-9_\-.!]/.test(c);

    function boxOf(target: DebugTarget): { from: number; to: number } | null {
      const at = target.span === null ? null : offsetsOf(target.span);
      if (at === null) return null;
      if (target.spelling === null) return at;
      const text = editor.state.doc.sliceString(at.from, at.to);
      // The name stands on its own rather than inside a longer one, so the
      // character after it is not one a name is spelled with.
      for (let i = text.indexOf(target.spelling); i >= 0;
           i = text.indexOf(target.spelling, i + 1)) {
        if (!isNameChar(text[i + target.spelling.length])) {
          return { from: at.from + i, to: at.from + i + target.spelling.length };
        }
      }
      return null;
    }

    // A document is in the slot and the editor still holds the text it was
    // evaluated from. A function declaration rather than a const, because the
    // run button asks this while the editor is being built.
    function debugAvailable(): boolean {
      return documentSource !== null && documentSource === editor.state.doc.toString();
    }

    function buildDebugTargets() {
      const scene = currentScene();
      debugList =
        scene === null
          ? []
          : debugTargets(scene).filter((t) => t.span === null || boxOf(t) !== null);
    }

    // The line that declares the paper, under which the values it brings are
    // offered. A program without one puts them at the top, which is where the
    // paper would have stood.
    function paperLine(): number {
      for (let n = 1; n <= editor.state.doc.lines; n++) {
        if (/^\s*paper\b/.test(editor.state.doc.line(n).text)) return n;
      }
      return 1;
    }

    function refreshDebugBoxes() {
      const selection = runtime.state.selection;
      const isOn = (target: DebugTarget) =>
        selection.some((e) => sameEntity(e, target.entity));
      const boxes: DebugBox[] = [];
      // What the sheet brings has no place in the source, so it stands under
      // the paper line instead: the points in one row, the lines in the other,
      // written in the classes the colouring gives those two kinds.
      const points: DebugChip[] = [];
      const lines: DebugChip[] = [];
      debugList.forEach((target, id) => {
        if (target.span === null) {
          if (target.spelling === null) return;
          const chip = { id, text: target.spelling, on: isOn(target) };
          if (target.spelling.startsWith("--")) lines.push({ ...chip, cls: "bel-line" });
          else points.push({ ...chip, cls: "bel-point" });
          return;
        }
        const at = boxOf(target);
        if (at === null) return;
        boxes.push({ ...at, id, on: isOn(target) });
      });
      setDebugBoxesOn(editor, boxes);
      const rows = [points, lines];
      setDebugChipsOn(
        editor,
        rows.some((row) => row.length > 0)
          ? { line: paperLine(), rows, note: "; prelude values" }
          : null,
      );
    }

    // A click takes a value in or out, and several stand at once. The order of
    // the list follows the order of the clicks, which is the order the drawing
    // lights them in.
    function pickDebugTarget(id: number) {
      const target = debugList[id];
      if (target === undefined) return;
      const entities = toggleEntity(runtime.state.selection, target.entity);
      runtime.dispatch({ type: "selection/set", entities });
      relight();
      refreshDebugBoxes();
    }

    function updateDebugButton() {
      const on = debugIsOn(editor.state);
      debugBtn!.disabled = !on && !debugAvailable();
      debugBtn!.classList.toggle("is-active", on);
      debugBtn!.setAttribute("aria-pressed", on ? "true" : "false");
    }

    // Leaving the mode leaves the selection standing and takes the boxes away.
    function setDebugOn(on: boolean) {
      if (on && !debugAvailable()) return;
      if (on) buildDebugTargets();
      setDebugModeOn(editor, on);
      if (on) refreshDebugBoxes();
      updateDebugButton();
    }

    debugBtn.addEventListener("click", () => setDebugOn(!debugIsOn(editor.state)));
    // A selection settled in the drawing lights its box too, so the two
    // sides show one answer.
    runtime.subscribe(() => {
      if (debugIsOn(editor.state)) refreshDebugBoxes();
    });

    // A scene with statements has a timeline, and every step of it goes
    // through the occlusion pipeline, step 0's flat sheet included. A scene
    // without them has one drawing, the crease pattern. So the statement list
    // doubles as the view accessor, with no separate mode flag.
    const inFoldedView = () => currentWrites().length > 0;
    // beloch:inspect carries the FINAL fold's geometry only; the stepper renders
    // a different (partial) placement per step, so any inspect-geometry path
    // (proximity detection, ghosting hidden segments) is valid only on the last
    // step. Off it, hover falls back to the per-step DOM data-crease-id.
    const onFinalStep = () => currentWrites().length === 0 || currentStep() === currentWrites().length;

    // Tolerance shared by proximity detection and the hidden-segment test,
    // in SVG user units (~px at 1:1 zoom). pointSegDist comes from
    // pick-visibility.ts, which measures against it too.
    const EPS = 6;
    // Every line the renderer drew, as [x1,y1,x2,y2] in SVG user space.
    // Marks sit in it beside creases (HIT_SELECTOR's set): they carry a
    // crease id and read to the user as flat creases, so they are pickable
    // the same way. The `.bel-hit` twins stay out, they only duplicate
    // endpoints that are already here.
    const drawnCoords = (): DrawnLine[] =>
      Array.from(canvas.querySelectorAll(HIT_SELECTOR)).map(
        (el) =>
          [
            Number(el.getAttribute("x1")),
            Number(el.getAttribute("y1")),
            Number(el.getAttribute("x2")),
            Number(el.getAttribute("y2")),
          ] as const,
      );
    // The stack picker points at one segment of a bundle rather than at the
    // bundle, so it lights by geometry and draws its own dashed ghost where
    // the drawing has no line for that segment. Everything a reader points at
    // or settles on goes through the runtime instead (see `pin` and `hover`).
    //
    // inspect geometry describes the final fold, so a ghost is placed only on
    // the drawing of that step; anywhere else it would sit over a different
    // placement of the paper.
    const SVG_NS = "http://www.w3.org/2000/svg";
    const ghostSegment = (ax: number, ay: number, bx: number, by: number) => {
      const svg = canvas.querySelector("svg");
      if (!svg || !onFinalStep()) return;
      const l = document.createElementNS(SVG_NS, "line");
      l.setAttribute("x1", String(ax));
      l.setAttribute("y1", String(ay));
      l.setAttribute("x2", String(bx));
      l.setAttribute("y2", String(by));
      l.setAttribute("class", GHOST_CLASS);
      svg.appendChild(l);
    };

    // Every place the program NAMES the anchored entities, out of
    // beloch:references: the operands of a construction, the arguments of a
    // flatten, a filter over the bundle. The emitter resolved each of those
    // mentions, so this needs no guessing at the text.
    const markRefsFor = (ents: EntityRef[]) => {
      const scene = currentScene();
      setRefSpansOn(editor, scene ? refSpansFor(scene, ents) : []);
    };
    // The runtime's own highlight comes back with every drawing the renderer
    // makes. The candidates of an open choice do not: they are what the reader
    // is being asked about rather than an answer, so the core holds no
    // selection for them and this view lights them itself.
    const reapplyChoiceHl = () => {
      const scene = currentScene();
      if (!scene || !pick.state.open || pick.state.candidates.length === 0) return;
      lightEntities(canvas, scene, pick.state.candidates);
    };
    // Resolves the pointer target to an EntityRef: lookupEntity first
    // (crease/face/vertex, attr-based); if that's null AND the target is a
    // crease-layer line or its `.bel-hit` twin, fall back to geometry — this
    // is the only way to identify a paper-boundary line, which carries no
    // data-crease-id at all (task 9).
    const resolveRef = (target: Element): EntityRef | null => {
      const ref = lookupEntity(target);
      if (ref) return ref;
      const scene = currentScene();
      if (!scene?.inspect) return null;
      const line = target.closest(`line[data-kind="crease"], .${HIT_CLASS}`);
      if (!line) return null;
      const x1 = Number(line.getAttribute("x1"));
      const y1 = Number(line.getAttribute("y1"));
      const x2 = Number(line.getAttribute("x2"));
      const y2 = Number(line.getAttribute("y2"));
      const layout = sceneLayout(scene);
      const name = edgeOfLine(scene.inspect.edges, x1, y1, x2, y2, layout);
      return name ? { kind: "edge", name } : null;
    };

    // The card says what a click in the drawing settled, at the place that
    // was clicked. `cardAnchor` is that place in the SVG's own user space, so
    // it holds still on the paper while the stage pans and zooms, and
    // `cardEntity` is what the card stands for: the one settled entity, or
    // null while it offers the lines a pixel holds. Hovering lights the
    // drawing and nothing more; a selection of several, which the debug mode
    // makes, has the editor to show it and takes no card.
    let cardAnchor: Vec2 | null = null;
    let cardEntity: EntityRef | null = null;

    function hideCard() {
      card!.hidden = true;
      card!.innerHTML = "";
      cardAnchor = null;
      cardEntity = null;
    }

    function placeCard() {
      if (card!.hidden || !cardAnchor) return;
      const ctm = canvas!.querySelector("svg")?.getScreenCTM();
      if (!ctm) return;
      const at = new DOMPoint(cardAnchor[0], cardAnchor[1]).matrixTransform(ctm);
      const box = result!.getBoundingClientRect();
      const place = cardPlacement(at.x - box.left, at.y - box.top, box.width, box.height);
      card!.style.left = place.left;
      card!.style.top = place.top;
      card!.style.transform = place.transform;
    }

    function showCard(html: string, anchor: Vec2) {
      card!.innerHTML = html + `<button type="button" class="pg-card-close" aria-label="Clear selection">✕</button>`;
      card!.hidden = false;
      cardAnchor = anchor;
      placeCard();
    }

    // The line of the program that made an entity: a crease by its span, a
    // named value by the statement that binds it.
    function lineOfEntity(scene: FoldScene, ref: EntityRef): number | null {
      const line = sourceLineOf(scene, ref);
      if (line !== null) return line;
      return debugTargets(scene).find((t) => sameEntity(t.entity, ref))?.span?.fromLine ?? null;
    }

    // One segment is the whole bundle and needs no rows; several each get one,
    // which is the stack picker.
    function segmentRowsHtml(ref: EntityRef): string {
      const insp = currentScene()?.inspect;
      if (!insp) return "";
      const rows =
        ref.kind === "crease" ? segmentRows(insp, ref.creaseId, inFoldedView())
        : ref.kind === "edge" ? edgeSegmentRows(insp, ref.name)
        : [];
      if (rows.length < 2) return "";
      const owner =
        ref.kind === "crease" ? `data-pick-crease="${escapeHtml(ref.creaseId)}"`
        : ref.kind === "edge" ? `data-pick-edge="${escapeHtml(ref.name)}"`
        : "";
      return rows
        .map((r, n) => `<div class="seg" data-pick-seg="${r.index}" ${owner}>segment ${n + 1} · ${escapeHtml(r.assignment)}</div>`)
        .join("");
    }

    function renderCard(ref: EntityRef, anchor: Vec2) {
      const scene = currentScene();
      const summary = scene?.inspect ? hoverSummary(ref, scene.inspect) : null;
      if (!scene || !summary) {
        hideCard();
        return;
      }
      const c = cardContent(summary, lineOfEntity(scene, ref), runState.answered ?? documentSource);
      showCard(
        `<div class="pg-card-body">` +
          `<div class="pg-card-head"><span class="pg-card-name">${escapeHtml(c.name)}</span>` +
          (c.line === null ? "" : `<span>line ${c.line}</span>`) +
          `</div>` +
          (c.text === null ? "" : `<div class="pg-card-text">${escapeHtml(c.text)}</div>`) +
          `</div>`,
        anchor,
      );
      card!.insertAdjacentHTML("beforeend", segmentRowsHtml(ref));
      cardEntity = ref;
    }

    // After the drawing is redrawn the settled entity may stand elsewhere, as
    // it does when a step folds the paper under it. The card moves to the
    // point of that entity's lit drawing nearest to where it stood, and goes
    // away while nothing of it is drawn; the selection stays either way.
    function reanchorCard() {
      if (card!.hidden || !cardAnchor) return;
      if (cardEntity === null) {
        placeCard();
        return;
      }
      const near = nearestLitPoint(cardAnchor);
      if (!near) {
        hideCard();
        return;
      }
      cardAnchor = near;
      placeCard();
    }

    function nearestLitPoint([px, py]: Vec2): Vec2 | null {
      let best: Vec2 | null = null;
      let bestD = Infinity;
      canvas!.querySelectorAll<SVGGraphicsElement>(`.${HL_CLASS}`).forEach((el) => {
        const p = nearestOn(el, px, py);
        const d = Math.hypot(p[0] - px, p[1] - py);
        if (d < bestD) {
          bestD = d;
          best = p;
        }
      });
      return best;
    }

    // The point of a drawn element nearest to (px, py): the foot of the
    // perpendicular on a line, the centre of anything else.
    function nearestOn(el: SVGGraphicsElement, px: number, py: number): Vec2 {
      if (el.tagName === "line") {
        const ax = Number(el.getAttribute("x1")), ay = Number(el.getAttribute("y1"));
        const bx = Number(el.getAttribute("x2")), by = Number(el.getAttribute("y2"));
        const dx = bx - ax, dy = by - ay;
        const len2 = dx * dx + dy * dy;
        const t = len2 === 0 ? 0 : Math.max(0, Math.min(1, ((px - ax) * dx + (py - ay) * dy) / len2));
        return [ax + t * dx, ay + t * dy];
      }
      const b = el.getBBox();
      return [b.x + b.width / 2, b.y + b.height / 2];
    }

    // Where a key press on a crease puts the card, having no pointer to go by.
    function middleOf(el: SVGGraphicsElement): Vec2 {
      if (el.tagName === "line") {
        return [
          (Number(el.getAttribute("x1")) + Number(el.getAttribute("x2"))) / 2,
          (Number(el.getAttribute("y1")) + Number(el.getAttribute("y2"))) / 2,
        ];
      }
      const b = el.getBBox();
      return [b.x + b.width / 2, b.y + b.height / 2];
    }

    function closeAnchor() {
      pick.close();
      hideCard();
      pin(null);
      setRefSpansOn(editor, []);
    }

    // A selection the card no longer stands for takes the card with it: the
    // debug mode adding a second value, or a run filling the slot anew.
    runtime.subscribe(() => {
      if (cardEntity === null) return;
      const sel = runtime.state.selection;
      if (sel.length !== 1 || !sameEntity(sel[0]!, cardEntity)) hideCard();
    });

    // Distinct crease/edge entities whose line lies under a screen point.
    // Multiple lines (e.g. a construction crease and a paper edge) can project
    // onto the SAME table coords in the folded view; elementsFromPoint returns
    // every stacked element there (each crease line has a wide transparent
    // .bel-hit twin, so the hit is forgiving), and we resolve + dedupe them.
    // Faces/vertices are ignored — this is about overlapping LINES; a bare
    // face click still goes through resolveRef in the click handler.
    const entityKey = (r: EntityRef): string =>
      r.kind === "crease" ? `c:${r.creaseId}`
      : r.kind === "edge" ? `e:${r.name}`
      : r.kind === "face" ? `f:${r.index}`
      : r.kind === "construction" ? `l:${r.name}`
      : `v:${r.index}`;
    // Map a screen (client) point into the SVG's own user space, where the
    // rendered line coords and makeLayout output live. getScreenCTM folds in
    // the canvas pan/zoom CSS transform, so inverting it is exact at any zoom.
    const svgLocalPoint = (clientX: number, clientY: number): Vec2 | null => {
      const svg = canvas.querySelector("svg");
      const ctm = svg?.getScreenCTM();
      if (!svg || !ctm) return null;
      const pt = svg.createSVGPoint();
      pt.x = clientX;
      pt.y = clientY;
      const l = pt.matrixTransform(ctm.inverse());
      return [l.x, l.y];
    };
    // Every distinct inspect entity (crease OR edge) whose segment passes
    // within EPS of the point AND is drawn there. Identity comes from the
    // inspect DATA by proximity, which surfaces COINCIDENT entities the
    // renderer collapses: when creases fold onto each other / onto a paper edge
    // they share table coords and dedupe to one <line>, and segments of
    // different lengths (a full diagonal vs. a short merged piece) still count
    // as long as the click sits on them. ≥2 ⇒ the coincident-line chooser.
    // Visibility then comes from the drawing, via segmentDrawnAt
    // (pick-visibility.ts), so a segment buried under a higher layer is
    // pickable exactly when the hidden-edge control draws it.
    // (pointSegDist + EPS are defined with the highlight helpers above.)
    const lineEntitiesAtPoint = (clientX: number, clientY: number): EntityRef[] => {
      const insp = currentScene()?.inspect;
      const local = svgLocalPoint(clientX, clientY);
      // Final-fold geometry only; off the last step, hover/click fall back to
      // the per-step DOM resolver (data-crease-id) — no proximity, no chooser.
      const scene = currentScene();
      if (!insp || !scene || !local || !onFinalStep()) return [];
      const [px, py] = local;
      const layout = sceneLayout(scene);
      const drawn = drawnCoords();
      const seen = new Set<string>();
      const out: EntityRef[] = [];
      const check = (ref: EntityRef, segs: { table: [Vec2, Vec2] }[]) => {
        for (const s of segs) {
          const ax = layout.tx(s.table[0][0]), ay = layout.ty(s.table[0][1]);
          const bx = layout.tx(s.table[1][0]), by = layout.ty(s.table[1][1]);
          if (pointSegDist(px, py, ax, ay, bx, by) > EPS) continue;
          // The inspect data has no occlusion, so it offers segments buried
          // under a higher layer, which `hidden: "hide"` draws nothing for.
          // A pick has to land on a line the drawing shows; the bundle's
          // other segments keep their chance, hence `continue`.
          if (!segmentDrawnAt([ax, ay], [bx, by], px, py, drawn, EPS)) continue;
          const k = entityKey(ref);
          if (!seen.has(k)) { seen.add(k); out.push(ref); }
          return;
        }
      };
      for (const [cid, c] of Object.entries(insp.creases)) check({ kind: "crease", creaseId: cid }, c.segments);
      for (const [name, e] of Object.entries(insp.edges)) check({ kind: "edge", name }, e.segments);
      return out;
    };

    // Settle one entity and put the card at `anchor`: shared tail of a
    // direct click, a key press on a crease and a pick from the lines a pixel
    // offered.
    const anchorEntity = (ref: EntityRef, anchor: Vec2) => {
      pick.close();
      pin(ref);
      markRefsFor([ref]);
      renderCard(ref, anchor);
      const scene = currentScene();
      const ln = scene ? sourceLineOf(scene, ref) : null;
      // Mark the statement that built this entity.
      if (ln) setStepLineOn(editor, ln);
    };

    // The lines a pixel holds, offered as rows in the card at the click.
    // Picking a row settles that one where the card stands; pointing at a row
    // lights its bundle.
    const renderChoice = (ents: EntityRef[], anchor: Vec2) => {
      const insp = currentScene()?.inspect;
      if (!insp) return;
      showCard(
        `<div class="pg-card-body"><div class="pg-card-head">${ents.length} lines here</div></div>`,
        anchor,
      );
      card!.insertAdjacentHTML(
        "beforeend",
        ents
          .map((r, i) => {
            const t = hoverSummary(r, insp)?.title ?? entityKey(r);
            return `<div class="seg" data-choice-idx="${i}">${escapeHtml(t)}</div>`;
          })
          .join(""),
      );
    };

    // The reverse direction of the click→line jump above: moving the
    // editor cursor onto a source line outlines every SVG crease segment
    // whose provenance span covers that line (read-only, no pinning).
    const highlightCreasesOnLine = (line: number) => {
      const scene = currentScene();
      clearHighlight(canvas);
      if (!scene) return;
      lightEntities(canvas, scene, entitiesAtLine(scene, line));
    };

    // Hover lights what is under the pointer and says nothing else; the card
    // is for a click. A settled selection suppresses it entirely.
    // isDragging() (not wasDrag()) is the right guard here — it reflects
    // whether a pan is happening RIGHT NOW, so hover resumes as soon as the
    // drag actually ends rather than staying suppressed until the next
    // pointerdown (see createPanZoom).
    result.addEventListener("mousemove", (e: MouseEvent) => {
      if (pinned() || pick.state.open || panZoom.isDragging()) return;
      if (card.contains(e.target as Node)) return;
      // Same proximity detection as the click, so hover and click agree.
      const outcome = pick.report(lineEntitiesAtPoint(e.clientX, e.clientY), "hover");
      if (outcome.kind === "several") {
        // The candidates are not a selection, so the drawing is lit from here.
        hover(null);
        const scene = currentScene();
        if (scene) lightEntities(canvas, scene, outcome.candidates);
        return;
      }
      hover(outcome.kind === "one" ? outcome.entity : resolveRef(e.target as Element));
    });
    // A click settles what is under it and puts the card where it landed;
    // only the card's close button clears it (see closeAnchor). Clicking empty
    // paper (no entity under the cursor) is a no-op rather than clearing an
    // existing answer.
    // Pan gestures must not register as a click here — wasDrag() is only
    // true after the pointer actually moved past the pan threshold during
    // this press.
    result.addEventListener("click", (e: MouseEvent) => {
      if (panZoom.wasDrag()) return;
      if (card.contains(e.target as Node)) return;
      const at = svgLocalPoint(e.clientX, e.clientY);
      if (!at) return;
      // Multiple distinct lines stacked at the click → anchor the chooser
      // (same content the hover was already previewing). The module clears the
      // selection for it: the reader has been asked and has not answered.
      const outcome = pick.report(lineEntitiesAtPoint(e.clientX, e.clientY), "settle");
      if (outcome.kind === "several") {
        relight();
        const scene = currentScene();
        if (scene) lightEntities(canvas, scene, outcome.candidates);
        markRefsFor(outcome.candidates);
        renderChoice(outcome.candidates, at);
        return;
      }
      const ref = outcome.kind === "one" ? outcome.entity : resolveRef(e.target as Element);
      if (!ref) return;
      anchorEntity(ref, at);
    });

    // Picking a segment row (anchored crease view only) highlights the SVG
    // line(s) it corresponds to by GEOMETRY, not a data-seg index (there is
    // none — dropped in Task 4). The segment's `table` endpoints are in the
    // evaluator's table space; a rendered crease `<line>`'s x1/y1/x2/y2 are
    // in SVG pixel space, produced by render-scene.ts as
    // `mx(tx(x)), ty(y)` off the layout `sceneLayout(scene)` builds
    // (see layout.ts + render-scene.ts) — `mx` only differs from `tx` for
    // `view: "bottom"`, which this Playground never passes, so plain
    // `tx`/`ty` is the exact same transform.
    // Running the segment's table endpoints through that SAME layout puts
    // both sides of the comparison in the rendered pixel space. A segment
    // fully occluded by a layer above it draws no line at all while the
    // hidden-edge control is off — zero matches then, and nothing
    // highlights, the honest outcome for a layer this top-view projection
    // can't show. With the control on, the buried run is drawn and carries
    // `data-occluded`, so it matches like any other segment.
    // Hovering OR clicking a row narrows the highlight to just that segment
    // (removing it from the rest of the bundle); a click additionally
    // stopPropagation()s so it doesn't bubble into result's click handler
    // above and re-anchor on whatever's under the tooltip (Task 7 already
    // learned this).
    //
    // Task 9: a row now comes from either a crease bundle (`data-pick-crease`
    // — re-identify candidate lines by `[data-crease-id]`, via
    // bundleElements) or a paper-boundary edge bundle (`data-pick-edge` — no
    // id to select by, so every crease-layer line is a candidate, narrowed
    // by geometry same as the single-segment match below).
    const pickSegment = (row: HTMLElement) => {
      const cid = row.dataset.pickCrease;
      const eid = row.dataset.pickEdge;
      const segIndex = Number(row.dataset.pickSeg);
      const s = cid
        ? currentScene()?.inspect?.creases[cid]?.segments[segIndex]
        : eid
          ? currentScene()?.inspect?.edges[eid]?.segments[segIndex]
          : undefined;
      const scene = currentScene();
      if (!scene || !s || (!cid && !eid)) return;
      const layout = sceneLayout(scene);
      const p0: Vec2 = [layout.tx(s.table[0][0]), layout.ty(s.table[0][1])];
      const p1: Vec2 = [layout.tx(s.table[1][0]), layout.ty(s.table[1][1])];
      clearHighlight(canvas);
      const candidates = cid ? bundleElements(canvas, cid) : Array.from(canvas.querySelectorAll(CREASE_SELECTOR));
      let matched = false;
      candidates.forEach((el) => {
        const x1 = Number(el.getAttribute("x1"));
        const y1 = Number(el.getAttribute("y1"));
        const x2 = Number(el.getAttribute("x2"));
        const y2 = Number(el.getAttribute("y2"));
        if (segMatchesLine(p0, p1, x1, y1, x2, y2)) {
          el.classList.add(HL_CLASS);
          matched = true;
        }
      });
      // Picked an occluded segment (no rendered line) → ghost it so it shows.
      if (!matched) ghostSegment(p0[0], p0[1], p1[0], p1[1]);
    };
    // The card sits inside the stage, so a press on it must not start a pan.
    card.addEventListener("pointerdown", (e: PointerEvent) => e.stopPropagation());
    card.addEventListener("click", (e: MouseEvent) => {
      const target = e.target as Element;
      if (target.closest(".pg-card-close")) {
        e.stopPropagation();
        closeAnchor();
        return;
      }
      // Chooser row → drill into that overlapping entity, at the chooser's spot.
      const choice = target.closest<HTMLElement>("[data-choice-idx]");
      if (choice) {
        e.stopPropagation();
        const at = cardAnchor;
        const ref = pick.choose(Number(choice.dataset.choiceIdx));
        if (ref && at) anchorEntity(ref, at);
        return;
      }
      const row = target.closest<HTMLElement>("[data-pick-seg]");
      if (!row) return;
      e.stopPropagation();
      pickSegment(row);
    });
    card.addEventListener("mouseover", (e: MouseEvent) => {
      const target = e.target as Element;
      const row = target.closest<HTMLElement>("[data-pick-seg]");
      if (row) {
        pickSegment(row);
        return;
      }
      // Previewing a chooser row highlights that entity's whole bundle.
      const choice = target.closest<HTMLElement>("[data-choice-idx]");
      if (choice) {
        const ref = pick.state.candidates[Number(choice.dataset.choiceIdx)];
        const scene = currentScene();
        if (!ref || !scene) return;
        clearHighlight(canvas);
        lightEntities(canvas, scene, [ref]);
      }
    });

    // Prev/next just walk the clamped index; renderStep re-clamps and keeps
    // the nav buttons' disabled state in sync (see updateStepsUI).
    stepPrev.addEventListener("click", () => renderStep(currentStep() - 1, true, true));
    stepNext.addEventListener("click", () => renderStep(currentStep() + 1, true, true));

    // A diagnostic goes beside the drawing, never in its place: the last valid
    // drawing is what the reader is holding the message against, and wiping it
    // takes that away at the moment it is needed (B3.5). The line the
    // evaluator named is marked in the editor at the same time.
    //
    // The alert region is written before it is shown, and hidden before it is
    // emptied. A screen reader announces whatever lands in a live region, so
    // emptying a visible one reads the clearing out as a message of its own.
    const showDiagnostic = (message: string, where: string, line: number | null) => {
      errorBox!.innerHTML = `<span class="pg-error-where">${escapeHtml(where)}</span>${escapeHtml(message)}`;
      errorBox!.hidden = false;
      setErrorLineOn(editor, line);
    };
    const clearDiagnostic = () => {
      errorBox!.hidden = true;
      errorBox!.textContent = "";
      setErrorLineOn(editor, null);
    };
    const showInfo = (message: string) => showDiagnostic(message, "note", null);
    const showError = (message: string, line: number | null = null) =>
      showDiagnostic(message, line === null ? "error" : `line ${line}`, line);
    // keepView leaves the current pan/zoom transform in place — the canvas
    // element (the transform target) survives innerHTML swaps, so stepping
    // through the timeline keeps the user's framing. A fresh run passes
    // keepView=false to re-fit the newly-parsed paper.
    // What the runtime says to draw, drawn, and nothing else. The renderer
    // compares this against what it last drew, so an event that only moves the
    // highlight re-lights the drawing on screen rather than rebuilding it.
    // That is what makes this cheap enough for every mouse move.
    function relight(fade: FadeLength | null = null) {
      const scene = currentScene();
      if (!scene) return;
      const command = renderCommand(runtime.state, { view: currentView, hidden: hiddenMode });
      if (!command) return;
      renderer.draw(scene, command, { theme: renderTheme(), fade });
    }

    const drawCurrent = (keepView = false, fade: FadeLength | null = null) => {
      if (!currentScene()) return;
      // The renderer owns the markup and the hit targets over it. What stays
      // here is the stage around the drawing.
      relight(fade);
      makeCreasesReachable();
      reapplyChoiceHl();
      // A settled answer survives a step change, and its card follows it.
      reanchorCard();
      if (!keepView) panZoom.reset();
      panZoom.setEnabled(true);
      resetBtn.hidden = false;
    };

    // Rebuilds the scrubber's dots for a freshly-parsed set of writes (called
    // once per successful run, not per step-click). The timeline has n+1 stops:
    // index 0 is the flat starting sheet, 1..n each write. Hidden when there is
    // nothing to navigate, which a program that folds nothing asks for.
    function buildStepsUI(writes: Statement[]) {
      const n = writes.length;
      stepDots!.innerHTML = "";
      if (n < 1) {
        stepsBar!.hidden = true;
        return;
      }
      stepsBar!.hidden = false;
      for (let i = 0; i <= n; i++) {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "pg-step-dot";
        dot.setAttribute("aria-label", i === 0 ? "Starting paper" : `Step ${i} of ${n}`);
        dot.setAttribute("aria-current", "false");
        dot.addEventListener("click", () => renderStep(i, true, true));
        stepDots!.appendChild(dot);
      }
    }

    // Clears the scrubber + gutter marker so a stale scene from a previous
    // multi-step run can't linger (and stay clickable) once a later run
    // doesn't produce a fresh multi-step scene of its own. The document
    // itself is already the new one: filling the slot took the selection, the
    // hover and any open choice with it, and the modules watch the slot
    // themselves.
    function clearStepsUI() {
      hideCard();
      clearHighlight(canvas!);
      setRefSpansOn(editor, []);
      stepsBar!.hidden = true;
      setStepLineOn(editor, null);
    }

    // Cheap per-step-change update: toggles the active dot + label text,
    // without touching event listeners (buildStepsUI owns those).
    function updateStepsUI(i: number, writes: Statement[]) {
      const n = writes.length;
      stepDots!.querySelectorAll<HTMLButtonElement>(".pg-step-dot").forEach((dot, idx) => {
        dot.classList.toggle("is-active", idx === i);
        dot.classList.toggle("is-past", idx < i);
        dot.setAttribute("aria-current", idx === i ? "true" : "false");
      });
      stepDots!.style.setProperty("--pg-progress", n > 0 ? `${(i / n) * 100}%` : "0%");
      // The statement the drawing stands for, in the words the program used
      // for it. It comes out of the source the evaluator answered rather than
      // the text in the editor, because the two part company on the next
      // keystroke and the drawing belongs to the run.
      const line = i === 0 ? null : writes[i - 1]?.sourceLine ?? null;
      const said = line === null ? null : (runState.answered?.split("\n")[line - 1] ?? null);
      stepLabel!.textContent =
        i === 0 ? `0/${n} · empty paper` : `${i}/${n} · ${said?.trim() || `step ${i}`}`;
      stepPrev!.disabled = i <= 0;
      stepNext!.disabled = i >= n;
    }

    // Client-side-only re-render of one statement of the already-parsed
    // scene — no worker round-trip, since one eval already returned every
    // frame and every statement's own mark geometry. A fold-kind statement
    // just re-renders its backdrop frame; a mark-kind statement re-renders
    // the SAME backdrop (marks don't fold anything) with its own mark
    // overlaid.
    // `animate` is what the reader's click carries in: a step reached by
    // clicking crossfades from the step it left, a step rendered because a run
    // just finished appears outright.
    // `fadeOverride` is for a swap that is not a step change at all: switching
    // the tab, or the line style, shows the same state drawn differently.
    function renderStep(i: number, keepView = true, animate = false, fadeOverride: FadeLength | null = null) {
      const scene = currentScene();
      const writes = currentWrites();
      if (!scene || writes.length === 0) return;
      // Out-of-range steps are the runtime's to clamp, so a shared link with a
      // step from a longer program lands on the last one.
      runtime.dispatch({ type: "step/to", index: i });
      const clamped = currentStep();
      const stmt = clamped === 0 ? null : writes[clamped - 1]!;
      // A mark folds nothing, so it changes the view rather than the paper. A
      // crease pattern never folds either: the sheet stays flat and gains a
      // line. Step 0 arrives at the sheet, which is no fold either.
      const stepFade: FadeLength =
        currentView === "cp" || stmt === null || stmt.kind !== "fold" ? "view" : "fold";
      try {
        drawCurrent(keepView, fadeOverride ?? (animate ? stepFade : null));
        setStepLineOn(editor, stmt === null ? null : stmt.sourceLine);
      } catch (err) {
        showError(`Render error: ${err instanceof Error ? err.message : String(err)}`);
        return;
      }
      updateStepsUI(clamped, writes);
      updateExportPanel();
    }

    // A document is in the slot: build the stage around it. The evaluator
    // calls this after a run, and the seed path below after parsing the FOLD
    // the build embedded, so both build the scrubber the same way.
    function showDocument(scene: FoldScene) {
      clearStepsUI();
      // The spans in the document point into the source it was evaluated from,
      // which is the editor's text at this moment: a run answers the text that
      // was sent, and the seed path parses the FOLD the build made of the text
      // the pane opened with.
      documentSource = runState.answered ?? editor.state.doc.toString();
      if (debugIsOn(editor.state)) {
        buildDebugTargets();
        refreshDebugBoxes();
      }
      updateDebugButton();
      if (scene.writes.length > 0) {
        buildStepsUI(scene.writes);
        const target = pendingSharedStep;
        pendingSharedStep = null;
        renderStep(target ?? scene.writes.length, false);
      } else {
        // No fold and no mark statement: one drawing, no timeline.
        drawCurrent();
      }
    }

    // A FOLD document computed at build time — pure @beloch/scene +
    // @beloch/render-svg, no wasm involved.
    function applyFold(fold: unknown) {
      try {
        const scene = parseFold(fold as object);
        runtime.dispatch({ type: "document/set", scene });
        showDocument(scene);
      } catch (err) {
        showError(`Render error: ${err instanceof Error ? err.message : String(err)}`);
      }
    }

    // The words for what the evaluator reports. It says what happened in
    // kinds, because a package has no reader; the sentences are this view's.
    function sayDiagnostic(diagnostic: Diagnostic) {
      switch (diagnostic.kind) {
        case "program":
          showError(diagnostic.message, diagnostic.line);
          return;
        case "native":
          showInfo(
            "This expression needs native evaluation (an irrational number via √/∛ beyond the browser fragment).",
          );
          return;
        case "timeout":
          showError("Evaluation aborted (timeout).");
          return;
        case "backend":
          showError(`Worker error: ${diagnostic.message}`);
          return;
        case "protocol":
          showError(`Invalid response from the evaluator: ${diagnostic.message}`);
          return;
        case "document":
          showError(`Render error: ${diagnostic.message}`);
      }
    }

    // Source to document. The phases, the queue behind a runtime that has not
    // arrived, both limits and the evaluator's envelope are the module's; the
    // Worker it drives is this page's, and a VS Code preview would hand it a
    // subprocess instead.
    const evaluator = createEvaluator({
      runtime,
      spawn: (events) => {
        const worker = new Worker("/beloch/eval-worker.js");
        worker.onmessage = (
          e: MessageEvent<{ raw?: string; ready?: boolean; loaded?: number; total?: number }>,
        ) => {
          // Transfer progress, while the runtime is still on its way.
          if (e.data.total !== undefined && e.data.loaded !== undefined) {
            events.progress(e.data.total > 0 ? e.data.loaded / e.data.total : null);
            return;
          }
          // The worker announces its instantiated wasm runtime
          // (public/beloch/eval-worker.js).
          if (e.data.ready) {
            events.ready();
            return;
          }
          events.answer(e.data.raw ?? "");
        };
        worker.onerror = (e: ErrorEvent) => events.failed(e.message);
        return {
          evaluate: (source: string) => worker.postMessage(source),
          terminate: () => worker.terminate(),
        };
      },
      host: {
        document: showDocument,
        diagnostic: sayDiagnostic,
        changed: (state) => {
          runState = state;
          updateRunButtonState();
        },
      },
    });

    function run() {
      // A run in flight keeps its diagnostic: the reader is still holding it
      // against the drawing, and this click adds nothing (the evaluator drops
      // it too).
      if (runState.running) return;
      // The standing diagnostic describes the previous run; this one answers
      // for itself. The drawing stays either way.
      clearDiagnostic();
      evaluator.run(editor.state.doc.toString());
    }

    // If a seed FOLD was embedded at build time, parse+render it right away
    // — no wasm, no Run click, works even while the eval Worker hasn't
    // (and for `lazy` instances, won't yet) booted. Wraps the pre-rendered
    // SSR `seed` SVG with a live scene, so scrubbing works immediately.
    const seedFoldTag = root.querySelector<HTMLScriptElement>("script.pg-seed-fold");
    const seedFoldRaw = seedFoldTag?.textContent?.trim() ?? "";
    if (seedFoldRaw) {
      try {
        applyFold(JSON.parse(seedFoldRaw));
      } catch {
        // Build-time-trusted JSON; a parse failure here is a build bug, not
        // a user error — leave the SSR seed SVG showing rather than error.
      }
    }

    // ── Export ───────────────────────────────────────────────────────────
    // What leaves the page is what the render path produces, re-rendered from
    // the scene rather than lifted out of the DOM: the stage's copy carries
    // hit lines, highlight classes and colours that are CSS variables, none of
    // which mean anything in a file (B3.10). The trigger sits in the quiet
    // zone beside the reset button, so nothing is laid over the drawing while
    // the panel is shut (B3.11).
    function updateExportPanel() {
      if (!exportStepLine) return;
      const n = currentWrites().length;
      exportStepLine.textContent = n > 0 ? `step ${currentStep()} of ${n}` : "crease pattern";
    }

    const say = (text: string) => {
      if (exportSaid) exportSaid.textContent = text;
    };

    // One menu open at a time. A panel is a choice in progress, and two of
    // them standing open would be two.
    const menus: { toggle: HTMLButtonElement; panel: HTMLElement }[] = [];
    const closeMenus = () => {
      for (const m of menus) {
        m.panel.hidden = true;
        m.toggle.setAttribute("aria-expanded", "false");
      }
    };
    const wireMenu = (toggle: HTMLButtonElement, panel: HTMLElement, opened?: () => void) => {
      menus.push({ toggle, panel });
      toggle.addEventListener("click", () => {
        const opening = panel.hidden;
        closeMenus();
        if (!opening) return;
        panel.hidden = false;
        toggle.setAttribute("aria-expanded", "true");
        opened?.();
      });
      // Escape takes the question back and leaves the reader on the word that
      // asked it.
      const onEscape = (e: KeyboardEvent) => {
        if (e.key !== "Escape" || panel.hidden) return;
        closeMenus();
        toggle.focus();
      };
      toggle.addEventListener("keydown", onEscape);
      panel.addEventListener("keydown", onEscape);
    };
    wireMenu(exportToggle, exportPanel, () => {
      updateExportPanel();
      say("");
    });
    const viewPanel = root.querySelector<HTMLElement>(".pg-view-panel");
    if (viewToggle && viewPanel) wireMenu(viewToggle, viewPanel);
    // Clicking anywhere else shuts what is open: a menu covers the card only
    // while it is in use. Another card's menu on the same page is somewhere
    // else, which is why this asks about this card first.
    document.addEventListener("click", (e: MouseEvent) => {
      const t = e.target as Element;
      if (root.contains(t) && t.closest(".pg-menu")) return;
      closeMenus();
    });

    // base64url of the UTF-8 bytes, so a program with umlauts or a long line
    // survives the trip through a URL. Built a chunk at a time because
    // String.fromCharCode(...bytes) overflows the argument list on a long one.
    function encodeProgram(src: string): string {
      const bytes = new TextEncoder().encode(src);
      let binary = "";
      for (let i = 0; i < bytes.length; i += 0x8000) {
        binary += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
      }
      return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
    }
    function decodeProgram(param: string): string | null {
      try {
        const b64 = param.replace(/-/g, "+").replace(/_/g, "/");
        const binary = atob(b64);
        const bytes = new Uint8Array(binary.length);
        for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
        return new TextDecoder().decode(bytes);
      } catch {
        return null;
      }
    }

    const shareLink = () => {
      const url = new URL(window.location.href);
      url.searchParams.set("p", encodeProgram(editor.state.doc.toString()));
      url.searchParams.set("s", String(currentStep()));
      return url.toString();
    };

    const copyText = async (text: string, said: string) => {
      try {
        await navigator.clipboard.writeText(text);
        say(said);
      } catch {
        say("the browser refused the clipboard");
      }
    };

    exportPanel.addEventListener("click", (e: MouseEvent) => {
      const b = (e.target as Element).closest<HTMLButtonElement>("[data-export]");
      if (!b) return;
      const what = b.dataset.export;
      if (what === "link") {
        void copyText(shareLink(), "link copied");
        return;
      }
      const scene = currentScene();
      if (!scene) {
        say("nothing drawn yet");
        return;
      }
      let svg: string;
      try {
        const command = renderCommand(runtime.state, { view: currentView, hidden: hiddenMode });
        svg = command ? commandToSvg(scene, command, literalTheme()) : "";
      } catch (err) {
        say(`render failed: ${err instanceof Error ? err.message : String(err)}`);
        return;
      }
      if (what === "copy") {
        void copyText(svg, "SVG copied");
        return;
      }
      const url = URL.createObjectURL(new Blob([svg], { type: "image/svg+xml" }));
      const a = document.createElement("a");
      a.href = url;
      a.download = currentWrites().length > 0 ? `beloch-step-${currentStep()}.svg` : "beloch.svg";
      a.click();
      URL.revokeObjectURL(url);
      say("SVG downloaded");
    });

    // ── Keyboard ─────────────────────────────────────────────────────────
    // Everything the drawing can do is reachable without a pointer (B7). The
    // stage is one tab stop: the horizontal arrows walk the steps, + and −
    // zoom, 0 puts the view back. A crease is reached through its hit line,
    // and the vertical arrows move from one crease to the next, so a drawing
    // with twenty creases does not put twenty tab stops between this card and
    // the rest of the page.
    result.tabIndex = 0;
    result.addEventListener("keydown", (e: KeyboardEvent) => {
      // A control inside the stage keeps its own keys.
      if (e.target !== result) return;
      switch (e.key) {
        case "ArrowRight":
          renderStep(currentStep() + 1, true, true);
          break;
        case "ArrowLeft":
          renderStep(currentStep() - 1, true, true);
          break;
        case "+":
        case "=":
          panZoom.zoomBy(1.15);
          break;
        case "-":
          panZoom.zoomBy(1 / 1.15);
          break;
        case "0":
          panZoom.reset();
          break;
        default:
          return;
      }
      e.preventDefault();
    });

    // Every hit target on the stage: the fat twins over crease lines and the
    // discs over point dots, in document order.
    function hitLines(): SVGElement[] {
      return Array.from(canvas!.querySelectorAll<SVGElement>(`.${HIT_CLASS}`));
    }

    // Called after every drawing swap, because the hit targets are rebuilt
    // with the SVG. One of them holds the tab stop; the rest are reachable
    // from it.
    function makeCreasesReachable() {
      const insp = currentScene()?.inspect;
      hitLines().forEach((el, i) => {
        el.setAttribute("tabindex", i === 0 ? "0" : "-1");
        el.setAttribute("role", "button");
        const ref = resolveRef(el);
        const title = ref && insp ? hoverSummary(ref, insp)?.title : null;
        // A paper edge carries no inspect entry to take a name from, so it is
        // named for what it is rather than as a crease. Same for a point dot,
        // whose twin is reachable too.
        const fallback =
          ref?.kind === "edge" ? "Paper edge"
            : ref?.kind === "vertex" ? "Point"
              : "Crease line";
        el.setAttribute("aria-label", title ?? fallback);
      });
    }

    canvas.addEventListener("keydown", (e: KeyboardEvent) => {
      const el = e.target as Element;
      if (!el.classList?.contains(HIT_CLASS)) return;
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        const lines = hitLines();
        const i = lines.indexOf(el as SVGElement);
        const next = lines[(i + (e.key === "ArrowDown" ? 1 : lines.length - 1)) % lines.length];
        if (!next) return;
        lines.forEach((l) => l.setAttribute("tabindex", "-1"));
        next.setAttribute("tabindex", "0");
        next.focus();
        e.preventDefault();
        return;
      }
      if (e.key === "Enter" || e.key === " ") {
        const ref = resolveRef(el);
        if (ref) anchorEntity(ref, middleOf(el as SVGGraphicsElement));
        e.preventDefault();
        return;
      }
      if (e.key === "Escape") {
        closeAnchor();
        result!.focus();
        e.preventDefault();
      }
    });

    runBtn.addEventListener("click", run);

    // A shared link carries the program in `?p=` and the step it was shared at
    // in `?s=`. That link is the reason the visitor opened the page, so it
    // loads and runs on arrival even on an instance that otherwise waits for a
    // click, and the step is taken once the run has produced one.
    const sharedParams = new URLSearchParams(window.location.search);
    const sharedRaw = sharedParams.get("p");
    const sharedProgram = sharedRaw === null ? null : decodeProgram(sharedRaw);
    if (sharedProgram !== null) {
      const step = Number(sharedParams.get("s"));
      pendingSharedStep = Number.isInteger(step) && step >= 0 ? step : null;
      editor.dispatch({ changes: { from: 0, to: editor.state.doc.length, insert: sharedProgram } });
      evaluator.boot();
      run();
      return;
    }

    if (!lazy) {
      evaluator.boot();
      if (initialCode.trim()) run();
    }
  }

  document
    .querySelectorAll<HTMLElement>(".beloch-playground")
    .forEach((root) => {
      void setup(root).catch((err) => console.error("playground: setup failed", err));
    });
</script>
