paper square

; preliminary base
fold (map .a onto .c) as --bd
reverse (map .b onto .c) as --h
reverse (map .d onto .c) as --v

.o = --h * --v
--mid = (through .c .o)

; the four side corners onto the centre line
.sr = --ab * --h
reverse (map .sr onto --mid through .c)
.sl = --da * --v
reverse (map .sl onto --mid through .c)
.br = --bc * --h
reverse (map .br onto --mid through .c)
.bl = --cd * --v
reverse (map .bl onto --mid through .c)

; lift the petals, front and back
fold (perp --mid through .sr) (moving .a)
  as --pf
fold (perp --mid through .sr) (moving .c)
  (mountain) as --pb
