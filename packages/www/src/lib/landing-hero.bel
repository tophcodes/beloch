@author "Claude (Anthropic)"
@design traditional
@source "[saydak2010samurai]"
paper square

fold (map .c onto .a) as --bd
fold (map .d onto .a) as --l
fold (map .b onto .a) as --r

.o = --r * --l
mark (through .o .c) as --mid
.sl = --l * --da
.sr = --r * --ab
.el = --l * --cd
.er = --r * --bc
fold (through .sl .sr) (moving .d) (up to #[.d .el])
  as --wl
fold (through .sl .sr) (moving .b) (up to #[.b .er])
  as --wr

.ml = --wl * --bd
.mr = --wr * --bd
.ql = free on --da & .d from .d at 1/3
.qr = free on --ab & .b from .b at 1/3
fold (through .ml .ql) (moving .d) (up to #[.d .sl])
  as --hl
fold (through .mr .qr) (moving .b) (up to #[.b .sr])
  as --hr

.x = free on --bc from .c at 3/8
fold (perp --mid through .x) (moving .c) (up to #[.c])
  as --s5
fold (through .sl .sr) (moving .x) (up to #[.o .x])
  as --s6
fold (through .sl .sr) (moving .a) (up to #[.a])
  (under #[.o .el .er]) as --s7

@orient .o up
