---
// The landing at `/`. The hero shows a program and the drawing it produces,
// and offers nothing to operate: what it has to say is that a line of this
// language is a fold and that the geometry comes out exact. A visitor who
// wants to change something goes to `/playground/`, which is the surface with
// an editor. Both are drawn by the same component and speak the same
// vocabulary, and the hero defines no token the docs do not have.
//
// The drawing is rendered at build time (the same evalBelToFold -> parseFold
// -> render pipeline the docs cards use), so it is on the page at first paint
// with no worker and no wasm.
import Shell from "../layouts/Shell.astro";
import Playground from "../components/Playground.astro";
import { evalBelToFold } from "../lib/eval-bel";
import { HERO_SRC } from "../lib/landing-examples";
import { parseFold } from "@beloch/scene";
import { renderFolded, WEB_THEME } from "@beloch/render-svg";

const fold = evalBelToFold(HERO_SRC);
const scene = parseFold(fold as object);
const heroSvg = renderFolded(scene, { theme: WEB_THEME }).toString();
const heroFoldJson = JSON.stringify(fold);

const DESCRIPTION = "A declarative language for origami, built on the Huzita–Justin axioms.";
---

<Shell title="Beloch" description={DESCRIPTION} url="https://beloch.toph.so/">
  <section class="hero">
    <h1>beloch</h1>
    <p class="pronunciation">beh-LOK · /be&#712;l&#596;k/</p>
    <p class="hero-body">
      A programming language in which every line is a fold. Beloch works out the
      geometry exactly and gives you the crease pattern and the folded state.
    </p>
    <div class="hero-actions">
      <a class="action action-primary" href="/playground/">Playground</a>
      <a class="action" href="/language/">Docs</a>
    </div>
    <Playground
      variant="hero"
      lazy
      seed={heroSvg}
      seedFold={heroFoldJson}
      code={HERO_SRC}
      height={340}
    />
  </section>
</Shell>

<style>
  .hero h1 {
    font-family: var(--bel-font-mono);
    font-size: clamp(32px, 6vw, 48px);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .pronunciation {
    margin: 6px 0 0;
    font-family: var(--bel-font-mono);
    font-size: 13px;
    color: var(--bel-ui-text-muted);
  }
  .hero-body {
    margin: 18px 0 0;
    max-width: 52ch;
    font-size: 17px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 22px;
    font-family: var(--bel-font-mono);
    font-size: 13px;
  }
  .action {
    padding: 7px 16px;
    border-radius: var(--bel-radius-control);
    border: 1px solid var(--bel-ui-control-border);
    color: var(--bel-ui-text);
  }
  .action:hover {
    text-decoration: none;
    border-color: var(--bel-ui-accent);
  }
  .action-primary {
    background: var(--bel-ui-accent);
    border-color: var(--bel-ui-accent);
    color: var(--bel-ui-accent-text);
  }
  .action:focus-visible {
    outline: 2px solid var(--bel-ui-accent);
    outline-offset: 2px;
  }

  .hero :global(.beloch-playground) {
    margin-top: 36px;
  }
</style>
