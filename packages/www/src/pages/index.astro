---
// The landing at `/`. The hero says what the language is, shows the crease
// pattern its program ends on, and lays the program out as a folding diagram:
// one card per fold, each with its lines and the pattern after it. What it has
// to say is that a program names what it folds and that the geometry comes
// out exact. A visitor who wants to change something goes to `/playground/`,
// which is the surface with an editor. The hero defines no token the docs do
// not have.
import Shell from "../layouts/Shell.astro";
import CitationMeta from "../components/CitationMeta.astro";
import HeroSequence from "../components/HeroSequence.astro";
import { HERO_SRC } from "../lib/landing-examples";
import { DESCRIPTION } from "../lib/description";
---

<Shell title="Beloch" description={DESCRIPTION} url="https://beloch.toph.so/">
  <CitationMeta slot="head" />
  <section class="hero">
    <HeroSequence src={HERO_SRC}>
      <h1>beloch</h1>
      <p class="pronunciation">beh-LOK · /be&#712;l&#596;k/</p>
      <p class="hero-body">{DESCRIPTION}</p>
      <div class="hero-actions">
        <a class="action action-primary" href="/playground/">Playground</a>
        <a class="action" href="/language/">Docs</a>
      </div>
    </HeroSequence>
  </section>
</Shell>

<style>
  .hero h1 {
    font-family: var(--bel-font-mono);
    font-size: var(--bel-text-hero);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .pronunciation {
    margin: 6px 0 0;
    font-family: var(--bel-font-mono);
    font-size: var(--bel-text-sm);
    color: var(--bel-ui-text-muted);
  }
  .hero-body {
    margin: 18px 0 0;
    max-width: 52ch;
    font-size: var(--bel-text-lg);
    line-height: var(--bel-line-height);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 22px;
    font-family: var(--bel-font-mono);
    font-size: var(--bel-text-sm);
  }
  .action {
    padding: 7px 16px;
    border-radius: var(--bel-radius-control);
    border: 1px solid var(--bel-ui-control-border);
    color: var(--bel-ui-text);
  }
  .action:hover {
    text-decoration: none;
    border-color: var(--bel-ui-accent);
  }
  .action-primary {
    background: var(--bel-ui-accent);
    border-color: var(--bel-ui-accent);
    color: var(--bel-ui-accent-text);
  }
  .action:focus-visible {
    outline: 2px solid var(--bel-ui-accent);
    outline-offset: 2px;
  }
</style>
