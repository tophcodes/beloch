{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "@beloch/scene": ["../render-2d/scene/src/index.ts"],
      "@beloch/render-svg": ["../render-2d/render-svg/src/index.ts"]
    }
  },
  "include": [
    "core/src", "core/test",
    "editor/src", "editor/test",
    "eval/src", "eval/test",
    "pick/src", "pick/test",
    "render-dom/src", "render-dom/test"
  ]
}
