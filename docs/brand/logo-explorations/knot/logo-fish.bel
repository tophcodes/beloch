; Beloch logo mark, direction B ("one knot") — the geometry of
; knot-03-fish.svg. The first of the fish base's two interior vertices, on its
; own; every crease here is constructible, no derive step is needed.
;
;   nix develop --command dune exec beloch -- fold \
;     docs/brand/logo-explorations/knot/logo-fish.bel > /tmp/logo-fish.fold
;
; Vertex: (1 - sqrt(2)/2, 1 - sqrt(2)/2). Sectors 67.5 / 45 / 112.5 / 135.
; Kawasaki: 67.5 - 45 + 112.5 - 135 = 0.  Maekawa: M - V = 1 - 3 = -2.

paper square

mark (map .a onto .c) as --diag  ; perpendicular bisector of the diagonal
mark (through .a .c) as --ray    ; the diagonal itself

mark (map --ab onto --diag) as --l1
mark (map --da onto --diag) as --l2

flatten (--l1) (--l2) (--ray) (toward .d)
