; status: works, but see questions below

paper square

--v = map .a onto .b          ; x = 1/2: perp bisector of the base, also the spine
.m = .(--v --(.d .c))         ; apex (1/2, 1)

step precrease
--ba = map --(.a .b) onto --(.a .m)   ; angle bisector at a (interior — filter picks it)
--bb = map --(.b .a) onto --(.b .m)   ; angle bisector at b
.o = .(--ba --bb)                     ; incenter — the collapse vertex

@fold --bb moving .a ; fold 1

step constructions
.rl = .(--bb --(.a .d))
.rm = .(--ba --(.b .c))

--crease = --(.o .rm)

; 3 options for fold 2:

; works, but requires extra construction
; @fold --crease moving .b

; works
@fold --ba at #(.rm .b) moving .b

; does not work, but also specifies what I think is the same flap
; defined by #(.b .c .d .rl)
; @fold --ba at #(.d .b) moving .b
