; status: regressed pending pinch — scoring --am/--bm as full creases splits the
; bisector rays (--bm crosses --ba), so @collapse can't select an o→boundary segment

paper square

--v = map .a onto .b          ; x = 1/2: perp bisector of the base, also the spine
.m = --v * --cd               ; apex (1/2, 1)

step precrease
--am = through .a .m          ; TODO(pinch): landmark — replace with pinch when shipped
--bm = through .b .m          ; TODO(pinch): landmark — replace with pinch when shipped
--ba = map --ab onto --am     ; bisector at a, full chord a—o—rm
--bb = map --ab onto --bm     ; bisector at b, full chord b—o—rl
.o = --ba * --bb              ; incenter — the collapse vertex

step constructions
.rl = --bb * --da
.rm = --ba * --bc
.bm = --v * --ab

; the ray o→rm and o→rl I insisted on ARE foldable — the missing 4th ray was
; never a "new" crease, it is the spine o→m (the OTHER half of --v). --v is two
; rays; 002 used only o→base, 003 invented --new to replace o→m. Both times: add
; the spine.
@collapse --ba & .rm and --bb & .rl and (--v & .m mountain) and --v & .bm
