; status: works, but see questions below

paper square

--v = map .a onto .b          ; x = 1/2: perp bisector of the base, also the spine
.m = .(--v --(.d .c))         ; apex (1/2, 1)

step precrease
--ba = map --(.a .b) onto --(.a .m)   ; angle bisector at a (interior — filter picks it)
--bb = map --(.b .a) onto --(.b .m)   ; angle bisector at b
.o = .(--ba --bb)                     ; incenter — the collapse vertex

step constructions
.rl = .(--bb --(.a .d))
.rm = .(--ba --(.b .c))
.bm = .(--v --(.a .b))
--new = map --v at .bm onto --bb toward .b
.newm = .(--new --(.a .b))

@collapse --ba at .rm and --bb at .rl and --new at .newm mountain and --v at .bm
