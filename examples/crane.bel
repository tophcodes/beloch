@author "Claude (Anthropic)"
@design traditional
@source "[randlett1961art, p. 69]"
@source "[ida2020, Fig. 7.19]"

; The traditional crane, flat. The preliminary base is folded as Randlett
; folds it, by two squash folds [randlett1961art, p. 69]; the first is held
; by the layers its flap is hinged to (spec squash, "The layers a flap is
; hinged to hold its squash"). The bird base is folded by two petal folds,
; each one flatten of two fans (spec multifold, "flatten folds several fans
; in one motion"); it is the state Ida's steps 2-10 reach by reverse folds
; [ida2020, Fig. 7.19]. Her steps 11-17 follow. Her steps 18 and 19 open
; the wings, which is 3D and out of scope (spec folded-state, "Every folded
; state is flat").
; Checked against her figures in records/notes/2026-09-25-crane-oracle.md.

paper square

fold (map .d onto .b) as --ac           ; triangle
fold (map .a onto .c) as --bd           ; in half again

; the preliminary base: the top flap squashed, the model turned over, the
; other flap squashed, and the model turned back. Each squash opens the
; folded edge on --ac and lays it on --bd.
squash (--ac & --ab onto --bd) as --s1
flip
squash (--ac & --bc onto --bd) as --s2
flip

.o = --ac * --bd                        ; the paper center
mark (through .c .o) as --mid           ; center line of the base

.sr = --ab * --s1                       ; the four side corners
.sl = --da * --s1
.br = --bc * --s2
.bl = --cd * --s2

; the bird base: each petal fold opens the two halves of the side edges
; toward the side corners, brings the corners onto the center line and lifts
; the flap between them past the paper center. The legs .b and .d stay at
; the apex. Each fan binds the point where its kite crease meets the crease
; between the two fans. The kite creases fold as valleys: the side edges
; fold in under the lifted flap.
; Drawn as Lang draws a petal fold, the open point down [lang2011secrets, Fig. 2.31].
@orient .a .o up
flatten (fan (--s1 & .sr) (map .sr onto --mid through .a valley) as .e1)
        (fan (--s1 & .sl) (map .sl onto --mid through .a valley) as .e2)
        (staying .o) as --pf
flatten (fan (--s2 & .br) (map .br onto --mid through .c valley) as .e3)
        (fan (--s2 & .bl) (map .bl onto --mid through .c valley) as .e4)
        (staying .o) as --pb

; the head will bend toward a point on the edge of the front petal, read
; here while that edge is still one piece
.ht = free on --[.e2 .a] from .a at 1/3

; narrow the legs: each outer edge onto the center line, front layers as
; valleys, back layers as mountains. The outer edge of a leg is the kite
; crease from its fan's point to its tip. Each `up to` names the face of the
; leg that holds its anchor, the leg's tip and the paper center; without it
; the front fold takes the back layers too.
fold (map --[.e1 .b] onto --mid) (moving .e1) (up to #[.e1 .b .o]) as --n1
fold (map --[.e2 .d] onto --mid) (moving .e2) (up to #[.e2 .d .o]) as --n2
fold (map --[.e3 .b] onto --mid) (moving .e3) (up to #[.e3 .b .o]) (mountain) as --n3
fold (map --[.e4 .d] onto --mid) (moving .e4) (up to #[.e4 .d .o]) (mountain) as --n4

; neck and tail: each leg reversed about the perpendicular to its own
; narrowed edge through the point where the side corners landed. These are
; Ida's rays for steps 15 and 16 exactly. A narrowed leg opens at three
; places: between its two halves, and between its two outer layers and the
; six beside them, once on each side. The letters on its two narrowing
; creases keep the opening between its two halves.
.pn = free on --n1 & #[.sr .b] from .b at 1/4
.pn3 = free on --n3 & #[.br .b] from .b at 1/4
reverse (perp --n1 through .sr) (moving .b) (--n1 & .pn mountain) (--n3 & .pn3 mountain) as --neck
.pt = free on --n2 & #[.sl .d] from .d at 1/4
.pt4 = free on --n4 & #[.bl .d] from .d at 1/4
reverse (perp --n2 through .sr) (moving .d) (--n2 & .pt mountain) (--n4 & .pt4 mountain) as --tail

; head: a free choice in folding practice, so two free points carry it.
; .hp is where the head bends, .ht, bound above, sets its angle. Ida's ray
; for step 17 passes within 0.0032 of .ht and bends the neck at 0.2346 of
; its length from the tip.
.hp = free on --bd & .b from .b at 1/4
reverse (through .hp .ht) (moving .b) as --head

; the crane stands on its center line, turned with the wing tip .c up
; while the wings still stand
@orient .o .c up

; the wings fold down along the line across the body through the two points
; where the neck and the tail leave it. On each petal these are the points
; where a narrowing crease turns at the petal's kite crease: the piece of the
; narrowing crease that crosses the petal hinge (--pf, --pb) meets its other
; pieces there and nowhere else. On the table the line runs perpendicular to
; the center line.
.y1 = --n1 * --pf
.w1 = (--n1 & #[.a .y1]) * (--n1 \ .y1)
.y2 = --n2 * --pf
.w2 = (--n2 & #[.a .y2]) * (--n2 \ .y2)
.y3 = --n3 * --pb
.w3 = (--n3 & #[.c .y3]) * (--n3 \ .y3)
.y4 = --n4 * --pb
.w4 = (--n4 & #[.c .y4]) * (--n4 \ .y4)

; the front wing folds down toward the viewer, the back wing behind. Each
; `up to` names the face of the petal between its tip and the two points, so
; the neck, the tail and the layers around the paper center stay.
fold (through .w1 .w2) (moving .a) (up to #[.a .w1 .w2]) as --wa
fold (through .w3 .w4) (moving .c) (up to #[.c .w3 .w4]) (mountain) as --wc

; assert steps = 17
; assert faces = 72

; the two wing tips meet below the body, the paper center stays put and
; stands between the wings as the crane's back
; assert .a = .c
; assert .o = (1/2, 1/2)

; the four side corners and the four fan points each share one point of
; the center line
; assert .sr = .sl
; assert .sr = .br
; assert .sr = .bl
; assert .e1 = .e2
; assert .e1 = .e3
; assert .e1 = .e4
