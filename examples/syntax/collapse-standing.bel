; status: errors — a `standing` clause asks to keep a flap upright (a non-flat
; end state); the collapse kernel only produces flat states so far.

paper square

--ac = map .b onto .d     ; diagonal a–c
--bd = map .a onto .c     ; diagonal b–d

@collapse --ac at .a and --ac at .c and --bd at .b and --bd at .d
  and standing .a
