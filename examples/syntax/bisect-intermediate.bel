; status: works — `toward .p` only picks the SIDE, not a point on the angle bisector.
; .int is the constructed point (1/4, 0); it sits in the lower-left sector, so it
; selects the a–c diagonal — which does NOT pass through .int. Any point in that
; sector would give the same crease.
paper square
--v = map .a onto .b      ; vertical midline x = 1/2
--h = map .b onto .c      ; horizontal midline y = 1/2

--left = through .a .d
--bottom = through .a .b
--quartered = map --v onto --left
.int = cross --quartered --bottom

map --v onto --h toward .int
