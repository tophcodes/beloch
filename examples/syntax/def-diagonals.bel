; status: works — def/apply demo: one def constructs the line between two
; corners; applied twice, the diagonals cross in the centre. Cross-instance
; access is via `export` (instance member brackets are gone).
paper square

def diagonal(.p .q) {
  --d = through .p .q
}

step diagonals
$d1 = apply diagonal(.a .c)
$d2 = apply diagonal(.b .d)

step centre
export { --d as --d1d } $d1
export { --d as --d2d } $d2
.m = --d1d * --d2d
