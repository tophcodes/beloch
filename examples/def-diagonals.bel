; status: works — def/apply demo: one def constructs the line between two
; corners; applied twice, the diagonals cross in the centre via qualified access.
paper square

def diagonal(.p .q) {
  --d = through .p .q
}

step diagonals
$d1 = apply diagonal(.a .c)
$d2 = apply diagonal(.b .d)

step centre
.m = cross --[$d1 d] --[$d2 d]
