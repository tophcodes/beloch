{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/check-commit-subject.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the commit subject"
          }
        ]
      }
    ]
  }
}
