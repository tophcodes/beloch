paper square

mark --ac = map .b onto .d     ; diagonal a-c
mark --bd = map .a onto .c     ; diagonal b-d
mark --h  = map .a onto .d     ; horizontal midline, y = 1/2
mark --v  = map .a onto .b     ; vertical midline, x = 1/2

flatten (--ac & .c mountain) (--ac & .a)
  (--bd & .d mountain) (--bd & .b)
  (--h & --bc mountain)
  (--h & --da)
  (--v & --cd)
  (--v & --ab)

; flatten V2 (spec 2026-07-16-flatten-derive-v2-design.md): bare elements are
; solver-assigned, so the solution space here holds several realizations that
; survive the min-mountain canon; without a {toward} selector the statement
; errors, naming the fix. (V1's "ambiguous stacking" surfaced the same
; under-constraint through the old single-pattern kernel contract; the
; one-pipeline model reports it as realization ambiguity instead.)
; expect error "flatten is ambiguous"
