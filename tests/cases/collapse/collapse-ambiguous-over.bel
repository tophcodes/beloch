paper square

mark --ac = map .b onto .d     ; diagonal a-c
mark --bd = map .a onto .c     ; diagonal b-d
mark --h  = map .a onto .d     ; horizontal midline, y = 1/2
mark --v  = map .a onto .b     ; vertical midline, x = 1/2

.rm = --h * --bc          ; right edge midpoint (1, 1/2)
.tm = --v * --cd          ; top edge midpoint (1/2, 1)

flatten (--ac & .c mountain) (--ac & .a)
  (--bd & .d mountain) (--bd & .b)
  (--h & --bc mountain)
  (--h & --da)
  (--v & --cd)
  (--v & --ab)
  (#[.b .rm] over #[.c .tm])

; assert faces = 8
; assert .rm paper = (1, 1/2)
; assert .tm paper = (1/2, 1)
