paper square

mark --ac = map .b onto .d     ; diagonal a-c
mark --bd = map .a onto .c     ; diagonal b-d
mark --h  = map .a onto .d     ; horizontal midline, y = 1/2
mark --v  = map .a onto .b     ; vertical midline, x = 1/2

.rm = --h * --bc          ; right edge midpoint (1, 1/2)
.tm = --v * --cd          ; top edge midpoint (1/2, 1)

; flatten V2 (spec 2026-07-16-flatten-derive-v2-design.md): bare = solver-
; assigned, so the V1 assignment this case's `over`-resolution depends on
; (3 mountains, rest valley) must pin the valleys explicitly — this keeps
; the case testing exactly what it always did: one stated M/V pattern whose
; stacking is ambiguous until (x over y) narrows it to one realization.
flatten (--ac & .c mountain) (--ac & .a valley)
  (--bd & .d mountain) (--bd & .b valley)
  (--h & --bc mountain)
  (--h & --da valley)
  (--v & --cd valley)
  (--v & --ab valley)
  (#[.b .rm] over #[.c .tm])

; assert faces = 8
; assert .rm paper = (1, 1/2)
; assert .tm paper = (1/2, 1)
